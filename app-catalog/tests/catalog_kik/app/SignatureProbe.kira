function catalogTestFeed() -> String {
    return "Tessera catalog cache 1\nat\t100\nL\texample.notes\t" + publisherA
        + "\t1\t" + digestA
        + "\tNotes\tWrite and organize documents\tProductivity\tdesktop,tablet\t26\t20000000\tdisplay,data\n"
}

@Test
function ed25519CatalogFixtureIsVerifiedByHostCryptoService() {
    let certificate = catalogTestCertificate()
    let signature = catalogTestSignature()
    var payload: [UN8] = []
    for index in 0..catalogTestFeed().count {
        payload.append(UN8(Number(catalogTestFeed().charAt(index))))
    }
    let allowed = match verifySignature(.Ed25519, certificate, payload, signature) {
        Ok -> true
        Error(failure) -> {
            absorb failure
            false
        }
    }
    expect!(allowed)
    var damaged = copy payload
    damaged[0] = 0
    let refused = match verifySignature(.Ed25519, certificate, damaged, signature) {
        Ok -> false
        Error(failure) -> {
            absorb failure
            true
        }
    }
    expect!(refused)
}
