@Test
function UnicodeSignedCatalogUsesExactUtf8AndRejectsEditedText() {
    let feed = "Tessera catalog cache 1\nat\t101\nL\texample.notes\t"
        + "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        + "\t1\t1111111111111111111111111111111111111111111111111111111111111111"
        + "\tCafé ☀️\tRésumé pour tous\tProductivity\tdesktop\t26\t20000000\tdisplay,data\n"
    let signer = CatalogSigner {
        certificate: unicodeCatalogTestCertificate(),
        pinnedCertificateSha256: unicodeCatalogTestPin()
    }
    var cache = CatalogCache {}
    expect!(feedAccepted(refreshSignedCatalog(cache, feed, unicodeCatalogTestSignature(), signer)))
    expect!(cache.listings.count == 1)
    expect!(cache.listings[0].name == "Café ☀️")
    expect!(cache.listings[0].description == "Résumé pour tous")
    let edited = feed.before("Résumé") + "Resume" + feed.substring(
        feed.before("Résumé").count + 6,
        feed.count
    )
    var other = CatalogCache {}
    expect!(
        !feedAccepted(refreshSignedCatalog(other, edited, unicodeCatalogTestSignature(), signer))
    )
    expect!(other.listings.count == 0)
}
