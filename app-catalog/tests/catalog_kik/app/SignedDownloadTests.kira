function downloadTestPin() -> [UN8] {
    return [
        108, 254, 25, 166, 50, 199, 89, 171, 26, 183, 183, 93, 246, 55, 87, 250,
        117, 192, 75, 183, 156, 108, 14, 229, 31, 216, 196, 240, 8, 116, 247, 215,
    ]
}

function signedDownloadTestListing() -> CatalogListing {
    return CatalogListing {
        identity: AppIdentity {
            identifier: "example.notes",
            publisher: "6cfe19a632c759ab1ab7b75df63757fa75c04bb79c6c0ee51fd8c4f00874f7d7"
        },
        name: "Notes",
        description: "Signed test application",
        category: "Productivity",
        version: 1,
        artifactDigest: "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        supportedPlatforms: ["desktop"],
        minSystemBuild: 26,
        downloadBytes: 3,
        requests: ["display", "data"]
    }
}

function signedDownloadManifest() -> ApplicationManifest {
    return ApplicationManifest {
        identifier: "example.notes",
        name: "Notes",
        version: 1,
        executable: "bin",
        requests: ["display", "data"]
    }
}

function signedDownloadSigner() -> AppImageSigner {
    return AppImageSigner {
        certificate: downloadTestCertificate(),
        trustedCertificateSha256: downloadTestPin()
    }
}

@Test
function queueVerifiesSignedBytesBeforeStagingCatalogInstallation() {
    let path = ".tessera-catalog-signed-download"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let listing = signedDownloadTestListing()
    var cache = CatalogCache {}
    expect!(refreshed(cache, [listing]))
    var registry = ApplicationRegistry {}
    var queue = InstallQueue {}
    expect!(jobSucceeded(queue.request(listing, cache, registry, "desktop", 26)))
    expect!(jobSucceeded(queue.startDownload(listing.identity)))
    expect!(jobSucceeded(queue.updateProgress(listing.identity, 3)))
    expect!(jobSucceeded(queue.finishDownload(listing.identity)))
    expect!(
        jobSucceeded(
            queue.verifyDownloadedImage(
                listing.identity,
                path,
                signedDownloadManifest(),
                signedDownloadSigner(),
                downloadTestSignature()
            )
        )
    )
    expect!(registry.installed.count == 0)
    expect!(jobSucceeded(queue.stageInstall(listing.identity, registry)))
    expect!(registry.pending.count == 1)
    expect!(jobSucceeded(queue.finishInstall(listing.identity, registry)))
    expect!(registry.installed.count == 1)
    expect!(
        (
            try registry.accepted(listing.identity) otherwise return
        ).candidate.imageDigest == listing.artifactDigest
    )
    match removePath(path) { Ok -> {} Error(reason) -> absorb reason }
}

@Test
function invalidSignedBytesRemainUnverifiedAndUninstalled() {
    let path = ".tessera-catalog-tampered-download"
    match writeFile(path, "abd") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let listing = signedDownloadTestListing()
    var cache = CatalogCache {}
    expect!(refreshed(cache, [listing]))
    var registry = ApplicationRegistry {}
    var queue = InstallQueue {}
    expect!(jobSucceeded(queue.request(listing, cache, registry, "desktop", 26)))
    expect!(jobSucceeded(queue.startDownload(listing.identity)))
    expect!(jobSucceeded(queue.updateProgress(listing.identity, 3)))
    expect!(jobSucceeded(queue.finishDownload(listing.identity)))
    expect!(
        !jobSucceeded(
            queue.verifyDownloadedImage(
                listing.identity,
                path,
                signedDownloadManifest(),
                signedDownloadSigner(),
                downloadTestSignature()
            )
        )
    )
    expect!(queue.jobs[0].phase == InstallPhase.Verifying)
    expect!(registry.installed.count == 0)
    expect!(registry.pending.count == 0)
    match removePath(path) { Ok -> {} Error(reason) -> absorb reason }
}

@Test
function changedImageAfterStagingCannotActivateTheQueuedVersion() {
    let path = ".tessera-catalog-activation-tamper"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let listing = signedDownloadTestListing()
    var cache = CatalogCache {}
    expect!(refreshed(cache, [listing]))
    var registry = ApplicationRegistry {}
    var queue = InstallQueue {}
    expect!(jobSucceeded(queue.request(listing, cache, registry, "desktop", 26)))
    expect!(jobSucceeded(queue.startDownload(listing.identity)))
    expect!(jobSucceeded(queue.updateProgress(listing.identity, 3)))
    expect!(jobSucceeded(queue.finishDownload(listing.identity)))
    expect!(
        jobSucceeded(
            queue.verifyDownloadedImage(
                listing.identity,
                path,
                signedDownloadManifest(),
                signedDownloadSigner(),
                downloadTestSignature()
            )
        )
    )
    expect!(jobSucceeded(queue.stageInstall(listing.identity, registry)))
    expect!(registry.pending.count == 1)
    match writeFile(path, "abd") { Ok -> {} Error(reason) -> absorb reason }
    expect!(
        !jobSucceeded(
            queue.finishVerifiedInstall(
                listing.identity,
                path,
                signedDownloadManifest(),
                signedDownloadSigner(),
                downloadTestSignature(),
                registry
            )
        )
    )
    expect!(registry.installed.count == 0)
    expect!(registry.pending.count == 1)
    match writeFile(path, "abc") { Ok -> {} Error(reason) -> absorb reason }
    expect!(
        jobSucceeded(
            queue.finishVerifiedInstall(
                listing.identity,
                path,
                signedDownloadManifest(),
                signedDownloadSigner(),
                downloadTestSignature(),
                registry
            )
        )
    )
    expect!(registry.installed.count == 1)
    match removePath(path) { Ok -> {} Error(reason) -> absorb reason }
}
