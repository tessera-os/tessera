import Foundation
import TarwinProbe

// Compiler-side view of verified TIR, not a guest wire format. The structured
// control-flow pass supplies a postorder DAG. Bounds come from range analysis,
// not from untrusted module annotations. A leaf is one decoded instruction.
public struct ByteRead { let offset: U64 let width: U64 }
public struct Edges { let a: Number let b: Number }
public struct Bound { let body: Number let bound: U64 }
public enum ProbeTerm {
    DefinedScalar
    Context(ByteRead)
    Helper(ProbeEffect)
    Sequence(Edges)
    Choice(Edges)
    Counted(Bound)
    DirectCall(Number)
    UnprovenLoop
    Unsupported
}
public enum AnalysisFailure { Empty InvalidGraph Bounds HookEffect Forbidden Budget }

public function worstCase(terms: borrow [ProbeTerm], contextBytes: U64,
                          hook: ProbeHook) -> Result<U64, AnalysisFailure> {
    if terms.count == 0 { return .Error(.Empty) }
    if terms.count > 1000000 { return .Error(.Budget) }
    var costs: [U64] = []
    for i in 0..terms.count {
        let n: U64 = match terms[i] {
            DefinedScalar -> 1
            Context(read) -> {
                let offset = read.offset
                let width = read.width
                if width == 0 || offset > contextBytes || width > contextBytes-offset { return .Error(.Bounds) }
                U64(1)
            }
            Helper(action) -> {
                if !effectAllowed(hook,action) { return .Error(.HookEffect) }
                U64(1)
            }
            Sequence(edges) -> {
                let a = edges.a
                let b = edges.b
                if a < 0 || b < 0 || a >= i || b >= i { return .Error(.InvalidGraph) }
                sequentialCost(costs[a],costs[b])
            }
            Choice(edges) -> {
                let a = edges.a
                let b = edges.b
                if a < 0 || b < 0 || a >= i || b >= i { return .Error(.InvalidGraph) }
                branchCost(costs[a],costs[b])
            }
            DirectCall(callee) -> {
                if callee < 0 || callee >= i { return .Error(.InvalidGraph) }
                sequentialCost(1,costs[callee])
            }
            Counted(loopInfo) -> {
                let body = loopInfo.body
                let bound = loopInfo.bound
                if body < 0 || body >= i { return .Error(.InvalidGraph) }
                loopCost(costs[body],bound)
            }
            UnprovenLoop -> return .Error(.Bounds)
            Unsupported -> return .Error(.Forbidden)
        }
        if n > ProbeLimit.instructions { return .Error(.Budget) }
        costs.append(n)
    }
    return .Ok(costs[costs.count - 1])
}
