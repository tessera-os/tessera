import Foundation

@Test
function perCpuMapCannotAliasAnotherCpuOrOverflowQuota() {
    let map = ProbeMapShape { kind: .PerCpu, capacity: 10, elementSize: 8 }
    expect!(validMap(map,4,320))
    expect!(!validMap(map,4,319))
    expect!(mapOffset(map,2,4,9,320) == 232)
    expect!(mapOffset(map,4,4,0,320) == 0xffffffffffffffff)
    expect!(mapOffset(map,1,4,10,320) == 0xffffffffffffffff)
    expect!(!validMap(ProbeMapShape { kind: .Hash, capacity: 16777217, elementSize: 1 },1,0xffffffffffffffff))
}
