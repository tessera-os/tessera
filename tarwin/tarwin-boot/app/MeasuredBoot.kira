import KCore

// Single SHA-256 bank for platforms which advertise it in both the TPM
// and the Spec ID event. Do not use as a substitute for a required bank
// or for DICE. The caller supplies the digest of the measured bytes.
function measuredRegister(pcr: U32) -> Bool { return pcr >= 8 && pcr <= 12 }

function putField<B: ByteBuffer>(b: borrow mut B, p: U64, bytes: U64, value: U64, big: Bool) {
    var i: U64 = 0
    while i < bytes {
        let shift = big ? bytes - i - 1 : i
        b.putByte(p + i, U8((value >> (8 * shift)) & 255))
        i += 1
    }
}

// TPM2_PCR_Extend with an empty password authorization session. Only
// works when the PCR policy permits that session at the current locality.
public function encodePcrExtend<H: ByteSource, B: ByteBuffer>(pcr: U32, digest: borrow H, command: borrow mut B) -> U64 {
    if !measuredRegister(pcr) || digest.byteCount() != 32 || command.byteCount() < 65 { return 0 }
    putField(command, 0, 2, 0x8002, true)
    putField(command, 2, 4, 65, true)
    putField(command, 6, 4, 0x182, true)
    putField(command, 10, 4, U64(pcr), true)
    putField(command, 14, 4, 9, true)
    putField(command, 18, 4, 0x40000009, true)
    putField(command, 22, 5, 0, true)
    putField(command, 27, 4, 1, true)
    putField(command, 31, 2, 0x000b, true)
    var i: U64 = 0
    while i < 32 {
        command.putByte(33 + i, digest.byteAt(i))
        i += 1
    }
    return 65
}

function validResponse<R: ByteSource>(reply: borrow R, received: U64) -> Bool {
    if received != 19 || reply.byteCount() < received || reply.byteAt(0) != 128 || reply.byteAt(1) != 2 || reply.byteAt(5) != 19 || reply.byteAt(16) != 1 { return false }
    var i: U64 = 2
    while i < 19 {
        if i != 5 && i != 16 && reply.byteAt(i) != 0 { return false }
        i += 1
    }
    return true
}

public function pcrExtendSucceeded<R: ByteSource>(reply: borrow R) -> Bool { return validResponse(reply, reply.byteCount()) }

// Crypto-agile TCG_PCR_EVENT2 (EV_IPL). Stage in unused log capacity
// before extending; publish the new end only on validated TPM success.
// Firmware owns the Spec ID header and the existing log. A transport loss
// after submission has unknown outcome: do not retry or continue boot.
public function stagePcrEvent<H: ByteSource, E: ByteSource, B: ByteBuffer>(pcr: U32, digest: borrow H, event: borrow E, log: borrow mut B, pos: U64) -> U64 {
    let length = event.byteCount()
    if !measuredRegister(pcr) || digest.byteCount() != 32 || length > 0xffffffff || pos > log.byteCount() || 50 + length > log.byteCount() - pos { return 0 }
    putField(log, pos, 4, U64(pcr), false)
    putField(log, pos + 4, 4, 13, false)
    putField(log, pos + 8, 4, 1, false)
    putField(log, pos + 12, 2, 11, false)
    var i: U64 = 0
    while i < 32 {
        log.putByte(pos + 14 + i, digest.byteAt(i))
        i += 1
    }
    putField(log, pos + 46, 4, length, false)
    i = 0
    while i < length {
        log.putByte(pos + 50 + i, event.byteAt(i))
        i += 1
    }
    return pos + 50 + length
}

// In-place command buffer. submit performs exactly one transaction,
// replaces its prefix with the reply and returns the actual received size.
public trait TpmPort: ByteBuffer {
    function submit(borrow mut self, commandSize: U64) -> U64
}

public struct MeasurementLog {
    var used: U64
    var stopped: Bool
}

// Caller serializes TPM access and log publication (also across CPUs).
// A stopped log cannot be continued, even if the transport later recovers.
public function extendAndRecord<P: TpmPort, H: ByteSource, E: ByteSource, B: ByteBuffer>(
    port: borrow mut P, state: borrow mut MeasurementLog, log: borrow mut B, pcr: U32, digest: borrow H, event: borrow E) -> Bool {
    if state.stopped { return false }
    let end = stagePcrEvent(pcr, digest, event, log, state.used)
    let size = encodePcrExtend(pcr, digest, port)
    if end == 0 || size == 0 {
        state.stopped = true
        return false
    }
    let received = port.submit(size)
    if !validResponse(port, received) {
        state.stopped = true
        return false
    }
    state.used = end
    return true
}
