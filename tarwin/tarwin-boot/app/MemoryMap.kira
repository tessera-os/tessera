import KCore

public struct PhysicalRegion {
    var base: U64
    var length: U64
    var kind: U32
    var attributes: U32
}

public function regionByte(region: borrow PhysicalRegion, offset: U64) -> U8 {
    var word: U64 = 0
    if offset < 8 { word = region.base }
    else if offset < 16 { word = region.length }
    else if offset < 24 { word = U64(region.kind) | (U64(region.attributes) << 32) }
    return U8((word >> ((offset & 7) * 8)) & 255)
}

public struct MapCursor {
    var remaining: U64
    var end: U64
    var failed: Bool
}

public function beginMemoryMap(count: U64, available: U64) -> MapCursor {
    return MapCursor { remaining: count, end: 0, failed: count == 0 || count > available / 32 }
}

// Feed the four little-endian words of each descriptor, in physical order.
// No RAM is released until the entire immutable map has passed this check.
public function acceptRegion(cursor: borrow mut MapCursor, base: U64, length: U64, typeAndAttributes: U64, reserved: U64) -> Bool {
    if cursor.failed || cursor.remaining == 0 || base < cursor.end || !validExtent(base, length) || (typeAndAttributes & 0xffffffff) > 10 || reserved != 0 {
        cursor.failed = true
        return false
    }
    cursor.end = base + length
    cursor.remaining -= 1
    return true
}

public function completeMemoryMap(cursor: borrow MapCursor) -> Bool {
    return !cursor.failed && cursor.remaining == 0
}
