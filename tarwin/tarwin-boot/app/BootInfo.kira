import KCore

// A.1 is a byte protocol, not the memory representation of this struct.
public struct BootInfo {
    var year: U8
    var month: U8
    var week: U8
    var mapAddress: U64
    var mapCount: U64
    var rsdp: U64
    var deviceTree: U64
    var uefiTable: U64
    var framebuffer: U64
    var bootSet: U64
    var bootSetSize: U64
    var entropy0: U64
    var entropy1: U64
    var entropy2: U64
    var entropy3: U64
    var entropy4: U64
    var entropy5: U64
    var entropy6: U64
    var entropy7: U64
    var logAddress: U64
    var logSize: U64
    var kernelVirtual: U64
    var kernelPhysical: U64
    var options: U64
    var panicRecord: U64
    var width: U32
    var height: U32
    var stride: U32
    var format: U32
    var slot: U8
    var security: U8
}

public function emptyBootInfo() -> BootInfo {
    return BootInfo {
        year: 0,
        month: 0,
        week: 0,
        mapAddress: 0,
        mapCount: 0,
        rsdp: 0,
        deviceTree: 0,
        uefiTable: 0,
        framebuffer: 0,
        bootSet: 0,
        bootSetSize: 0,
        entropy0: 0,
        entropy1: 0,
        entropy2: 0,
        entropy3: 0,
        entropy4: 0,
        entropy5: 0,
        entropy6: 0,
        entropy7: 0,
        logAddress: 0,
        logSize: 0,
        kernelVirtual: 0,
        kernelPhysical: 0,
        options: 0,
        panicRecord: 0,
        width: 0,
        height: 0,
        stride: 0,
        format: 0,
        slot: 0,
        security: 0
    }
}

public function bootBlockFits(address: U64, capacity: U64) -> Bool {
    return capacity >= 4096 && alignedTo(address, 4096) && validExtent(address, 4096)
}

// Address arithmetic here does not confer ownership of external memory.
public function validBootInfo(info: borrow BootInfo) -> Bool {
    if info.mapAddress == 0 || info.mapCount == 0 || info.mapCount > U64(0xffffffffffffffff) / 32 { return false }
    if !validExtent(info.mapAddress, info.mapCount * 32) { return false }
    if info.rsdp == 0 && info.deviceTree == 0 { return false }
    if info.bootSet == 0 || !validExtent(info.bootSet, info.bootSetSize) { return false }
    if info.logSize != 0 && (info.logAddress == 0 || !validExtent(info.logAddress, info.logSize)) { return false }
    return info.slot <= 2 && (info.security & 0xe0) == 0 && info.month >= 1 && info.month <= 12 && info.week >= 1
}

function packedBootWord(info: borrow BootInfo, offset: U64) -> U64 {
    if offset == 0 {
        return U64(0x42494254) | (U64(info.year) << 32) | (U64(info.month) << 40) | (U64(info.week) << 48) | (U64(1) << 56)
    }
    if offset == 8 { return 4096 }
    if offset == 64 { return U64(info.width) | (U64(info.height) << 32) }
    if offset == 72 { return U64(info.stride) | (U64(info.format) << 32) }
    if offset == 176 { return U64(info.slot) | (U64(info.security) << 8) }
    if offset == 16 { return info.mapAddress }
    if offset == 24 { return info.mapCount }
    if offset == 32 { return info.rsdp }
    if offset == 40 { return info.deviceTree }
    if offset == 48 { return info.uefiTable }
    if offset == 56 { return info.framebuffer }
    if offset == 80 { return info.bootSet }
    if offset == 88 { return info.bootSetSize }
    if offset == 96 { return info.entropy0 }
    if offset == 104 { return info.entropy1 }
    if offset == 112 { return info.entropy2 }
    if offset == 120 { return info.entropy3 }
    if offset == 128 { return info.entropy4 }
    if offset == 136 { return info.entropy5 }
    if offset == 144 { return info.entropy6 }
    if offset == 152 { return info.entropy7 }
    if offset == 160 { return info.logAddress }
    if offset == 168 { return info.logSize }
    if offset == 184 { return info.kernelVirtual }
    if offset == 192 { return info.kernelPhysical }
    if offset == 200 { return info.options }
    if offset == 208 { return info.panicRecord }
    return 0
}

// After checking bootBlockFits and validBootInfo, emit offsets [0,4096).
public function bootInfoByte(info: borrow BootInfo, offset: U64) -> U8 {
    let word = packedBootWord(info, offset & U64(0xfffffffffffffff8))
    return U8((word >> ((offset & 7) * 8)) & 255)
}

function unpackBootWord(info: borrow mut BootInfo, offset: U64, value: U64) -> Bool {
    if offset == 0 {
        if (value & 0xffffffff) != 0x42494254 || value >> 56 != 1 { return false }
        info.year = U8((value >> 32) & 255)
        info.month = U8((value >> 40) & 255)
        info.week = U8((value >> 48) & 255)
    } else if offset == 8 { return value == 4096 }
    else if offset == 64 {
        info.width = U32(value & 0xffffffff)
        info.height = U32(value >> 32)
    } else if offset == 72 {
        info.stride = U32(value & 0xffffffff)
        info.format = U32(value >> 32)
    } else if offset == 176 {
        if value >> 16 != 0 { return false }
        info.slot = U8(value & 255)
        info.security = U8(value >> 8)
    }
    else if offset == 16 { info.mapAddress = value }
    else if offset == 24 { info.mapCount = value }
    else if offset == 32 { info.rsdp = value }
    else if offset == 40 { info.deviceTree = value }
    else if offset == 48 { info.uefiTable = value }
    else if offset == 56 { info.framebuffer = value }
    else if offset == 80 { info.bootSet = value }
    else if offset == 88 { info.bootSetSize = value }
    else if offset == 96 { info.entropy0 = value }
    else if offset == 104 { info.entropy1 = value }
    else if offset == 112 { info.entropy2 = value }
    else if offset == 120 { info.entropy3 = value }
    else if offset == 128 { info.entropy4 = value }
    else if offset == 136 { info.entropy5 = value }
    else if offset == 144 { info.entropy6 = value }
    else if offset == 152 { info.entropy7 = value }
    else if offset == 160 { info.logAddress = value }
    else if offset == 168 { info.logSize = value }
    else if offset == 184 { info.kernelVirtual = value }
    else if offset == 192 { info.kernelPhysical = value }
    else if offset == 200 { info.options = value }
    else if offset == 208 { info.panicRecord = value }
    else { return value == 0 }
    return true
}

public struct BootDecoder {
    var info: BootInfo
    var nextByte: U64
    var pending: U64
    var invalid: Bool
}

public function beginBootInfo(address: U64, capacity: U64) -> BootDecoder {
    return BootDecoder { info: emptyBootInfo(), nextByte: 0, pending: 0, invalid: !bootBlockFits(address, capacity) }
}

public function acceptBootByte(state: borrow mut BootDecoder, byte: U8) -> Bool {
    if state.invalid || state.nextByte >= 4096 { state.invalid = true
        return false }
    let index = state.nextByte & 7
    state.pending = state.pending | (U64(byte) << (index * 8))
    state.nextByte += 1
    if index == 7 {
        state.invalid = !unpackBootWord(state.info, state.nextByte - 8, state.pending)
        state.pending = 0
    }
    return !state.invalid
}

// The caller checks the producing train against the 52-entry release history
// and validates all external physical spans before handing these to the MM.
public function completeBootInfo(state: borrow BootDecoder) -> Bool {
    return !state.invalid && state.nextByte == 4096 && validBootInfo(state.info)
}
