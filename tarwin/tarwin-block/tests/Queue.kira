import Foundation

function cmd(op: BlockOp, lba: U64, blocks: U64, qos: IoQos, queue: U32) -> BlockCommand {
    return BlockCommand { op: op, lba: lba, blocks: blocks, qos: qos, queue: queue }
}

@Test
function foregroundBypassesLowWithoutReorderingOverlaps() {
    var q = BlockQueue { capacity: 1024, queueCount: 1, depth: 32, pendingLimit: 64 }
    let a = q.enqueue(cmd(.Write, 0, 4, .Background, 0))
    let b = q.enqueue(cmd(.Write, 4, 4, .Utility, 0))
    expect!((q.dispatch(0) == b))
    expect!((q.dispatch(0) == 0))
    let c = q.enqueue(cmd(.Read, 3, 1, .Interactive, 0))
    let d = q.enqueue(cmd(.Read, 8, 1, .Interactive, 0))
    expect!((q.dispatch(0) == d))
    expect!(q.complete(0, 1, b))
    expect!((q.dispatch(0) == a))
    expect!(q.complete(0, 1, a))
    expect!((q.dispatch(0) == c))
}

@Test
function flushSpansQueuesAndRestartRejectsStaleCompletion() {
    var q = BlockQueue { capacity: 64, queueCount: 2, depth: 4, pendingLimit: 64 }
    let a = q.enqueue(cmd(.Write, 0, 1, .Utility, 1))
    let f = q.enqueue(cmd(.Flush, 0, 0, .Default, 0))
    let b = q.enqueue(cmd(.Write, 2, 1, .Initiated, 1))
    expect!((q.dispatch(0) == 0 && q.dispatch(1) == a))
    expect!(q.restart())
    expect!(!q.complete(1, 1, a))
    expect!((q.dispatch(1) == a && q.complete(1, 2, a)))
    expect!((q.dispatch(1) == 0 && q.dispatch(0) == f))
    expect!(q.complete(0, 2, f))
    expect!((q.dispatch(1) == b))
    var last: U64 = 0
    q.removeDevice({ id in last = id })
    expect!((last == b && !q.complete(1, 2, b)))
    expect!((q.enqueue(cmd(.Read, 0, 1, .Default, 0)) == 0))
}

@Test
function refusesOverflowAndMalformedFlush() {
    var q = BlockQueue { capacity: 0xffffffffffffffff, queueCount: 1, depth: 1, pendingLimit: 1 }
    expect!((q.enqueue(cmd(.Fua, 0xfffffffffffffffe, 2, .Interactive, 0)) == 0))
    expect!((q.enqueue(cmd(.Flush, 0, 1, .Interactive, 0)) == 0))
    expect!((q.enqueue(cmd(.Write, 0, 1, .Default, 1)) == 0))
}
