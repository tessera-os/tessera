// Final 4 KiB user leaf in four- or five-level paging, default WB PAT.
public function x64UserPage(pa: U64, paBits: U8, write: Bool, execute: Bool) -> U64 {
    if paBits < 32 || paBits > 52 || (write && execute) || (pa & 4095) != 0 || pa >= (U64(1) << U64(paBits)) { return 0 }
    let rw: U64 = write ? 2 : 0
    let nx: U64 = execute ? 0 : (U64(1) << 63)
    return pa | 5 | rw | nx
}

public function x64WalkIndex(va: U64, levelFromLeaf: U8, la57: Bool) -> U64 {
    if levelFromLeaf > 4 || (levelFromLeaf == 4 && !la57) { return 512 }
    return (va >> (12 + U64(levelFromLeaf) * 9)) & 511
}
