// A.5 request records use volume-local numbers, never process handles or
// addresses. One locked channel belongs to one server instance and volume.
public enum FsOp: U16 {
    Lookup = 1
    GetAttributes = 2
    SetAttributes = 3
    Read = 4
    Write = 5
    Create = 6
    Remove = 7
    Rename = 8
    ReadDirectory = 9
    Link = 10
    SymbolicLink = 11
    ReadLink = 12
    Flush = 13
    Sync = 14
    StatFileSystem = 15
    Watch = 16
    GetXattr = 17
    SetXattr = 18
    ListXattr = 19
    RemoveXattr = 20
}

public struct VolumeNode {
    let volume: U64
    let node: U64
}
public struct FsRecord {
    let op: FsOp
    let id: U64
    let node: U64
    let other: U64
    let offset: U64
    let input: U64
    let output: U64
    let inputBytes: U32
    let outputBytes: U32
}

function putLe(bytes: borrow mut [U8], at: Int, width: Int, value: U64) {
    for i in 0..width { bytes[at + i] = U8((value >> U64(8 * i)) & 255) }
}

public function fsRequestBytes(r: borrow FsRecord) -> [U8] {
    var bytes: [U8] = []
    for i in 0..64 { bytes.append(0) }
    putLe(bytes, 0, 2, 1)
    putLe(bytes, 2, 2, U64(code(r.op)))
    putLe(bytes, 8, 8, r.id)
    putLe(bytes, 16, 8, r.node)
    putLe(bytes, 24, 8, r.other)
    putLe(bytes, 32, 8, r.offset)
    putLe(bytes, 40, 8, r.input)
    putLe(bytes, 48, 8, r.output)
    putLe(bytes, 56, 4, U64(r.inputBytes))
    putLe(bytes, 60, 4, U64(r.outputBytes))
    return move bytes
}

public struct FsChannel {
    let volume: U64
    let epoch: U64
    let limit: Int
    var last: U64 = 0
    var live: Int = 0
    var pending: [FsRecord] = []
    var disconnected: Bool = false

    // The caller has resolved Node rights for this operation. All Memory
    // grants are kernel-created, server-local, request-exclusive and exact
    // ranges. validateShare checks their volume, direction and length.
    function begin(borrow mut self, op: FsOp, primary: borrow VolumeNode, secondary: borrow VolumeNode,
                   offset: U64, input: U64, inBytes: U32, output: U64, outBytes: U32,
                   validateShare: borrow (U64, U64, U32, Bool) -> Bool,
                   publish: borrow (borrow FsRecord) -> Bool) -> Bool {
        if disconnected || live >= limit || last == 0xffffffffffffffff || primary.volume != volume ||
            primary.node == 0 { return false }
        if op == .Rename || op == .Link {
            if secondary.node == 0 || secondary.volume != volume { return false }
        } else if secondary.node != 0 { return false }
        if (input == 0) != (inBytes == 0) || (output == 0) != (outBytes == 0) ||
            (input != 0 && input == output) { return false }
        if input != 0 && !validateShare(volume, input, inBytes, false) { return false }
        if output != 0 && !validateShare(volume, output, outBytes, true) { return false }
        for i in 0..live {
            let p = pending[i]
            if input != 0 && (p.input == input || p.output == input) { return false }
            if output != 0 && (p.input == output || p.output == output) { return false }
        }
        let record = FsRecord { op: op, id: last + 1, node: primary.node, other: secondary.node,
            offset: offset, input: input, output: output, inputBytes: inBytes, outputBytes: outBytes }
        if !publish(record) { return false }
        if live == pending.count { pending.append(record) } else { pending[live] = record }
        live += 1
        last += 1
        return true
    }

    // revoke removes access synchronously before the cache exposes bytes.
    function finish(borrow mut self, sourceEpoch: U64, id: U64, produced: U32,
                    revoke: borrow (borrow FsRecord) -> Bool) -> Bool {
        if disconnected || sourceEpoch != epoch || id == 0 { return false }
        for i in 0..live {
            let p = pending[i]
            if p.id == id {
                if produced > p.outputBytes || !revoke(p) { return false }
                live -= 1
                pending[i] = pending[live]
                return true
            }
        }
        return false
    }

    function disconnect(borrow mut self, revoke: borrow (borrow FsRecord) -> Bool,
                        failPending: borrow (U64) -> Void) -> Bool {
        disconnected = true
        while live > 0 {
            let p = pending[live - 1]
            if !revoke(p) { return false }
            live -= 1
            failPending(p.id)
        }
        return true
    }
}
