public namespace HandleLayout {
    let maximumSlots: U32 = 1048576
    let defaultSlots: U32 = 65536
    let indexMask: U64 = 0xfffff
    let lastGeneration: U64 = 0xfffffffff
}

public function handleIndex(value: U64) -> U32 {
    return U32(value & HandleLayout.indexMask)
}

public function objectKindAllocated(kind: U32) -> Bool {
    return (kind >= TarwinKind.port && kind <= TarwinKind.presence) ||
           (kind >= TarwinKind.interrupt && kind <= TarwinKind.fence)
}

public enum HandleCheck {
    Allowed
    InvalidHandle
    WrongType
    AccessDenied
}

// Slot mutations require the table writer lock. Lookups validate a single
// immutable published snapshot within the reader epoch; the caller pins its
// object before leaving the epoch. This value is not an atomic publication.
public struct HandleSlot {
    var generation: U64
    var koid: U64
    var rights: U64
    var kind: U32

    function name(borrow self, salt: U8, index: U32) -> U64 {
        if index >= HandleLayout.maximumSlots || koid == U64(0) { return U64(0) }
        if generation == U64(0) || generation > HandleLayout.lastGeneration { return U64(0) }
        return (U64(salt) << U64(56)) | (generation << U64(20)) | U64(index)
    }

    function install(borrow mut self, newKoid: U64, newKind: U32, grant: U64, ceiling: U64) -> Bool {
        if koid != U64(0) || generation == U64(0) || generation > HandleLayout.lastGeneration { return false }
        if newKoid == U64(0) || !objectKindAllocated(newKind) { return false }
        if (grant & ceiling) != grant || grant >> U64(32) != U64(0) { return false }
        if newKind == TarwinKind.presence && (grant & U64(3)) != U64(0) { return false }
        koid = newKoid
        kind = newKind
        rights = grant
        return true
    }

    function check(borrow self, value: U64, salt: U8, index: U32, expected: U32, need: U64) -> HandleCheck {
        if value == U64(0) || value != name(salt, index) { return .InvalidHandle }
        if expected != U32(0) && expected != kind { return .WrongType }
        if (rights & need) != need { return .AccessDenied }
        return .Allowed
    }

    // Returns the released object ID, to be dropped after publishing the
    // invalidation. The terminal generation retires rather than reviving a name.
    function revoke(borrow mut self) -> U64 {
        let old = koid
        if old != U64(0) {
            koid = U64(0)
            kind = U32(0)
            rights = U64(0)
            if generation == HandleLayout.lastGeneration { generation = U64(0) }
            else { generation += U64(1) }
        }
        return old
    }
}

public function unusedHandleSlot() -> HandleSlot {
    return HandleSlot { generation: U64(1), koid: U64(0), rights: U64(0), kind: U32(0) }
}

// RIGHTS_SAME is a sentinel for duplicate only; replacement never expands
// rights and does not require Duplicate.
public function handleMayDerive(source: U64, requested: U64, duplicate: Bool) -> Bool {
    if duplicate && (source & U64(1)) == U64(0) { return false }
    if requested == U64(0xffffffffffffffff) { return duplicate }
    return (source & requested) == requested
}
