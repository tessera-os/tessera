import TarwinObject

@Main
function main() -> Int {
    var slot = unusedHandleSlot()
    if !slot.install(U64(77), U32(2), U64(5), U64(7)) { return 1 }
    let value = slot.name(U8(254), U32(1048575))
    if handleIndex(value) != U32(1048575) { return 2 }
    if slot.check(value, U8(254), U32(1048575), U32(2), U64(5)) != .Allowed { return 3 }
    if slot.check(value, U8(253), U32(1048575), U32(2), U64(0)) != .InvalidHandle { return 4 }
    if slot.check(value, U8(254), U32(1048575), U32(4), U64(0)) != .WrongType { return 5 }
    if slot.check(value, U8(254), U32(1048575), U32(2), U64(2)) != .AccessDenied { return 6 }
    if slot.revoke() != U64(77) || slot.revoke() != U64(0) { return 7 }
    if slot.install(U64(78), U32(16), U64(1), U64(7)) { return 8 }
    if !slot.install(U64(78), U32(16), U64(4), U64(7)) { return 9 }
    if slot.check(value, U8(254), U32(1048575), U32(0), U64(0)) != .InvalidHandle { return 10 }
    if slot.name(U8(0), U32(1048576)) != U64(0) { return 11 }
    if handleMayDerive(U64(4), U64(4), true) || !handleMayDerive(U64(4), U64(4), false) { return 12 }
    if !handleMayDerive(U64(5), U64(0xffffffffffffffff), true) { return 13 }
    if handleMayDerive(U64(5), U64(7), false) || handleMayDerive(U64(5), U64(0xffffffffffffffff), false) { return 14 }
    slot.generation = HandleLayout.lastGeneration
    if slot.revoke() != U64(78) || slot.install(U64(78), U32(2), U64(1), U64(1)) { return 15 }
    var fence = unusedHandleSlot()
    if !fence.install(U64(97), TarwinKind.fence, U64(130), U64(130)) { return 16 }
    let timeline = fence.name(U8(9), U32(2))
    if fence.check(timeline, U8(9), U32(2), TarwinKind.presence, U64(0)) != .WrongType { return 17 }
    if fence.check(timeline, U8(9), U32(2), TarwinKind.fence, U64(2)) != .Allowed { return 18 }
    if objectKindAllocated(U32(17)) || objectKindAllocated(U32(18)) || objectKindAllocated(U32(33)) { return 19 }
    return 0
}
