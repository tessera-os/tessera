 /* After restoring an image, we need to update the guest memory and notify
  * it of a potential change to VM Generation ID
  */
+static int vmgenid_rotate(VmGenIdState *vms, Error **errp)
+{
+    QemuUUID fresh;
+
+    if (qcrypto_random_bytes(fresh.data, sizeof(fresh.data), errp) < 0) {
+        return -EIO;
+    }
+    fresh.data[6] = (fresh.data[6] & 0x0f) | 0x40;
+    fresh.data[8] = (fresh.data[8] & 0x3f) | 0x80;
+    vms->guid = fresh;
+    return 0;
+}
+
 static int vmgenid_post_load(void *opaque, int version_id)
 {
     VmGenIdState *vms = opaque;
+    if (vms->rotate_on_load) {
+        uint64_t p = vms->pinned_page;
+        MemoryRegion *ram = MACHINE(qdev_get_machine())->ram;
+        MemoryRegionSection s;
+        QemuUUID guid_le;
+
+        if (!runstate_check(RUN_STATE_PAUSED)) {
+            error_report("vmgenid: destination must already be paused");
+            return -EINVAL;
+        }
+        if (ldq_le_p(vms->vmgenid_addr_le) != p + VMGENID_GUID_OFFSET) {
+            error_report("vmgenid: refusing unbound restore slot");
+            return -EINVAL;
+        }
+        s = memory_region_find(get_system_memory(), p, VMGENID_FW_CFG_SIZE);
+        bool direct = s.mr && s.mr == ram && ram->container == get_system_memory() &&
+                      p >= ram->addr && s.offset_within_region == p - ram->addr &&
+                      s.offset_within_address_space == p &&
+                      int128_eq(s.size, int128_make64(VMGENID_FW_CFG_SIZE));
+        if (!direct || vmgenid_rotate(vms, NULL) < 0) {
+            memory_region_unref(s.mr);
+            return -EIO;
+        }
+        guid_le = qemu_uuid_bswap(vms->guid);
+        hwaddr off = s.offset_within_region + VMGENID_GUID_OFFSET;
+        memcpy((uint8_t *)memory_region_get_ram_ptr(ram) + off,
+               guid_le.data, sizeof(guid_le.data));
+        memory_region_set_dirty(ram, off, sizeof(guid_le.data));
+        memory_region_unref(s.mr);
+        /* The stopped ARM fixture polls the page; no interrupt or MMIO. */
+        return 0;
+    }
     vmgenid_update_guest(vms);
     return 0;
 }
