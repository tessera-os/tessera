@@ -12,6 +12,7 @@
 
 #include "qemu/osdep.h"
 #include "qapi/error.h"
+#include "crypto/random.h"
 #include "qemu/module.h"
 #include "hw/acpi/acpi.h"
 #include "hw/acpi/aml-build.h"
@@ -168,9 +169,25 @@
 /* After restoring an image, we need to update the guest memory and notify
  * it of a potential change to VM Generation ID
  */
+static int vmgenid_rotate(VmGenIdState *vms, Error **errp)
+{
+    QemuUUID fresh;
+
+    if (qcrypto_random_bytes(fresh.data, sizeof(fresh.data), errp) < 0) {
+        return -EIO;
+    }
+    fresh.data[6] = (fresh.data[6] & 0x0f) | 0x40;
+    fresh.data[8] = (fresh.data[8] & 0x3f) | 0x80;
+    vms->guid = fresh;
+    return 0;
+}
+
 static int vmgenid_post_load(void *opaque, int version_id)
 {
     VmGenIdState *vms = opaque;
+    if (vms->rotate_on_load && vmgenid_rotate(vms, NULL) < 0) {
+        return -EIO;
+    }
     vmgenid_update_guest(vms);
     return 0;
 }
@@ -213,11 +230,18 @@
 
     qemu_register_reset(vmgenid_handle_reset, vms);
 
+    if (vms->rotate_on_load) {
+        if (vmgenid_rotate(vms, errp) < 0) {
+            return;
+        }
+    }
+
     vmgenid_update_guest(vms);
 }
 
 static const Property vmgenid_device_properties[] = {
     DEFINE_PROP_UUID(VMGENID_GUID, VmGenIdState, guid),
+    DEFINE_PROP_BOOL("x-rotate-on-load", VmGenIdState, rotate_on_load, false),
 };
 
