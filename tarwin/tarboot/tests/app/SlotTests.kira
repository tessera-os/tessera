import Tarboot

@Main
function main() -> I32 {
    if !archiveTests() { return 9 }
    var a = SlotState { tries: 3, confirmed: false }
    var b = SlotState { tries: 0, confirmed: true }
    while a.tries != 0 {
        let picked = chooseSlot(0, a, b, false)
        if picked.slot != 0 || !picked.persist || picked.remaining != a.tries - 1 { return 1 }
        a.tries = picked.remaining
    }
    let fallback = chooseSlot(0, a, b, false)
    if fallback.slot != 1 || !fallback.persist || fallback.remaining != 0 { return 2 }
    if chooseSlot(1, a, b, false).persist || chooseSlot(1, a, b, true).slot != 2 { return 3 }
    b.confirmed = false
    if chooseSlot(1, a, b, false).slot != 2 { return 4 }
    a.tries = 4
    if chooseSlot(0, a, b, false).slot != 2 { return 5 }
    if bootSetError(false, 99, 1) != 1 || bootSetError(true, 0, 1) != 2 { return 6 }
    if bootSetError(true, 1, 1) != 0 || confirmedFloor(1, 2, true, false) != 1 { return 7 }
    if confirmedFloor(2, 1, true, true) != 2 || confirmedFloor(2, 3, true, true) != 3 { return 8 }
    return 0
}
