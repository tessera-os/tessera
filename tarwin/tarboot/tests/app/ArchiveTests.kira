import KCore
import Tarboot

struct ArchiveBytes: ByteSource {
    var data: RawPtr
    var size: U64
    function byteCount(borrow self) -> U64 { return self.size }
    function byteAt(borrow self, offset: U64) -> U8 {
        if offset >= self.size { runtimeTrap() }
        return heapLoad<U8>(self.data, Int(offset))
    }
    function set(borrow mut self, offset: U64, value: U8) {
        if offset >= self.size { runtimeTrap() }
        heapStore<U8>(self.data, Int(offset), value)
    }
}

function archiveTests() -> Bool {
    // Two independent one-byte stored members "a" and "b".
    var data = ArchiveBytes { data: heapAllocateRaw(145, 8), size: 144 }
    heapFillBytes(data.data, U8(0), 145)
    data.set(0, 84)
    data.set(1, 73)
    data.set(2, 82)
    data.set(3, 65)
    data.set(4, 1)
    data.set(8, 2)
    data.set(16, 26)
    data.set(24, 97)
    data.set(25, 98)
    var p: U64 = 26
    while p < 144 {
        let second = p != 26
        data.set(p, 1)
        data.set(p + 1, second ? U8(98) : U8(97))
        data.set(p + 2, second ? U8(25) : U8(24))
        data.set(p + 10, 1)
        data.set(p + 18, 1)
        p += 59
    }
    var name = ArchiveBytes { data: heapAllocateRaw(1, 8), size: 1 }
    name.set(0, 97)
    let member = findBootMember(data, name)
    var ok = member.validArchive && member.found && member.offset == 24 && member.stored == 1 && member.size == 1 && member.digestAt == 53
    name.set(0, 99)
    let missing = findBootMember(data, name)
    if !missing.validArchive || missing.found { ok = false }
    name.set(0, 97)
    data.set(86, 97)
    if findBootMember(data, name).found { ok = false }
    data.set(86, 192)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(86, 46)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(86, 98)
    data.set(87, 26)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(87, 25)
    data.set(111, 2)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(111, 0)
    data.set(111, 1)
    if !findBootMember(data, name).validArchive { ok = false }
    data.set(111, 0)
    data.set(26, 129)
    data.set(27, 0)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(26, 1)
    data.set(27, 97)
    data.set(23, 128)
    if findBootMember(data, name).validArchive { ok = false }
    data.set(23, 0)
    data.size = 145
    if findBootMember(data, name).validArchive { ok = false }
    var n: U64 = 0
    while n < 144 {
        data.size = n
        if findBootMember(data, name).validArchive { ok = false }
        n += 1
    }
    heapFreeRaw(data.data)
    heapFreeRaw(name.data)
    return ok
}
