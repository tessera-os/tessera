import KCore

// TIR 29.6. The caller pins an immutable archive throughout checking and use.
// Member offsets describe bytes, not trusted images: verify the platform
// signature and each uncompressed BLAKE3 digest before using any payload.
public struct BootMember {
    var validArchive: Bool
    var found: Bool
    var offset: U64
    var stored: U64
    var size: U64
    var compression: U8
    var digestAt: U64
}

function emptyMember() -> BootMember {
    return BootMember { validArchive: false, found: false, offset: 0, stored: 0, size: 0, compression: 0, digestAt: 0 }
}

// Only called with the entire fixed-width record already in bounds.
function little<S: ByteSource>(src: borrow S, at: U64, bytes: U64) -> U64 {
    var value: U64 = 0
    var i: U64 = 0
    while i < bytes {
        value = value | (U64(src.byteAt(at + i)) << (8 * i))
        i += 1
    }
    return value
}

function pathLength<S: ByteSource>(src: borrow S, pos: borrow mut U64) -> U64 {
    var n: U64 = 0
    var shift: U64 = 0
    while shift <= 63 && pos < src.byteCount() {
        let b = src.byteAt(pos)
        pos += 1
        if shift == 63 && b > 1 { return 0 }
        n = n | (U64(b & 127) << shift)
        if b < 128 {
            if shift != 0 && b == 0 { return 0 }
            return n
        }
        shift += 7
    }
    return 0
}

function scalarBytes<S: ByteSource>(s: borrow S, at: U64, end: U64) -> U64 {
    let b = s.byteAt(at)
    if b < 128 { return 1 }
    if b < 194 || b > 244 { return 0 }
    var n: U64 = 2
    if b >= 240 { n = 4 } else if b >= 224 { n = 3 }
    if n > end - at { return 0 }
    let second = s.byteAt(at + 1)
    if (b == 224 && second < 160) || (b == 237 && second >= 160) || (b == 240 && second < 144) || (b == 244 && second >= 144) { return 0 }
    var i: U64 = 1
    while i < n {
        if (s.byteAt(at + i) & 192) != 128 { return 0 }
        i += 1
    }
    return n
}

function componentAllowed<S: ByteSource>(s: borrow S, start: U64, length: U64) -> Bool {
    if length == 0 { return false }
    if s.byteAt(start) != 46 { return true }
    return length != 1 && (length != 2 || s.byteAt(start + 1) != 46)
}

function archivePath<S: ByteSource>(s: borrow S, start: U64, length: U64) -> Bool {
    let end = start + length
    var p = start
    var component = start
    if length >= 2 && s.byteAt(start + 1) == 58 {
        let first = s.byteAt(start) | 32
        if first >= 97 && first <= 122 { return false }
    }
    while p < end {
        let b = s.byteAt(p)
        if b == 0 || b == 92 { return false }
        if b == 47 {
            if !componentAllowed(s, component, p - component) { return false }
            component = p + 1
        }
        let n = scalarBytes(s, p, end)
        if n == 0 { return false }
        p += n
    }
    return componentAllowed(s, component, end - component)
}

function comparePaths<S: ByteSource, T: ByteSource>(a: borrow S, pa: U64, na: U64, b: borrow T, pb: U64, nb: U64) -> I32 {
    var i: U64 = 0
    while i < na && i < nb {
        let x = a.byteAt(pa + i)
        let y = b.byteAt(pb + i)
        if x < y { return -1 }
        if x > y { return 1 }
        i += 1
    }
    if na < nb { return -1 }
    if na > nb { return 1 }
    return 0
}

// A malformed later member invalidates earlier matches. A valid miss is
// distinct from an invalid archive. Paths are compared as unsigned UTF-8.
public function findBootMember<S: ByteSource, N: ByteSource>(src: borrow S, name: borrow N) -> BootMember {
    let end = src.byteCount()
    if end < 24 || little(src, 0, 8) != 0x0000000141524954 || little(src, 12, 4) != 0 { return emptyMember() }
    let count = little(src, 8, 4)
    let table = little(src, 16, 8)
    if table < 24 || table > end || count == 0 || count > (end - table) / 59 { return emptyMember() }
    var pos = table
    var prev: U64 = 0
    var prevBytes: U64 = 0
    var i: U64 = 0
    var member = emptyMember()
    while i < count {
        let bytes = pathLength(src, pos)
        if bytes == 0 || bytes > end - pos || !archivePath(src, pos, bytes) { return emptyMember() }
        if i != 0 && comparePaths(src, prev, prevBytes, src, pos, bytes) >= 0 { return emptyMember() }
        prev = pos
        prevBytes = bytes
        pos += bytes
        if end - pos < 57 { return emptyMember() }
        let offset = little(src, pos, 8)
        let stored = little(src, pos + 8, 8)
        let size = little(src, pos + 16, 8)
        let codec = src.byteAt(pos + 24)
        if offset < 24 || offset > table || stored > table - offset || codec > 1 || (codec == 0 && stored != size) || (codec == 1 && stored == 0) { return emptyMember() }
        if comparePaths(src, prev, bytes, name, 0, name.byteCount()) == 0 {
            member = BootMember { validArchive: false, found: true, offset: offset, stored: stored, size: size, compression: codec, digestAt: pos + 25 }
        }
        pos += 57
        i += 1
    }
    if pos != end { return emptyMember() }
    member.validArchive = true
    return member
}
