import Foundation

var panicBytes: [UN8] = []
function putByte(at: U64, value: U8) { panicBytes[Number(at)] = UN8(value) }
function readByte(at: U64) -> U8 { return U8(panicBytes[Number(at)]) }
function payload(at: U64) -> U8 { return U8(at+40) }
function persist() {}

@Test
function panicCommitIsBoundedAndTornRecordsAreRejected() {
    panicBytes = []
    for i in 0..32 { panicBytes.append(0) }
    var writer = PanicWriter { capacity: 32 }
    expect!(writer.begin(putByte,persist))
    expect!(!writer.section(1,16,payload,putByte))
    expect!(writer.section(1,15,payload,putByte))
    expect!(panicSize(32,readByte) == 0)
    expect!(writer.commit(putByte,persist))
    expect!(panicSize(32,readByte) == 32)
    expect!(panicSize(31,readByte) == 0)
    panicBytes[31] = 0
    expect!(panicSize(32,readByte) == 0)
}

var lastSlot: U64 = 99
var lastHead: U64 = 0
function storeRecord(slot: U64, value: TraceRecord) { lastSlot = slot }
function headRelease(head: U64) { lastHead = head }

@Test
function invalidSharedTailCannotAdvancePrivateRingHead() {
    var producer = TraceProducer { capacity: 64, produced: 64 }
    let event = TraceRecord { monotonicNanos: 3, kind: .Switch, subject: 1, value: 4 }
    expect!(!producer.push(event,0,storeRecord,headRelease))
    expect!(!producer.push(event,65,storeRecord,headRelease))
    expect!(producer.push(event,1,storeRecord,headRelease))
    expect!(lastSlot == 0)
    expect!(lastHead == 65)
    expect!(producer.dropped == 2)
    expect!(!counterAccess(.System,4,4,false))
}
