// Train-private panic format: commit byte, version, two reserved bytes, length
// and CRC32 (little endian); payload TLVs: kind:u8, size:u32, bytes. The writer
// can only address the reserved region through the composition-provided accessors.
public namespace PanicLayout {
    let header: U64 = 12
    let maxBytes: U64 = 1048576
    let committed: U8 = 0xa5
}
function crcByte(initial: U32, byte: U8) -> U32 {
    var v = initial ^ U32(byte)
    var i: U64 = 0
    while i < 8 { v = (v & 1) == 0 ? v >> 1 : (v >> 1) ^ 0xedb88320 i += 1 }
    return v
}
public struct PanicWriter {
    let capacity: U64
    var cursor: U64 = 0
    var crc: U32 = 0xffffffff
    var sealed: Bool = false

    function begin(borrow mut self, put: borrow (U64,U8) -> Void, persist: borrow () -> Void) -> Bool {
        if capacity < PanicLayout.header { return false }
        put(0,0)
        persist()
        put(1,1)
        put(2,0)
        put(3,0)
        cursor = PanicLayout.header
        crc = 0xffffffff
        sealed = false
        return true
    }
    function byte(borrow mut self, data: U8, put: borrow (U64,U8) -> Void) {
        put(cursor,data)
        crc = crcByte(crc,data)
        cursor += 1
    }
    function section(borrow mut self, kind: U8, length: U64, get: borrow (U64) -> U8,
                     put: borrow (U64,U8) -> Void) -> Bool {
        let limit = capacity > PanicLayout.maxBytes ? PanicLayout.maxBytes : capacity
        if sealed || cursor < PanicLayout.header || cursor > limit || limit-cursor < 5
            || length > limit-cursor-5 || kind == 0 { return false }
        byte(kind,put)
        var i: U64 = 0
        while i < 4 { byte(U8((length >> (i*8)) & 255),put) i += 1 }
        i = 0
        while i < length { byte(get(i),put) i += 1 }
        return true
    }
    function commit(borrow mut self, put: borrow (U64,U8) -> Void, persist: borrow () -> Void) -> Bool {
        if cursor <= PanicLayout.header || sealed { return false }
        let digest = U64(crc ^ 0xffffffff)
        var i: U64 = 0
        while i < 4 {
            put(4+i,U8((cursor >> (i*8)) & 255))
            put(8+i,U8((digest >> (i*8)) & 255))
            i += 1
        }
        persist()
        put(0,PanicLayout.committed)
        persist()
        sealed = true
        return true
    }
}

public function panicSize(capacity: U64, get: borrow (U64) -> U8) -> U64 {
    if capacity < PanicLayout.header || get(0) != PanicLayout.committed || get(1) != 1
        || get(2) != 0 || get(3) != 0 { return 0 }
    var length: U64 = 0
    var expected: U64 = 0
    var i: U64 = 0
    while i < 4 {
        length = length | (U64(get(4+i)) << (i*8))
        expected = expected | (U64(get(8+i)) << (i*8))
        i += 1
    }
    if length <= PanicLayout.header || length > capacity || length > PanicLayout.maxBytes { return 0 }
    var crc: U32 = 0xffffffff
    i = PanicLayout.header
    while i < length { crc = crcByte(crc,get(i)) i += 1 }
    if U64(crc ^ 0xffffffff) != expected { return 0 }
    i = PanicLayout.header
    while i < length {
        if length-i < 5 || get(i) == 0 { return 0 }
        var n: U64 = 0
        var j: U64 = 0
        while j < 4 { n = n | (U64(get(i+1+j)) << (j*8)) j += 1 }
        i += 5
        if n > length-i { return 0 }
        i += n
    }
    return length
}
