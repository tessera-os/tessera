import Foundation

// Precondition: configure one pump for each validated, pinned split queue.
// The acquire/publish callbacks operate on that queue's guest pages only. A
// backend returns after I/O is complete; a failed operation with a virtio status
// still returns its used length. A transport failure instead breaks the queue.
public enum PumpResult { Drained Progress Broken }
public struct QueuePump {
    let slots: Number
    var nextAvail: U64 = 0
    var nextUsed: U64 = 0
    var broken: Bool = false

    function serviceOne(borrow mut self, ram: borrow GuestAperture,
                        acquireAvailable: borrow () -> U64, readHead: borrow (U64) -> U64,
                        snapshotTable: borrow () -> [UN8],
                        execute: borrow ([Segment]) -> U64,
                        writeUsed: borrow (U64,U64,U64) -> Void, releaseUsed: borrow (U64) -> Void) -> PumpResult {
        if broken { return .Broken }
        let available = acquireAvailable()
        if slots < 1 || slots > 32768 || (Int(slots) & (Int(slots)-1)) != 0 || available > 65535 {
            broken = true
            return .Broken
        }
        let pending = (65536 + available - nextAvail) & 65535
        if pending == 0 { return .Drained }
        if pending > U64(slots) { broken = true return .Broken }
        let head = readHead(nextAvail % U64(slots))
        if head >= U64(slots) { broken = true return .Broken }
        let segments = match descriptorChain(snapshotTable(),slots,Number(head),ram) {
            Ok(s) -> s
            Error(e) -> { absorb e broken = true return .Broken }
        }
        var maxUsed: U64 = 0
        for s in segments { if s.writable { maxUsed += s.length } }
        let used = execute(move segments)
        if used > maxUsed || used > 0xffffffff { broken = true return .Broken }
        writeUsed(nextUsed % U64(slots),head,used)
        nextUsed = (nextUsed + 1) & 65535
        nextAvail = (nextAvail + 1) & 65535
        releaseUsed(nextUsed)
        return .Progress
    }
}

public struct ModernVirtio {
    let offered: U64
    var accepted: U64 = 0
    var status: U64 = 0
    function negotiate(borrow mut self, bits: U64) -> Bool {
        if status != 3 || (bits & offered) != bits || (bits & 0x100000000) == 0 { return false }
        accepted = bits
        return true
    }
    function writeStatus(borrow mut self, value: U64, drainAndReset: borrow () -> Bool) -> Bool {
        if value == 0 {
            if !drainAndReset() { return false }
            accepted = 0
            status = 0
            return true
        }
        if value > 255 || (value & status) != status || (value & 0x70) != 0 { return false }
        // The driver first acknowledges the device, then the driver, then its features.
        let next = value & 15
        if next != 1 && next != 3 && next != 11 && next != 15 { return false }
        if (value & 2) != 0 && (status & 1) == 0 { return false }
        if (value & 8) != 0 && ((status & 2) == 0 || (accepted & 0x100000000) == 0) { return false }
        if (value & 4) != 0 && (status & 8) == 0 { return false }
        status = value
        return true
    }
    function ready(borrow self) -> Bool { return status == 15 }
}
