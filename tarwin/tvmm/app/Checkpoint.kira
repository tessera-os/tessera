// Live migration is a single-owner handoff. Transport callbacks must be authenticated,
// bound to this transfer's epoch, and durable before commit. A lost ACK is not an abort.
public enum TransferPhase { Running Precopy Stopped Captured Prepared Committed Retired Aborted }
public struct Checkpoint {
    let epoch: U64
    let requiredDevices: U64
    let requiredCpus: U64
    var phase: TransferPhase = .Running
    var nextCpu: U64 = 0
    var savedDevices: U64 = 0

    function start(borrow mut self, generation: U64) -> Bool {
        if generation != epoch || phase != .Running || requiredCpus == 0 || requiredCpus > 512 { return false }
        phase = .Precopy
        return true
    }
    function stopped(borrow mut self, cpusExited: Bool, dmaDrained: Bool, inputsFrozen: Bool) -> Bool {
        if phase != .Precopy || !cpusExited || !dmaDrained || !inputsFrozen { return false }
        phase = .Stopped
        return true
    }
    function cpuSaved(borrow mut self, index: U64) -> Bool {
        if phase != .Stopped || index != nextCpu || index >= requiredCpus { return false }
        nextCpu += 1
        return true
    }
    function devicesSaved(borrow mut self, mask: U64) -> Bool {
        if phase != .Stopped || (mask & requiredDevices) != mask { return false }
        savedDevices = savedDevices | mask
        return true
    }
    function seal(borrow mut self, finalDirtyCopied: Bool, irqTimerSaved: Bool, cloneDurable: Bool) -> Bool {
        if phase != .Stopped || !finalDirtyCopied || !irqTimerSaved || !cloneDurable
            || nextCpu != requiredCpus || savedDevices != requiredDevices { return false }
        phase = .Captured
        return true
    }
    function prepared(borrow mut self, generation: U64, destinationVerified: Bool) -> Bool {
        if generation != epoch || phase != .Captured || !destinationVerified { return false }
        phase = .Prepared
        return true
    }
    function commit(borrow mut self, sourceFenced: Bool, decisionDurable: Bool) -> Bool {
        if phase != .Prepared || !sourceFenced || !decisionDurable { return false }
        phase = .Committed
        return true
    }
    function retired(borrow mut self, generation: U64) -> Bool {
        if generation != epoch || phase != .Committed { return false }
        phase = .Retired
        return true
    }
    function abort(borrow mut self) -> Bool {
        if phase == .Committed || phase == .Retired || phase == .Aborted { return false }
        phase = .Aborted
        nextCpu = 0
        savedDevices = 0
        return true
    }
}
