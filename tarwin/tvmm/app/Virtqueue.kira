import Foundation

// Virtio 1.3 §2.7: little-endian split descriptor table snapshotted from a single VM.
// The caller pins each returned span in that VM's memory objects before submitting I/O.
public struct GuestAperture { let base: U64 let length: U64 }
public struct Segment { let address: U64 let length: U64 let writable: Bool }
public enum QueueError { InvalidQueue InvalidDescriptor InvalidAddress Direction InvalidChain }

function vword(bytes: borrow [UN8], at: Number, width: Number) -> U64 {
    var value: U64 = 0
    for i in 0..width { value = value | (U64(bytes[at + i]) << U64(i * 8)) }
    return value
}

function containsSpan(ram: borrow GuestAperture, address: U64, size: U64) -> Bool {
    if address < ram.base { return false }
    let offset = address - ram.base
    return offset <= ram.length && size <= ram.length - offset
        && (size == 0 || size - 1 <= 0xffffffffffffffff - address)
}

public function descriptorChain(table: borrow [UN8], slots: Number, head: Number,
                                 ram: borrow GuestAperture) -> Result<[Segment], QueueError> {
    if slots < 1 || slots > 32768 || (Int(slots) & (Int(slots) - 1)) != 0
        || table.count != slots * 16 { return .Error(.InvalidQueue) }
    var index = head
    var chain: [Segment] = []
    var writableSeen = false
    for hop in 0..slots {
        if index < 0 || index >= slots { return .Error(.InvalidDescriptor) }
        let p = index * 16
        let address = vword(table,p,8)
        let size = vword(table,p+8,4)
        let flags = vword(table,p+12,2)
        // No indirect or packed descriptors are advertised by this transport.
        if flags > 3 { return .Error(.InvalidDescriptor) }
        if !containsSpan(ram,address,size) { return .Error(.InvalidAddress) }
        let writable = (flags & 2) != 0
        if writableSeen && !writable { return .Error(.Direction) }
        writableSeen = writable
        chain.append(Segment { address: address, length: size, writable: writable })
        if (flags & 1) == 0 { return .Ok(chain) }
        index = Number(vword(table,p+14,2))
    }
    return .Error(.InvalidChain)
}

// Queue event suppression across wrapping 16-bit available/used indices (§2.7.7).
public function needEvent(event: U64, next: U64, previous: U64) -> Bool {
    let distance = (65536 + (next & 65535) - (previous & 65535)) & 65535
    let past = (131071 + (next & 65535) - (event & 65535)) & 65535
    return past < distance
}
