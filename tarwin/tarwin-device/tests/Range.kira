import Foundation

@Test
function rangeEndsAtLastAddress() {
    let top = DeviceRange { base: 0xfffffffffffff000, length: 4096 }
    expect!(top.contains(DeviceRange { base: 0xffffffffffffffff, length: 1 }))
    expect!(!top.contains(DeviceRange { base: 0xffffffffffffffff, length: 2 }))
    expect!(!top.overlaps(DeviceRange { base: 0, length: 1 }))
    expect!(!deviceAligned(4096, 0))
    expect!(!deviceAligned(0, 3))
    expect!(deviceAligned(4096, 4096))
}
