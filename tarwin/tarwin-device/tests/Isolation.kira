import Foundation

@Test
function randomAllocationExcludesRetiringPages() {
    let aperture = DeviceRange { base: 0x8000, length: 0x4000 }
    let held = [DeviceRange { base: 0x9000, length: 4096 }]
    expect!(chooseDmaAddress(aperture, 4096, 4096, 1, held) == DmaAddress.Unavailable)
    match chooseDmaAddress(aperture, 4096, 4096, 3, held) {
        Selected(address) -> { expect!(address == 0xb000) }
        Unavailable -> { expect!(false) }
    }
    expect!(chooseDmaAddress(aperture, 4095, 4096, 0, held) == DmaAddress.Unavailable)
}

@Test
function retirementWaitsForBothCaches() {
    var r = DmaRetirement { domain: 9, pin: 7, base: 4096, bytes: 4096, phase: .Mapped }
    var order: Int = 0
    let dropPte: (U64, U64, U64) -> Bool = { d, a, n in
        order = order * 10 + 1
        return d == 9 && a == 4096 && n == 4096
    }
    let flush: (U64, U64, U64) -> Bool = { d, a, n in order = order * 10 + 2
        return true
    }
    let timeout: (U64, U64, U64) -> Bool = { d, a, n in return false }
    let unpin: (U64) -> Void = { pin in order = order * 10 + Int(pin) }
    expect!(!r.retire(dropPte, flush, timeout, unpin))
    expect!((order == 12 && r.phase == DmaRetirePhase.IoFlushed))
    expect!(r.retire(dropPte, flush, flush, unpin))
    expect!(r.retire(dropPte, flush, flush, unpin))
    expect!(order == Int(1227))
}

@Test
function fullPortAndOldSlotCannotUnmask() {
    var irq = DriverInterrupt { slotEpoch: 3, state: .Armed }
    var calls: Int = 0
    let bump: () -> Void = { in calls = calls + 1 }
    expect!(!irq.deliver(bump, { in return false }))
    expect!(irq.deliver(bump, { in return true }))
    expect!(!irq.complete(2, bump))
    irq.revoke(bump)
    expect!(!irq.complete(3, bump))
    expect!(calls == 2)
}

@Test
function filtersApplyToWholeConfigWriteAndApiWindow() {
    expect!(!pciConfigWriteAllowed(0x10, 4, 0xffffffff, 0xffffffff, 0, true))
    expect!(!pciConfigWriteAllowed(0x102, 2, 1, 1, 0, true))
    expect!(!pciConfigWriteAllowed(0x41, 2, 1, 1, 0, true))
    expect!(!pciConfigWriteAllowed(0x40, 1, 3, 1, 0, true))
    expect!(pciConfigWriteAllowed(0x40, 1, 3, 1, 2, true))
    expect!(inDriverApiWindow(27, 10, 26, 11))
    expect!(!inDriverApiWindow(27, 11, 26, 11))
    expect!(!inDriverApiWindow(26, 11, 26, 10))
    expect!(!inDriverApiWindow(26, 11, 26, 12))
}
