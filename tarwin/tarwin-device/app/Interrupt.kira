// Serialized by the interrupt object's lock. A full port leaves the IRQ
// masked with a pending notification, not lost or spuriously re-enabled.
public enum IrqState { Armed Pending Delivered Revoked }
public struct DriverInterrupt {
    let slotEpoch: U64
    var state: IrqState

    function deliver(borrow mut self, acknowledgeAndMask: borrow () -> Void,
                     post: borrow () -> Bool) -> Bool {
        if state == .Armed {
            acknowledgeAndMask()
            state = .Pending
        }
        return retryPost(post)
    }

    function retryPost(borrow mut self, post: borrow () -> Bool) -> Bool {
        if state != .Pending || !post() { return false }
        state = .Delivered
        return true
    }

    function complete(borrow mut self, ownerEpoch: U64, unmask: borrow () -> Void) -> Bool {
        if slotEpoch != ownerEpoch || state != .Delivered { return false }
        state = .Armed
        unmask()
        return true
    }

    function revoke(borrow mut self, mask: borrow () -> Void) {
        if state != .Revoked { mask() }
        state = .Revoked
    }
}
