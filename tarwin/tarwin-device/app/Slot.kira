// One record per inseparable IOMMU group, held under the registry lock.
public enum SlotPhase { Vacant Active Masking Unmapping Draining Resetting Removed }
public struct DeviceSlotState {
    let group: U64
    var phase: SlotPhase = .Vacant
    var owner: U64 = 0
    var epoch: U64 = 0
    var vanished: Bool = false

    // The group-domain provider attaches every member and establishes
    // interrupt remapping before it reports success; failure stays isolated.
    function assign(borrow mut self, deviceRoot: Bool, process: U64,
                    isolateGroup: borrow (U64, U64) -> Bool) -> Bool {
        if !deviceRoot || process == 0 || phase != .Vacant || epoch == 0xffffffffffffffff { return false }
        if !isolateGroup(group, epoch + 1) { return false }
        epoch += 1
        owner = process
        phase = .Active
        return true
    }

    function owns(borrow self, process: U64, generation: U64) -> Bool {
        return phase == .Active && owner == process && epoch == generation
    }

    // Callbacks complete synchronously and are idempotent on failure. Block
    // all new operations immediately, including config writes and doorbells.
    function revoke(borrow mut self, removed: Bool, maskAndDrainIrqs: borrow () -> Bool,
                    revokeCpuMappings: borrow () -> Bool, retireAllDma: borrow () -> Bool,
                    resetGroup: borrow () -> Bool) -> Bool {
        vanished = vanished || removed
        if phase == .Removed { return true }
        if phase == .Vacant {
            if vanished { phase = .Removed }
            return true
        }
        if phase == .Active { phase = .Masking }
        if phase == .Masking {
            if !maskAndDrainIrqs() { return false }
            phase = .Unmapping
        }
        if phase == .Unmapping {
            if !revokeCpuMappings() { return false }
            phase = .Draining
        }
        if phase == .Draining {
            if !retireAllDma() { return false }
            phase = .Resetting
        }
        if !vanished && !resetGroup() { return false }
        phase = vanished ? SlotPhase.Removed : SlotPhase.Vacant
        owner = 0
        return true
    }
}

public enum DeviceCache { Register FrameBuffer }
public struct MmioAperture {
    let range: DeviceRange
    let frameBuffer: Bool
}

// The platform supplies device attributes for registers, WC only for a
// trusted framebuffer, and rejects a mapping if NX cannot be enforced.
public function mapSlotRegisters(slot: borrow DeviceSlotState, process: U64, generation: U64,
                                 region: borrow MmioAperture, bytes: borrow DeviceRange,
                                 pageSize: U64, cache: DeviceCache,
                                 recordAndMapNx: borrow (U64, U64, U64, DeviceCache) -> Bool) -> Bool {
    if !slot.owns(process, generation) || !region.range.contains(bytes) ||
        !deviceAligned(bytes.base,pageSize) || !deviceAligned(bytes.length,pageSize) ||
        (cache == .FrameBuffer && !region.frameBuffer) { return false }
    return recordAndMapNx(process,bytes.base,bytes.length,cache)
}
