import TarwinTime

@Main
function main() -> I32 {
    if counterDuration(1, 0).valid || counterDuration(0xffffffffffffffff, 1).valid { return 1 }
    if counterDuration(20, 3).ns != 6666666666 || counterDuration(0, 100).ns != 0 { return 2 }
    if counterDuration(0xfffffffffffffffe, 0xffffffffffffffff).ns != 999999999 { return 3 }
    let full = counterDuration(0xffffffffffffffff, 1000000000)
    if !full.valid || full.ns != 0xffffffffffffffff { return 4 }
    if counterDuration(0x8000000000000000, 0xffffffffffffffff).ns != 500000000 { return 5 }
    if utcSlewLimit(100, 199999) != 99 || backgroundSlack(0xffffffffffffffff) != 1000000000 { return 6 }
    if coalesceDeadline(100, 4, 99) != 100 || coalesceDeadline(100, 4, 104) != 104 || coalesceDeadline(100, 4, 105) != 100 { return 7 }
    if lockupCode(20000000000, 20000000000, 0) != 6 || lockupCode(9999999999, 0, 0) != 0 || lockupCode(10000000000, 0, 10000000000) != 6 { return 8 }
    return 0
}
