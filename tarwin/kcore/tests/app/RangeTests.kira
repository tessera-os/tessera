import KCore

@Main
function main() -> I32 {
    if withinRange(0, 0, 0, 32) || withinRange(32, 1, 0, 32) { return 1 }
    if !withinRange(16, 16, 16, 32) || withinRange(15, 1, 16, 32) { return 2 }
    if validExtent(0xffffffffffffffff, 1) || isPowerOfTwo(0) { return 3 }
    if !alignedTo(0x4000, 0x4000) || alignedTo(48, 3) { return 4 }
    return 0
}
