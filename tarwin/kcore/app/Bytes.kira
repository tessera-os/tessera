// Bounded, caller-owned storage. Implementations keep the accessible extent
// stable throughout a borrow. Kernel callers must pin mappings before use.
public trait ByteSource {
    function byteCount(borrow self) -> U64
    function byteAt(borrow self, offset: U64) -> U8
}

public trait ByteBuffer: ByteSource {
    function putByte(borrow mut self, offset: U64, value: U8)
}
