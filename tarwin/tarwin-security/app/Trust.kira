public enum SigningRole {
    Release
    Device
    Developer
    EnrolledPlatform
}

public enum ImagePurpose {
    BootSet
    System
    Framework
    Application
    Driver
    Finalized
    Probe
    DynamicCode
}

// Policy after certificate and signature verification. This does not
// authenticate a key, inspect a certificate, or mark a page as executable.
public function signerPermitted(role: borrow SigningRole, purpose: borrow ImagePurpose,
                                certified: Bool, developerMode: Bool, localDevice: Bool,
                                certificateDays: U32, revoked: Bool) -> Bool {
    if revoked { return false }
    return match role {
        Release -> purpose == .BootSet || purpose == .System || purpose == .Framework ||
                   purpose == .Application || purpose == .Driver
        Device -> localDevice && (purpose == .Finalized || purpose == .Probe || purpose == .DynamicCode)
        Developer -> developerMode && certificateDays > U32(0) && certificateDays <= U32(182) &&
                     (purpose == .Application || purpose == .Driver || purpose == .Framework)
        EnrolledPlatform -> !certified && (purpose == .BootSet || purpose == .System)
    }
}

public function processEntitlements(signedMask: U64, jobCeiling: U64) -> U64 {
    return signedMask & jobCeiling
}
