import Foundation

function report(key: borrow String, result: Verdict) -> Number {
    match result {
        Passed -> { print("PASS " + key) return 0 }
        Missed -> { print("FAIL " + key) return 1 }
        Missing -> { print("NOT VERIFIED " + key) return 1 }
    }
}

function suiteResult(root: borrow String, ref: borrow Reference, key: borrow String) -> Verdict {
    match evidence(root, ref, key, "tarwin", 1) {
        Some(value) -> {
            if value == "pass" { return .Passed }
            if value == "fail" { return .Missed }
            return .Missing
        }
        None -> return .Missing
    }
}

function runDevice(root: borrow String, ref: borrow Reference) -> Number {
    print("reference " + ref.serial + " (" + ref.arch + ")")
    var blocked: Number = 0
    for key in deviceCases(ref) { blocked += report(key, suiteResult(root, ref, key)) }
    for budget in budgets(ref.battery) { blocked += report(budget.name, budgetVerdict(root, ref, budget)) }
    return blocked
}

@Main
function main() -> Number {
    if processArgumentCount() != 2 && processArgumentCount() != 3 {
        print("usage: tarwin-conformance <reference-inventory.tsv> <evidence-directory> [absolute-lab-adapter]")
        return 2
    }
    let path = match processArgument(0) { Some(p) -> p None -> return 2 }
    let root = match processArgument(1) { Some(p) -> p None -> return 2 }
    let inventory = match readFile(path) {
        Ok(f) -> f.text
        Error(failure) -> { absorb failure print("NOT VERIFIED reference inventory unavailable") return 2 }
    }
    var references: [Reference] = []
    var devices: [String] = []
    var architectures: [String] = []
    for line in inventory.split("\n") {
        if line.trim().count == 0 || line.startsWith("#") { continue }
        let ref = match reference(line) {
            Some(r) -> r
            None -> { print("invalid physical-reference inventory row") return 2 }
        }
        if devices.contains(ref.serial) { print("duplicate reference id " + ref.serial) return 2 }
        devices.append(copy ref.serial)
        architectures.append(copy ref.arch)
        references.append(ref)
    }
    var blocked: Number = 0
    for arch in ["aarch64", "x64", "rv64"] {
        if !architectures.contains(arch) { blocked += report("physical reference: " + arch, .Missing) }
    }
    let adapter = match processArgument(2) { Some(p) -> p None -> "" }
    if processArgumentCount() == 3 {
        if !adapter.startsWith("/") || pathExists(root) {
            print("collection needs an absolute adapter and a new evidence directory")
            return 2
        }
        match makeDirectory(root) { Ok -> {} Error(failure) -> { absorb failure return 2 } }
    }
    for ref in references {
        if adapter.count > 0 && !collect(adapter, root, ref) {
            blocked += report("lab collection: " + ref.serial, .Missing)
        }
        blocked += runDevice(root, ref)
    }
    if blocked != 0 { print("TRAIN BLOCKED: \(blocked) failed or unverified gates") return 1 }
    print("All catalogued physical-reference gates passed; inspect captures and the coverage ledger before release.")
    return 0
}
