import Foundation

function deviceCases(ref: borrow Reference) -> [String] {
    var required = cases()
    required.append(ref.nested ? "hv.nested" : "hv.reject-nested")
    required.append(ref.confidential ? "hv.confidential-attestation" : "hv.reject-confidential")
    return required
}

function trials(key: borrow String, system: borrow String) -> String {
    var s = ""
    for i in 1..11 { s += "\(key)\t\(system)\t\(i)\n" }
    return s
}

// A controller may batch reboots, but may not reuse another trial's samples.
function measurementPlan(ref: borrow Reference) -> String {
    var plan = ""
    for key in deviceCases(ref) { plan += "\(key)\ttarwin\t1\n" }
    for b in budgets(ref.battery) {
        plan += trials(b.name, "tarwin")
        if b.baseline == "best-fs" {
            plan += trials(b.name, "linux-ext4") + trials(b.name, "linux-btrfs")
        } else if b.baseline != "absolute" {
            plan += trials(b.name, b.baseline)
        }
    }
    return plan
}

function collect(program: borrow String, root: borrow String, ref: borrow Reference) -> Bool {
    let path = root + "/" + ref.serial + ".plan.tsv"
    match writeFile(path, measurementPlan(ref)) {
        Ok -> {}
        Error(failure) -> { absorb failure return false }
    }
    let cmd = ProcessCommand { program: copy program, arguments: [copy ref.arch, copy ref.serial,
        copy ref.tarwin, copy ref.linux, copy root, path], input: .Null }
    let child = match cmd.start() { Ok(c) -> c Error(e) -> { absorb e return false } }
    let ok = match child.wait() {
        Ok(exit) -> match exit { Status(code) -> code == 0 Signalled(_) -> false }
        Error(failure) -> { absorb failure false }
    }
    match child.release() { Ok -> {} Error(failure) -> { absorb failure return false } }
    return ok
}
