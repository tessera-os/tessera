public struct UdpRoute {
    let family: IpFamily
    let source: [U8]
    let destination: [U8]
    let sourcePort: U16
    let destinationPort: U16
    let hops: U8
    let mtu: U32
}
public enum OutputResult { Invalid TooLarge Packet([U8]) }

function putWord(bytes: borrow mut [U8], offset: Int, value: U32) {
    bytes[offset] = U8((value >> 8) & 255)
    bytes[offset + 1] = U8(value & 255)
}

public function udpOutput(route: borrow UdpRoute, payload: borrow [U8]) -> OutputResult {
    let v4 = route.family == .V4
    let width: Int = v4 ? 4 : 16
    let ip: Int = v4 ? 20 : 40
    if route.source.count != width || route.destination.count != width ||
        route.destinationPort == 0 || route.hops == 0 { return .Invalid }
    if payload.count > 65527 || (v4 && payload.count > 65507) { return .TooLarge }
    let udp = 8 + payload.count
    let total = ip + udp
    if U32(total) > route.mtu { return .TooLarge }
    var bytes: [U8] = []
    for i in 0..(ip + 8) { bytes.append(0) }
    for byte in payload { bytes.append(byte) }
    var start: Int = 8
    if v4 {
        bytes[0] = 0x45
        putWord(bytes,2,U32(total))
        bytes[6] = 0x40
        bytes[8] = route.hops
        bytes[9] = 17
        start = 12
    } else {
        bytes[0] = 0x60
        putWord(bytes,4,U32(udp))
        bytes[6] = 17
        bytes[7] = route.hops
    }
    for i in 0..width { bytes[start + i] = route.source[i]
        bytes[start + width + i] = route.destination[i] }
    if v4 { putWord(bytes,10,0xffff ^ sumBytes(bytes,0,20,0)) }
    putWord(bytes,ip,U32(route.sourcePort))
    putWord(bytes,ip + 2,U32(route.destinationPort))
    putWord(bytes,ip + 4,U32(udp))
    let pseudo = sumBytes(bytes,start,width * 2,0) + U32(udp) + 17
    let checksum = 0xffff ^ sumBytes(bytes,ip,udp,(pseudo & 0xffff) + (pseudo >> 16))
    putWord(bytes,ip + 6,checksum == 0 ? 0xffff : checksum)
    return .Packet(move bytes)
}
