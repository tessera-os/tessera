// A.4: capture these fields from untrusted shared memory once at attach.
public namespace RingFormat {
    let magic: U32 = 0x474e5254
    let version: U16 = 1
    let requestProducer: U64 = 64
    let requestConsumer: U64 = 128
    let requestProducerIdle: U64 = 192
    let requestConsumerIdle: U64 = 256
    let completionProducer: U64 = 320
    let completionConsumer: U64 = 384
    let completionProducerIdle: U64 = 448
    let completionConsumerIdle: U64 = 512
    let records: U64 = 4096
}

public struct RingGeometry {
    let count: U32
    let stride: U32

    function valid(borrow self) -> Bool {
        if count < U32(64) || count > U32(65536) { return false }
        if (count & (count - U32(1))) != U32(0) { return false }
        return stride == U32(64) || stride == U32(128)
    }

    function fits(borrow self, mappingBytes: U64) -> Bool {
        if !valid() { return false }
        return RingFormat.records + U64(2) * U64(count) * U64(stride) <= mappingBytes
    }

    // Call after fits(). Neither queue uses the header again after attach.
    function offset(borrow self, index: U32, completion: Bool) -> U64 {
        let slot = index & (count - U32(1))
        var base = RingFormat.records
        if completion { base += U64(count) * U64(stride) }
        return base + U64(slot) * U64(stride)
    }
}

public function ringHeaderAllowed(magic: U32, version: U16, flags: U16) -> Bool {
    return magic == RingFormat.magic && version == RingFormat.version && flags == U16(0)
}

// All positions are logical monotonic u32 indices, not masked offsets.
// Compare a peer's acquire-loaded cursor with its last accepted value.
public function ringProducerValid(last: U32, producer: U32, consumed: U32, count: U32) -> Bool {
    if producer < last || producer < consumed { return false }
    return producer - consumed <= count
}

public function ringConsumerValid(last: U32, consumer: U32, produced: U32) -> Bool {
    return consumer >= last && consumer <= produced
}
