import TarwinIpc

@Main
function main() -> Int {
    let ring = RingGeometry { count: U32(64), stride: U32(64) }
    if !ring.fits(U64(12288)) || ring.fits(U64(12287)) { return 1 }
    if ring.offset(U32(64), false) != U64(4096) { return 2 }
    if ring.offset(U32(127), true) != U64(12224) { return 3 }
    let wide = RingGeometry { count: U32(65536), stride: U32(128) }
    if !wide.fits(U64(16781312)) { return 4 }
    let badCount = RingGeometry { count: U32(96), stride: U32(64) }
    let badStride = RingGeometry { count: U32(64), stride: U32(65) }
    if badCount.valid() || badStride.valid() { return 5 }
    if !ringProducerValid(U32(400), U32(464), U32(400), U32(64)) { return 6 }
    if ringProducerValid(U32(400), U32(465), U32(400), U32(64)) { return 7 }
    if ringProducerValid(U32(400), U32(399), U32(395), U32(64)) { return 8 }
    if ringConsumerValid(U32(400), U32(465), U32(464)) { return 9 }
    if !ringHeaderAllowed(U32(0x474e5254), U16(1), U16(0)) { return 10 }
    if ringHeaderAllowed(U32(0x474e5254), U16(1), U16(1)) { return 11 }
    var credits = PortCredits { capacity: U32(2), pending: U32(0), available: U32(0) }
    if !credits.reserve() || !credits.postUser() || credits.reserve() || credits.postUser() { return 12 }
    if !credits.complete() || credits.complete() || credits.free() != U32(0) { return 13 }
    if !credits.take() || !credits.take() || credits.take() || credits.free() != U32(2) { return 14 }
    var call = ServiceCall { transaction: U64(17), deadline: U64(40), context: U64(5), server: U64(0), state: .Waiting }
    if !call.receive(U64(8), U64(20)) || call.receive(U64(9), U64(20)) { return 15 }
    if call.donatedTo(U64(9)) != U64(0) || call.donatedTo(U64(8)) != U64(5) { return 16 }
    if call.reply(U64(18), U64(8), U64(21)) || call.reply(U64(17), U64(9), U64(21)) { return 17 }
    if call.reply(U64(17), U64(8), U64(40)) || call.state != .TimedOut || call.cancel(true) { return 18 }
    if call.donatedTo(U64(8)) != U64(0) { return 19 }
    var peer = ServiceCall { transaction: U64(1), deadline: U64(99), context: U64(6), server: U64(0), state: .Waiting }
    if !peer.cancel(true) || peer.receive(U64(2), U64(0)) || peer.state != .PeerClosed { return 20 }
    var ok = ServiceCall { transaction: U64(9), deadline: U64(99), context: U64(6), server: U64(0), state: .Waiting }
    if !ok.receive(U64(1), U64(0)) || !ok.reply(U64(9), U64(1), U64(1)) || ok.cancel(false) { return 21 }
    if !channelMessageFits(U64(65536), U64(64)) || inlineCall(U32(129), U32(4)) { return 22 }
    return 0
}
