// One inclusion proof for a chunk in the exact byte stream covered by the
// signed build ID. Tree shape and direction come from the signed size and
// the requested chunk's index, never from proof metadata.
public struct ImageChunkProof {
    let size: U64
    let chunk: U64
    var remaining: U64
    var position: U64
    var nodes: U64
    var first: Bool
    var hashed: Bool
    var failed: Bool
    var chain: BlakeCv

    // Each block is 16 little-endian words, zero-padded beyond its length.
    function absorb(borrow mut self, block: borrow BlakeBlock, length: U32) -> Bool {
        var expected = remaining
        if expected > U64(64) { expected = U64(64) }
        if failed || hashed || U64(length) != expected {
            failed = true
            return false
        }
        var flags: U32 = 0
        if first { flags = U32(1) }
        if remaining == expected {
            flags = flags | U32(2)
            hashed = true
            if nodes == U64(1) { flags = flags | U32(8) }
        }
        chain = blakeCompress(chain, block, chunk, length, flags)
        first = false
        remaining -= expected
        return true
    }

    // Unpaired rightmost nodes rise unchanged; no proof word is consumed
    // for them. Input siblings are ordered leaf to root.
    function sibling(borrow mut self, other: borrow BlakeCv) -> Bool {
        if failed || !hashed || nodes <= U64(1) {
            failed = true
            return false
        }
        while (nodes & U64(1)) != U64(0) && position == nodes - U64(1) {
            position = position >> U64(1)
            nodes = (nodes + U64(1)) >> U64(1)
        }
        var pair = BlakeBlock { low: chain, high: other }
        if (position & U64(1)) != U64(0) { pair = BlakeBlock { low: other, high: chain } }
        var flags: U32 = 4
        if nodes == U64(2) { flags = U32(12) }
        chain = blakeCompress(initialCv(), pair, U64(0), U32(64), flags)
        position = position >> U64(1)
        nodes = (nodes + U64(1)) >> U64(1)
        return true
    }

    function verifies(borrow self, signedRoot: borrow BlakeCv) -> Bool {
        return !failed && hashed && nodes == U64(1) && position == U64(0) && chain.matches(
            signedRoot
        )
    }
}

// Interior non-root node used to build the loader's proof cache.
public function imageParentCv(left: borrow BlakeCv, right: borrow BlakeCv) -> BlakeCv {
    let block = BlakeBlock { low: left, high: right }
    return blakeCompress(initialCv(), block, U64(0), U32(64), U32(4))
}

public function imageChunk(size: U64, chunk: U64) -> ImageChunkProof {
    var nodes: U64 = 1
    if size != U64(0) { nodes = (size - U64(1)) / U64(1024) + U64(1) }
    var length: U64 = 0
    if chunk < nodes {
        length = size - chunk * U64(1024)
        if length > U64(1024) { length = U64(1024) }
    }
    return ImageChunkProof {
        size: size,
        chunk: chunk,
        remaining: length,
        position: chunk,
        nodes: nodes,
        first: true,
        hashed: false,
        failed: chunk >= nodes,
        chain: initialCv()
    }
}

// The pager keeps the source page private and pinned until this verifies.
// Zero-fill any tail after EOF; this covers only the file-backed bytes. It
// neither validates an image signature nor grants executable permission.
public struct PageIntegrity {
    let size: U64
    let endChunk: U64
    let root: BlakeCv
    var nextChunk: U64
    var failed: Bool

    function accept(borrow mut self, proof: borrow ImageChunkProof) -> Bool {
        if failed || nextChunk >= endChunk || size != proof.size ||
            nextChunk != proof.chunk || !proof.verifies(root) {
            failed = true
            return false
        }
        nextChunk += U64(1)
        return true
    }

    function verified(borrow self) -> Bool { return !failed && nextChunk == endChunk }
}

public function pageIntegrity(
    size: U64,
    offset: U64,
    pageBytes: U64,
    root: borrow BlakeCv
) -> PageIntegrity {
    let first = offset / U64(1024)
    var count: U64 = 0
    if (
        pageBytes == U64(4096) || pageBytes == U64(16384)
    ) && offset < size && offset % pageBytes == U64(0) {
        var length = size - offset
        if length > pageBytes { length = pageBytes }
        count = (length - U64(1)) / U64(1024) + U64(1)
    }
    return PageIntegrity {
        size: size,
        nextChunk: first,
        endChunk: first + count,
        root: root,
        failed: count == U64(0)
    }
}
