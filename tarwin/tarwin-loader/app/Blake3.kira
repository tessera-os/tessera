// Unkeyed BLAKE3-256 compression. Based on BLAKE3-team/BLAKE3 1.8.2,
// reference_impl (CC0-1.0). Fixed-size scalar values only: no heap or SIMD.
public struct BlakeCv {
    let w0: U32
    let w1: U32
    let w2: U32
    let w3: U32
    let w4: U32
    let w5: U32
    let w6: U32
    let w7: U32

    function matches(borrow self, b: borrow BlakeCv) -> Bool {
        return w0 == b.w0 &&
            w1 == b.w1 &&
            w2 == b.w2 &&
            w3 == b.w3 &&
            w4 == b.w4 &&
            w5 == b.w5 &&
            w6 == b.w6 &&
            w7 == b.w7
    }
}

// Sixteen little-endian words read from private, pinned file bytes.
public struct BlakeBlock {
    let low: BlakeCv
    let high: BlakeCv
}

function initialCv() -> BlakeCv {
    return BlakeCv {
        w0: U32(0x6a09e667),
        w1: U32(0xbb67ae85),
        w2: U32(0x3c6ef372),
        w3: U32(0xa54ff53a),
        w4: U32(0x510e527f),
        w5: U32(0x9b05688c),
        w6: U32(0x1f83d9ab),
        w7: U32(0x5be0cd19)
    }
}

struct BlakeMix {
    let a: U32
    let b: U32
    let c: U32
    let d: U32
}

function addWords(x: U32, y: U32, z: U32) -> U32 {
    return U32((U64(x) + U64(y) + U64(z)) & U64(0xffffffff))
}

function rotr32(word: U32, bits: U32) -> U32 {
    return (word >> bits) | (word << (U32(32) - bits))
}

function blakeMix(a: U32, b: U32, c: U32, d: U32, x: U32, y: U32) -> BlakeMix {
    let a1 = addWords(a, b, x)
    let d1 = rotr32(d ^ a1, U32(16))
    let c1 = addWords(c, d1, U32(0))
    let b1 = rotr32(b ^ c1, U32(12))
    let a2 = addWords(a1, b1, y)
    let d2 = rotr32(d1 ^ a2, U32(8))
    let c2 = addWords(c1, d2, U32(0))
    return BlakeMix { a: a2, b: rotr32(b1 ^ c2, U32(7)), c: c2, d: d2 }
}

function blakeRound(s: borrow BlakeBlock, m: borrow BlakeBlock) -> BlakeBlock {
    let c0 = blakeMix(s.low.w0, s.low.w4, s.high.w0, s.high.w4, m.low.w0, m.low.w1)
    let c1 = blakeMix(s.low.w1, s.low.w5, s.high.w1, s.high.w5, m.low.w2, m.low.w3)
    let c2 = blakeMix(s.low.w2, s.low.w6, s.high.w2, s.high.w6, m.low.w4, m.low.w5)
    let c3 = blakeMix(s.low.w3, s.low.w7, s.high.w3, s.high.w7, m.low.w6, m.low.w7)
    let d0 = blakeMix(c0.a, c1.b, c2.c, c3.d, m.high.w0, m.high.w1)
    let d1 = blakeMix(c1.a, c2.b, c3.c, c0.d, m.high.w2, m.high.w3)
    let d2 = blakeMix(c2.a, c3.b, c0.c, c1.d, m.high.w4, m.high.w5)
    let d3 = blakeMix(c3.a, c0.b, c1.c, c2.d, m.high.w6, m.high.w7)
    return BlakeBlock {
        low: BlakeCv {
            w0: d0.a,
            w1: d1.a,
            w2: d2.a,
            w3: d3.a,
            w4: d3.b,
            w5: d0.b,
            w6: d1.b,
            w7: d2.b
        },
        high: BlakeCv {
            w0: d2.c,
            w1: d3.c,
            w2: d0.c,
            w3: d1.c,
            w4: d1.d,
            w5: d2.d,
            w6: d3.d,
            w7: d0.d
        }
    }
}

function permuteMessage(m: borrow BlakeBlock) -> BlakeBlock {
    return BlakeBlock {
        low: BlakeCv {
            w0: m.low.w2,
            w1: m.low.w6,
            w2: m.low.w3,
            w3: m.high.w2,
            w4: m.low.w7,
            w5: m.low.w0,
            w6: m.low.w4,
            w7: m.high.w5
        },
        high: BlakeCv {
            w0: m.low.w1,
            w1: m.high.w3,
            w2: m.high.w4,
            w3: m.low.w5,
            w4: m.high.w1,
            w5: m.high.w6,
            w6: m.high.w7,
            w7: m.high.w0
        }
    }
}

function blakeCompress(
    cv: borrow BlakeCv,
    message: borrow BlakeBlock,
    counter: U64,
    length: U32,
    flags: U32
) -> BlakeCv {
    let iv = initialCv()
    var state = BlakeBlock {
        low: cv,
        high: BlakeCv {
            w0: iv.w0,
            w1: iv.w1,
            w2: iv.w2,
            w3: iv.w3,
            w4: U32(counter & U64(0xffffffff)),
            w5: U32(counter >> U64(32)),
            w6: length,
            w7: flags
        }
    }
    var schedule = BlakeBlock { low: message.low, high: message.high }
    for round in 0..7 {
        state = blakeRound(state, schedule)
        if round < 6 { schedule = permuteMessage(schedule) }
    }
    return BlakeCv {
        w0: state.low.w0 ^ state.high.w0,
        w1: state.low.w1 ^ state.high.w1,
        w2: state.low.w2 ^ state.high.w2,
        w3: state.low.w3 ^ state.high.w3,
        w4: state.low.w4 ^ state.high.w4,
        w5: state.low.w5 ^ state.high.w5,
        w6: state.low.w6 ^ state.high.w6,
        w7: state.low.w7 ^ state.high.w7
    }
}
