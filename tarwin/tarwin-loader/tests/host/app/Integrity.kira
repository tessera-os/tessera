import TarwinLoader

// BLAKE3 1.8.2 test_vectors/test_vectors.json, unkeyed hash, first 32
// bytes. Input byte at offset i = i % 251. Expected roots are independent
// of both the compressor and proof builder.
function vectorWord(at: U64, end: U64, corrupt: Bool) -> U32 {
    var result: U32 = 0
    for byte in 0..4 {
        let pos = at + U64(byte)
        if pos < end {
            var v = U32(pos % U64(251))
            if corrupt && pos == U64(33) { v = v ^ U32(1) }
            result = result | (v << U32(byte * 8))
        }
    }
    return result
}

function vectorWords(at: U64, end: U64, corrupt: Bool) -> BlakeCv {
    return BlakeCv {
        w0: vectorWord(at + U64(0), end, corrupt),
        w1: vectorWord(at + U64(4), end, corrupt),
        w2: vectorWord(at + U64(8), end, corrupt),
        w3: vectorWord(at + U64(12), end, corrupt),
        w4: vectorWord(at + U64(16), end, corrupt),
        w5: vectorWord(at + U64(20), end, corrupt),
        w6: vectorWord(at + U64(24), end, corrupt),
        w7: vectorWord(at + U64(28), end, corrupt)
    }
}

function vectorLeaf(size: U64, index: U64, corrupt: Bool) -> ImageChunkProof {
    var proof = imageChunk(size, index)
    var offset = index * U64(1024)
    var end = offset + U64(1024)
    if size < end { end = size }
    while !proof.hashed && !proof.failed {
        let block = BlakeBlock {
            low: vectorWords(offset, end, corrupt),
            high: vectorWords(offset + U64(32), end, corrupt)
        }
        var len = end - offset
        if len > U64(64) { len = U64(64) }
        if !proof.absorb(block, U32(len)) { return proof }
        offset += len
    }
    return proof
}

function integrityCases() -> Int {
    let r0 = BlakeCv {
        w0: U32(0xb94913af),
        w1: U32(0xa6a1f9f5),
        w2: U32(0xea4d40a0),
        w3: U32(0x49c9dc36),
        w4: U32(0xc925cb9b),
        w5: U32(0xb712c1ad),
        w6: U32(0xca939acc),
        w7: U32(0x62321fe4)
    }
    if !vectorLeaf(U64(0), U64(0), false).verifies(r0) { return 21 }
    let r63 = BlakeCv {
        w0: U32(0xa537bce9),
        w1: U32(0x83adda94),
        w2: U32(0xdf7094be),
        w3: U32(0x98377b7f),
        w4: U32(0x833d7c29),
        w5: U32(0xa80be84c),
        w6: U32(0x76206e5d),
        w7: U32(0x7bdbb727)
    }
    if !vectorLeaf(U64(63), U64(0), false).verifies(r63) { return 22 }
    let r64 = BlakeCv {
        w0: U32(0x4171ed4e),
        w1: U32(0xd45c4aea),
        w2: U32(0x6b6088b7),
        w3: U32(0xe2463fd2),
        w4: U32(0xac9caf12),
        w5: U32(0x7ddcaceb),
        w6: U32(0xc76d4c1f),
        w7: U32(0x981b51f2)
    }
    if !vectorLeaf(U64(64), U64(0), false).verifies(r64) { return 23 }
    let r65 = BlakeCv {
        w0: U32(0xa05f1ede),
        w1: U32(0x6ddf70be),
        w2: U32(0xfdffe82b),
        w3: U32(0xaace990e),
        w4: U32(0xc9e8b68e),
        w5: U32(0xd8f2633a),
        w6: U32(0xcb0ec3d1),
        w7: U32(0xee3d266b)
    }
    if !vectorLeaf(U64(65), U64(0), false).verifies(r65) { return 24 }
    let r1023 = BlakeCv {
        w0: U32(0x70891010),
        w1: U32(0xb93edaee),
        w2: U32(0x14acba32),
        w3: U32(0x16a2c728),
        w4: U32(0x4c920e3b),
        w5: U32(0xb3259e9a),
        w6: U32(0xb272ba5b),
        w7: U32(0x11bd708f)
    }
    if !vectorLeaf(U64(1023), U64(0), false).verifies(r1023) { return 25 }
    let r1024 = BlakeCv {
        w0: U32(0x39472142),
        w1: U32(0x06a495f0),
        w2: U32(0xde83fcf3),
        w3: U32(0x4a7489b8),
        w4: U32(0x31f80dc0),
        w5: U32(0x55aa0dc1),
        w6: U32(0x125d9b18),
        w7: U32(0xf75a851c)
    }
    if !vectorLeaf(U64(1024), U64(0), false).verifies(r1024) { return 26 }
    let size: U64 = 4097
    let root = BlakeCv {
        w0: U32(0xb352409b),
        w1: U32(0xc85f1c8f),
        w2: U32(0x7afff9b1),
        w3: U32(0xd27cb2c7),
        w4: U32(0x3d7b4842),
        w5: U32(0xc9150d89),
        w6: U32(0xb8251c6a),
        w7: U32(0x95b90faa)
    }
    var a = vectorLeaf(size, U64(0), false)
    var b = vectorLeaf(size, U64(1), false)
    var c = vectorLeaf(size, U64(2), false)
    var d = vectorLeaf(size, U64(3), false)
    var e = vectorLeaf(size, U64(4), false)
    let acv = a.chain
    let bcv = b.chain
    let ccv = c.chain
    let dcv = d.chain
    let ecv = e.chain
    let ab = imageParentCv(acv, bcv)
    let cd = imageParentCv(ccv, dcv)
    let left = imageParentCv(ab, cd)
    if !checkPinned(root, left) { return 45 }
    if !a.sibling(bcv) || !a.sibling(cd) || a.verifies(root) || !a.sibling(ecv) { return 27 }
    if !b.sibling(acv) || !b.sibling(cd) || !b.sibling(ecv) { return 28 }
    if !c.sibling(dcv) || !c.sibling(ab) || !c.sibling(ecv) { return 29 }
    if !d.sibling(ccv) || !d.sibling(ab) || !d.sibling(ecv) { return 30 }
    if !e.sibling(left) || !e.verifies(root) { return 31 }
    var first = pageIntegrity(size, U64(0), U64(4096), root)
    if !first.accept(a) || !first.accept(b) || !first.accept(c) || first.verified() { return 32 }
    if !first.accept(d) || !first.verified() { return 33 }
    var last = pageIntegrity(size, U64(4096), U64(4096), root)
    if !last.accept(e) || !last.verified() { return 34 }
    var large = pageIntegrity(size, U64(0), U64(16384), root)
    if !large.accept(a) || !large.accept(b) || !large.accept(c) || !large.accept(
        d
    ) || large.verified() { return 35 }
    if !large.accept(e) || !large.verified() { return 36 }
    var wrong = pageIntegrity(size, U64(0), U64(4096), root)
    if wrong.accept(b) || wrong.accept(a) || wrong.verified() { return 37 }
    var changed = vectorLeaf(size, U64(0), true)
    if !changed.sibling(bcv) || !changed.sibling(cd) || !changed.sibling(ecv) || changed.verifies(
        root
    ) { return 38 }
    if e.sibling(left) || e.verifies(root) { return 39 }
    var badLength = imageChunk(U64(63), U64(0))
    let msg = BlakeBlock { low: acv, high: bcv }
    if badLength.absorb(msg, U32(64)) || badLength.absorb(msg, U32(63)) { return 40 }
    if !imageChunk(size, U64(5)).failed || !pageIntegrity(size, U64(1), U64(4096), root).failed {
        return 41
    }
    let fullRoot = BlakeCv {
        w0: U32(0x64d675f8),
        w1: U32(0x8589e26d),
        w2: U32(0xee346f64),
        w3: U32(0x579abe13),
        w4: U32(0xf715d56f),
        w5: U32(0x260a5b6b),
        w6: U32(0x354732bb),
        w7: U32(0xe4dd1d04)
    }
    var full = pageIntegrity(U64(16384), U64(0), U64(16384), fullRoot)
    for i in 0..16 {
        var leaf = vectorLeaf(U64(16384), U64(i), false)
        var span: U64 = 1
        for height in 0..4 {
            let neighbor = ((U64(i) / span) ^ U64(1)) * span
            if !leaf.sibling(vectorSubtree(neighbor, span)) { return 42 }
            span *= U64(2)
        }
        if !full.accept(leaf) { return 43 }
    }
    if !full.verified() { return 44 }
    return 0
}

// Test-side proof builder, bounded to three internal levels.
function vectorSubtree(start: U64, count: U64) -> BlakeCv {
    if count == U64(1) { return vectorLeaf(U64(16384), start, false).chain }
    let half = count / U64(2)
    return imageParentCv(vectorSubtree(start, half), vectorSubtree(start + half, half))
}
