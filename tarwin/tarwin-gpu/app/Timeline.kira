public enum WaitResult { Denied Ready Queued Full Duplicate }
public struct FenceWait {
    let key: U64
    let target: U64
    let priority: U32
}

// Serialized by the fence lock. Callbacks publish/enqueue only; they must
// not block or re-enter the same fence. Rights come from a resolved handle.
public struct GpuTimeline {
    var value: U64 = 0
    let waitLimit: Int
    var count: Int = 0
    var waiters: [FenceWait] = []

    function inheritedPriority(borrow self) -> U32 {
        var best: U32 = 0
        for i in 0..count {
            if waiters[i].priority > best { best = waiters[i].priority }
        }
        return best
    }

    function waitFor(borrow mut self, canWait: Bool, w: FenceWait,
                     inherit: borrow (U32) -> Void) -> WaitResult {
        if !canWait { return .Denied }
        if w.target <= value { return .Ready }
        for i in 0..count { if waiters[i].key == w.key { return .Duplicate } }
        if count >= waitLimit { return .Full }
        if count == waiters.count { waiters.append(move w) } else { waiters[count] = move w }
        count += 1
        inherit(inheritedPriority())
        return .Queued
    }

    function cancel(borrow mut self, key: U64, inherit: borrow (U32) -> Void) -> Bool {
        for i in 0..count {
            if waiters[i].key == key {
                count -= 1
                waiters[i] = waiters[count]
                inherit(inheritedPriority())
                return true
            }
        }
        return false
    }

    function advance(borrow mut self, canSignal: Bool, target: U64,
                     publishRelease: borrow (U64) -> Void,
                     wake: borrow (U64) -> Void, inherit: borrow (U32) -> Void) -> Bool {
        if !canSignal || target < value { return false }
        if target == value { return true }
        publishRelease(target)
        value = target
        var live: Int = 0
        for i in 0..count {
            let w = waiters[i]
            if w.target <= target { wake(w.key) } else {
                waiters[live] = w
                live += 1
            }
        }
        count = live
        inherit(inheritedPriority())
        return true
    }
}
