import Foundation

@Test
function signalPublishesBeforeWakeAndDropsDonation() {
    var t = GpuTimeline { waitLimit: 2 }
    var boost: U32 = 0
    var visible: U64 = 0
    var woke: U64 = 0
    let donate: (U32) -> Void = { p in boost = p }
    let publish: (U64) -> Void = { v in visible = v }
    let wake: (U64) -> Void = { key in if visible >= 3 { woke = key } }
    expect!((t.waitFor(false, FenceWait { key: 5, target: 3, priority: 5 }, donate) == WaitResult.Denied))
    expect!((t.waitFor(true, FenceWait { key: 5, target: 3, priority: 5 }, donate) == WaitResult.Queued))
    expect!((t.waitFor(true, FenceWait { key: 7, target: 9, priority: 1 }, donate) == WaitResult.Queued))
    expect!((boost == 5))
    expect!(!t.advance(false, 3, publish, wake, donate))
    expect!(t.advance(true, 3, publish, wake, donate))
    expect!((woke == 5 && boost == 1 && t.count == 1))
    expect!(!t.advance(true, 1, publish, wake, donate))
    expect!(t.cancel(7, donate))
    expect!((boost == 0 && visible == 3))
}

@Test
function doorbellRefusesNonPageRangesAndRevokedSlots() {
    let ok: (U64,U64,U64,U64) -> Bool = { p,o,b,e in return p == 2 && o == 16384 && b == 16384 && e == 7 }
    let g = DoorbellGrant { process: 2, page: 16384, slotEpoch: 7 }
    expect!(grantDoorbell(32768, 16384, [16384], g, 7, ok))
    expect!(!grantDoorbell(32767, 16384, [16384], g, 7, ok))
    expect!(!grantDoorbell(32768, 16384, [0], g, 7, ok))
    expect!(!grantDoorbell(32768, 16384, [16384], g, 8, ok))
}
