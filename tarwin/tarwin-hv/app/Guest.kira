// §23. Policy inputs come from kernel-owned objects and the intersection of host CPU capabilities.
public enum HvError { None AccessDenied FeatureUnavailable Invalid Limit Busy WrongThread }

public struct GuestCapabilities {
    let stageTwo: Bool
    let interruptController: Bool
    let architecturalTimer: Bool
    let nested: Bool
    let confidential: Bool
    let attestation: Bool
    let nestedConfidential: Bool
    let addressBits: U64
    let cpuFeatures: U64
}

public function admitGuest(host: borrow GuestCapabilities, bits: U64, features: U64, nested: Bool,
                          confidential: Bool, hasEntitlement: Bool, hasResource: Bool,
                          liveMachines: U64) -> HvError {
    if !hasEntitlement && !hasResource { return .AccessDenied }
    if liveMachines >= 64 { return .Limit }
    if bits == 0 || bits > 63 { return .Invalid }
    if !host.stageTwo || !host.interruptController || !host.architecturalTimer
        || bits > host.addressBits || (features & host.cpuFeatures) != features
        || (nested && !host.nested) || (confidential && (!host.confidential || !host.attestation))
        || (nested && confidential && !host.nestedConfidential) { return .FeatureUnavailable }
    return .None
}

public function admitAssignment(hasResource: Bool, hasSlotGrant: Bool, nestedDma: Bool,
                                postedInterrupts: Bool, isolatedMmio: Bool) -> HvError {
    if !hasResource && !hasSlotGrant { return .AccessDenied }
    if !nestedDma || !postedInterrupts || !isolatedMmio { return .FeatureUnavailable }
    return .None
}

// Subtraction-based half-open range checks; no wrapped end address or rounded partial page.
public function validGuestRange(base: U64, length: U64, limit: U64, page: U64) -> Bool {
    if (page != 4096 && page != 16384) || length == 0 || base > limit { return false }
    return base % page == 0 && length % page == 0 && length <= limit - base
}

public function validMapping(guest: U64, offset: U64, length: U64, guestLimit: U64,
                             memorySize: U64, page: U64, requested: U64, allowed: U64) -> Bool {
    return requested != 0 && requested <= 7 && (requested & allowed) == requested
        && validGuestRange(guest, length, guestLimit, page)
        && validGuestRange(offset, length, memorySize, page)
}

public function overlapsGuest(a: U64, sizeA: U64, b: U64, sizeB: U64) -> Bool {
    if sizeA == 0 || sizeB == 0 { return false }
    if a <= b { return b - a < sizeA }
    return a - b < sizeB
}

// Fold a write-trap or hardware dirty interval into one word of the GPA-indexed dirty bitmap.
public function dirtyWord(firstPage: U64, dirtyFirst: U64, dirtyCount: U64) -> U64 {
    var result: U64 = 0
    var bit: U64 = 0
    while bit < 64 && bit <= 0xffffffffffffffff - firstPage {
        let page = firstPage + bit
        if page >= dirtyFirst && page - dirtyFirst < dirtyCount { result = result | (U64(1) << bit) }
        bit += 1
    }
    return result
}

public enum GuestExit { Mmio PortIo Hypercall SystemRegister Wait Exception Debug Shutdown Reset Canceled }
public enum RunAction { Enter Cancel Deny Busy }
public struct VirtualCpuState {
    let creator: U64
    var running: Bool
    var exitRequested: Bool

    // The vCPU lock serializes these transitions with kicking the CPU on which it was published.
    function begin(borrow mut self, thread: U64) -> RunAction {
        if thread != creator { return .Deny }
        if running { return .Busy }
        if exitRequested { exitRequested = false return .Cancel }
        running = true
        return .Enter
    }
    function requestExit(borrow mut self) -> Bool {
        exitRequested = true
        return running
    }
    function finish(borrow mut self, reason: GuestExit) -> GuestExit {
        running = false
        if exitRequested { exitRequested = false return .Canceled }
        return reason
    }
}

public function admitVcpu(index: U64, present: Bool, count: U64, hostCount: U64) -> HvError {
    if index >= 512 || count >= 512 || count >= hostCount { return .Limit }
    if present { return .Busy }
    return .None
}
