import Foundation

@Test
function discardChecksFeatureCapacityAndDeviceLimitsBeforeDma() {
    var q = SplitQueue {}
    expect!(q.initialize(4))
    let limits = BlockRangeLimits { capacity: 101, sectors: 16, segments: 1, alignment: 4, mayUnmap: false }
    let p = BlockPacket { op: .Discard, sector: 96, bytes: 16, header: 1024, data: 2048, status: 4096 }
    var request: U32 = 0
    let header: (U64,U32,U64) -> Void = { a,k,s in request = k }
    let range: (U64,U64,U32,U32) -> Void = { a,s,n,f in expect!((s == 96 && n == 5 && f == 0)) }
    let status: (U64,U8) -> Void = { a,s in }
    let desc: (Int,U64,U32,U16,U16) -> Void = { i,a,n,f,l in }
    let avail: (Int,U16) -> Void = { i,h in }
    let publish: (U16) -> Void = { i in }
    expect!(!submitRange(q,1,p,6,false,limits,8192,header,range,status,desc,avail,publish))
    expect!(!submitRange(q,1,p,5,true,limits,8192,header,range,status,desc,avail,publish))
    expect!(!submitRange(q,1,p,5,false,limits,0,header,range,status,desc,avail,publish))
    expect!((request == 0))
    expect!(submitRange(q,1,p,5,false,limits,8192,header,range,status,desc,avail,publish))
    expect!((request == 11))
}
