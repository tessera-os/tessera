import Foundation

@Test
function virtioNetNoOffloadBuffersAreBoundedAndDirectionSpecific() {
    var q = SplitQueue {}
    expect!(q.initialize(4))
    var flags: U16 = 0
    var cleared: U32 = 0
    let p = NetPacket { header: 0x1000, frame: 0x2000, bytes: 1518 }
    let clear: (U64,U32) -> Void = { h,n in cleared = n }
    let desc: (Int,U64,U32,U16,U16) -> Void = { i,a,n,f,l in flags = (flags << 4) | f }
    expect!(submitFrame(q,2,p,true,1518,clear,desc,{ i,h in },{ idx in }))
    expect!((cleared == 12 && flags == 0x32))
    expect!((frameResult(true,1518,26,0,0) == FrameResult.Received(14)))
    expect!((frameResult(true,1518,1531,0,0) == FrameResult.Invalid))
    expect!((frameResult(true,1518,26,1,0) == FrameResult.Invalid))
    expect!((frameResult(false,1518,0,0,0) == FrameResult.Sent))
    flags = 0
    expect!(submitFrame(q,3,p,false,1518,clear,desc,{ i,h in },{ idx in }))
    expect!((flags == 0x10))
}
