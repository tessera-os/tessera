import Foundation

@Test
function chainsArePublishedInOrderAndReleasedByPrivateOwnership() {
    var q = SplitQueue {}
    expect!(!q.initialize(3))
    expect!(q.initialize(4))
    q.published = 65535
    q.consumed = 65535
    let parts = [Segment { iova: 0x1000, length: 16, deviceWrites: false },
                 Segment { iova: 0x2000, length: 1, deviceWrites: true }]
    var sequence: Int = 0
    let descriptor: (Int,U64,U32,U16,U16) -> Void = { slot,a,n,flags,next in
        if slot == 0 && a == 4096 && n == 16 && flags == 1 && next == 1 { sequence = 1 }
        if slot == 1 && flags == 2 && sequence == 1 { sequence = 2 }
    }
    let avail: (Int,U16) -> Void = { i, head in if sequence == 2 && i == 3 && head == 0 { sequence = 3 } }
    let release: (U16) -> Void = { idx in if sequence == 3 && idx == 0 { sequence = 4 } }
    expect!(q.submit(77, parts, descriptor, avail, release))
    expect!((sequence == 4))
    match q.consume({ in return 0 }, { i in return 0 }, { i in return 1 }) {
        Completed(result) -> { expect!((result.cookie == 77 && result.written == 1)) }
        Empty -> { expect!(false) }
        Broken -> { expect!(false) }
    }
    expect!((q.outstanding == 0 && q.consumed == 0))
    expect!((q.consume({ in return 1 }, { i in return 0 }, { i in return 0 }) == UsedResult.Broken))
}

@Test
function deniesIdentityDmaAndUnimplementedRingFeatures() {
    expect!((isolatedSplitFeatures(0x100000000, 1) == 0))
    expect!((isolatedSplitFeatures(0xffffffffffffffff, 3) == 0x300000003))
}
