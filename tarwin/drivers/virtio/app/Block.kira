public enum GuestBlockOp { Read Write Flush Discard WriteZeroes }
public enum GuestBlockResult { Ok MediaError Unsupported ProtocolError }
public struct BlockPacket {
    let op: GuestBlockOp
    let sector: U64
    let bytes: U32
    let header: U64
    let data: U64
    let status: U64
}

public function submitBlock(queue: borrow mut SplitQueue, cookie: U64, p: borrow BlockPacket,
                            capacitySectors: U64, features: U64,
                            storeHeader: borrow (U64,U32,U64) -> Void,
                            setStatus: borrow (U64,U8) -> Void,
                            descriptor: borrow (Int,U64,U32,U16,U16) -> Void,
                            putAvailable: borrow (Int,U16) -> Void,
                            releaseAvailable: borrow (U16) -> Void) -> Bool {
    // The caller reserves independent, exclusive header, data and status
    // DMA spans lasting through completion. storeHeader writes the reserved
    // word as zero and type/sector little-endian.
    let write = p.op != .Read && p.op != .Flush
    if write && (features & 32) != 0 { return false }
    var kind: U32 = 0
    if p.op == .Read || p.op == .Write {
        if p.bytes == 0 || p.bytes % 512 != 0 || p.sector >= capacitySectors ||
            U64(p.bytes / 512) > capacitySectors - p.sector { return false }
        if write { kind = 1 }
    } else if p.op == .Flush {
        if (features & 512) == 0 || p.bytes != 0 || p.sector != 0 { return false }
        kind = 4
    } else {
        // Range-list requests require validated, device-limited range
        // records. Do not dispatch arbitrary buffers as discard ranges.
        return false
    }
    if !validArea(p.header,16,1) || !distinctAreas(p.header,16,p.status,1) { return false }
    var segments = [Segment { iova: p.header, length: 16, deviceWrites: false }]
    if p.bytes != 0 {
        if !validArea(p.data,U64(p.bytes),1) || !distinctAreas(p.header,16,p.data,U64(p.bytes)) ||
            !distinctAreas(p.data,U64(p.bytes),p.status,1) { return false }
        segments.append(Segment { iova: p.data, length: p.bytes, deviceWrites: !write })
    }
    segments.append(Segment { iova: p.status, length: 1, deviceWrites: true })
    storeHeader(p.header,kind,p.sector)
    setStatus(p.status,255)
    return queue.submit(cookie,segments,descriptor,putAvailable,releaseAvailable)
}

public function blockCompletion(status: U8, op: GuestBlockOp, dataBytes: U32, written: U32) -> GuestBlockResult {
    if written == 0 { return .ProtocolError }
    if status == 0 && (op == .Read ? written - 1 != dataBytes : written != 1) { return .ProtocolError }
    return match status {
        0 -> .Ok
        1 -> .MediaError
        2 -> .Unsupported
        else -> .ProtocolError
    }
}
