// Virtio 1.2 modern MMIO transport. DeviceKit supplies ordered I/O register
// accesses and IOVAs already mapped into this device's isolated DMA domain.
public struct QueueMemory {
    let count: U32
    let descriptors: U64
    let available: U64
    let used: U64
}

function validArea(addr: U64, bytes: U64, alignment: U64) -> Bool {
    return addr % alignment == 0 && bytes > 0 && bytes - 1 <= 0xffffffffffffffff - addr
}

public enum MmioFeatures { Unavailable Negotiated(U64) }
public function negotiateMmio(deviceId: U32, deviceBits: U32,
                             read: borrow (U32) -> U32, write: borrow (U32, U32) -> Void,
                             resetTimedOut: borrow () -> Bool) -> MmioFeatures {
    if deviceId == 0 || read(0) != 0x74726976 || read(4) != 2 || read(8) != deviceId {
        return .Unavailable
    }
    write(0x70, 0)
    while read(0x70) != 0 { if resetTimedOut() { return .Unavailable } }
    write(0x70, 1)
    write(0x70, 3)
    write(0x14, 0)
    let low = read(0x10)
    write(0x14, 1)
    let high = read(0x10)
    let features = isolatedSplitFeatures((U64(high) << 32) | U64(low), deviceBits)
    if features == 0 { write(0x70, 0x83)
        return .Unavailable }
    write(0x24, 0)
    write(0x20, U32(features & 0xffffffff))
    write(0x24, 1)
    write(0x20, U32(features >> 32))
    write(0x70, 11)
    if read(0x70) != 11 { write(0x70, read(0x70) | 0x80)
        return .Unavailable }
    return .Negotiated(features)
}

function addressPair(reg: U32, addr: U64, write: borrow (U32, U32) -> Void) {
    write(reg, U32(addr & 0xffffffff))
    write(reg + 4, U32(addr >> 32))
}

function distinctAreas(a: U64, aBytes: U64, b: U64, bBytes: U64) -> Bool {
    if a <= b { return b - a >= aBytes }
    return a - b >= bBytes
}

function splitMemoryValid(memory: borrow QueueMemory) -> Bool {
    let count = U64(memory.count)
    if count < 1 || count > 32768 || (count & (count - 1)) != 0 { return false }
    let d = count * 16
    let a = 6 + count * 2
    let u = 6 + count * 8
    if !validArea(memory.descriptors, d, 16) || !validArea(memory.available, a, 2) ||
        !validArea(memory.used, u, 4) || !distinctAreas(memory.descriptors, d, memory.available, a) ||
        !distinctAreas(memory.descriptors, d, memory.used, u) ||
        !distinctAreas(memory.available, a, memory.used, u) { return false }
    return true
}

public function installSplitQueue(index: U32, memory: borrow QueueMemory,
                                  read: borrow (U32) -> U32, write: borrow (U32,U32) -> Void) -> Bool {
    if !splitMemoryValid(memory) || read(0x70) != 11 { return false }
    write(0x30, index)
    if read(0x44) != 0 || read(0x34) < memory.count { return false }
    write(0x38, memory.count)
    addressPair(0x80, memory.descriptors, write)
    addressPair(0x90, memory.available, write)
    addressPair(0xa0, memory.used, write)
    write(0x44, 1)
    return read(0x44) == 1
}

public function driverReady(read: borrow (U32) -> U32, write: borrow (U32,U32) -> Void) -> Bool {
    if read(0x70) != 11 { return false }
    write(0x70, 15)
    return read(0x70) == 15
}
