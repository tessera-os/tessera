// Modern single-buffer virtio-net. No merge, checksum/segmentation offload,
// HASH_REPORT, or GUEST_HDRLEN; the virtio 1.x base header is twelve bytes.
public struct NetPacket {
    let header: U64
    let frame: U64
    let bytes: U32
}

public function submitFrame(queue: borrow mut SplitQueue, cookie: U64, packet: borrow NetPacket,
                            receive: Bool, maximumFrame: U32, clearHeader: borrow (U64,U32) -> Void,
                            descriptor: borrow (Int,U64,U32,U16,U16) -> Void,
                            putAvailable: borrow (Int,U16) -> Void,
                            releaseAvailable: borrow (U16) -> Void) -> Bool {
    if packet.bytes < 14 || packet.bytes > maximumFrame || (receive && packet.bytes < maximumFrame) ||
        maximumFrame > 65553 || !validArea(packet.header,12,1) ||
        !validArea(packet.frame,U64(packet.bytes),1) ||
        !distinctAreas(packet.header,12,packet.frame,U64(packet.bytes)) { return false }
    let parts = [Segment { iova: packet.header, length: 12, deviceWrites: receive },
                 Segment { iova: packet.frame, length: packet.bytes, deviceWrites: receive }]
    clearHeader(packet.header,12)
    return queue.submit(cookie,parts,descriptor,putAvailable,releaseAvailable)
}

public enum FrameResult { Invalid Sent Received(U32) }
public function frameResult(receive: Bool, capacity: U32, written: U32, flags: U8, gso: U8) -> FrameResult {
    if !receive { return written == 0 ? FrameResult.Sent : FrameResult.Invalid }
    if written < 26 || written - 12 > capacity || flags != 0 || gso != 0 { return .Invalid }
    return .Received(written - 12)
}
