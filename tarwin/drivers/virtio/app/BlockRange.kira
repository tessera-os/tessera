public struct BlockRangeLimits {
    let capacity: U64
    let sectors: U32
    let segments: U32
    let alignment: U32
    let mayUnmap: Bool
}

// A single checked range; the caller owns the three exclusive DMA buffers
// through completion. Split larger requests to obey the device config.
public function submitRange(queue: borrow mut SplitQueue, cookie: U64, p: borrow BlockPacket,
                            sectors: U32, unmap: Bool, limits: borrow BlockRangeLimits, features: U64,
                            storeHeader: borrow (U64,U32,U64) -> Void,
                            storeRange: borrow (U64,U64,U32,U32) -> Void, setStatus: borrow (U64,U8) -> Void,
                            descriptor: borrow (Int,U64,U32,U16,U16) -> Void,
                            putAvailable: borrow (Int,U16) -> Void, releaseAvailable: borrow (U16) -> Void) -> Bool {
    let zeroes = p.op == .WriteZeroes
    if !zeroes && p.op != .Discard { return false }
    let required: U64 = zeroes ? 0x4000 : 0x2000
    if (features & 32) != 0 || (features & required) == 0 || p.bytes != 16 || limits.segments == 0 ||
        sectors == 0 || sectors > limits.sectors || p.sector >= limits.capacity ||
        U64(sectors) > limits.capacity - p.sector || (unmap && (!zeroes || !limits.mayUnmap)) ||
        (!zeroes && limits.alignment > 1 && p.sector % U64(limits.alignment) != 0) { return false }
    if !validArea(p.header,16,1) || !validArea(p.data,16,1) || !distinctAreas(p.header,16,p.data,16) ||
        !distinctAreas(p.header,16,p.status,1) || !distinctAreas(p.data,16,p.status,1) { return false }
    let parts = [Segment { iova: p.header, length: 16, deviceWrites: false },
                 Segment { iova: p.data, length: 16, deviceWrites: false },
                 Segment { iova: p.status, length: 1, deviceWrites: true }]
    storeHeader(p.header,zeroes ? 13 : 11,0)
    storeRange(p.data,p.sector,sectors,unmap ? 1 : 0)
    setStatus(p.status,255)
    return queue.submit(cookie,parts,descriptor,putAvailable,releaseAvailable)
}
