import TarwinSched

function key(qos: U8, id: U64) -> DispatchKey {
    return DispatchKey { qos: qos, readySince: U64(10), virtualStart: U64(5),
        classVirtualTime: U64(5), virtualDeadline: U64(10), absoluteDeadline: U64(80),
        remainingBudget: U64(2), threadId: id }
}

@Main
function main() -> Int {
    if reservationPpb(U64(9), U64(10), U64(9)) != U64(900000000) { return 1 }
    if reservationPpb(U64(1), U64(3), U64(1)) != U64(333333334) { return 2 }
    if reservationPpb(U64(18446744073709551614), U64(18446744073709551615), U64(18446744073709551614)) != U64(1000000000) { return 3 }
    if reservationPpb(U64(0), U64(0), U64(0)) != U64(0) { return 4 }
    if !canAdmit(U64(100000000), U64(800000000), U64(1000000000), U64(0), U64(100000000), true) { return 5 }
    if canAdmit(U64(100000001), U64(800000000), U64(1000000000), U64(0), U64(100000001), true) { return 6 }
    if canAdmit(U64(1), U64(0), U64(1000000000), U64(1), U64(1), true) { return 7 }
    if canAdmit(U64(1), U64(0), U64(1000000000), U64(0), U64(1), false) { return 8 }
    var budget = PeriodBudget { release: U64(0), remaining: U64(2), period: U64(10), capacity: U64(2) }
    budget.charge(U64(4))
    budget.replenish(U64(9))
    if budget.remaining != U64(0) { return 9 }
    budget.replenish(U64(25))
    if budget.release != U64(20) || budget.remaining != U64(2) { return 10 }
    let normal = key(SchedClass.normal, U64(1))
    let interactive = key(SchedClass.interactive, U64(2))
    let deadline = key(SchedClass.deadline, U64(3))
    if !dispatchBefore(interactive, normal, U64(100000009)) { return 11 }
    if !dispatchBefore(normal, interactive, U64(100000010)) { return 12 }
    if dispatchBefore(normal, deadline, U64(100000010)) { return 13 }
    if virtualSlice(U64(3000000), 0) != U64(3000000) { return 14 }
    if virtualSlice(U64(3000000), -16) <= virtualSlice(U64(3000000), 15) { return 15 }
    let cpu = CpuOffer { online: true, features: U64(5), capacity: U32(10), energy: U32(3),
        load: U32(2), efficiency: false, idle: false, thermalHeadroom: true,
        runningSiblingJob: U64(7), isolatedSiblings: true }
    if !cpuEligible(cpu, U64(1), U64(7), SchedClass.interactive, U32(10), true) { return 16 }
    if cpuEligible(cpu, U64(2), U64(7), SchedClass.interactive, U32(10), true) { return 17 }
    if cpuEligible(cpu, U64(1), U64(8), SchedClass.interactive, U32(10), true) { return 18 }
    if cpuEligible(cpu, U64(1), U64(7), SchedClass.background, U32(10), true) { return 19 }
    if cpuEligible(cpu, U64(1), U64(7), SchedClass.utility, U32(10), true) { return 20 }
    if cpuEligible(cpu, U64(1), U64(7), SchedClass.normal, U32(11), false) { return 21 }
    return 0
}
