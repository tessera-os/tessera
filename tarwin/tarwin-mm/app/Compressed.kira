import KCore

// Raw LZ4 blocks, without an embedded size. The pager supplies private,
// non-overlapping buffers and the authenticated logical size (page + tags).
// Scratch is a per-operation 4096-entry dictionary; no allocation or sleep.
// On failure output is unpublished and must be discarded.
public trait MatchTable {
    function clear(borrow mut self)
    function previous(borrow self, bucket: U16) -> U16
    function record(borrow mut self, bucket: U16, positionPlusOne: U16)
}

public struct BlockSize {
    var ok: Bool
    var count: U64
}

function noBlock() -> BlockSize { return BlockSize { ok: false, count: 0 } }

function wordAt<S: ByteSource>(input: borrow S, p: U64) -> U64 {
    return U64(input.byteAt(p)) | (U64(input.byteAt(p + 1)) << 8) |
        (U64(input.byteAt(p + 2)) << 16) | (U64(input.byteAt(p + 3)) << 24)
}

function emitLength<D: ByteBuffer>(output: borrow mut D, cursor: borrow mut U64, n: U64) {
    var extra = n - 15
    while extra >= 255 {
        output.putByte(cursor, 255)
        cursor += 1
        extra -= 255
    }
    output.putByte(cursor, U8(extra))
    cursor += 1
}

function extBytes(n: U64) -> U64 {
    if n < 15 { return 0 }
    return (n - 15) / 255 + 1
}

function sequence<S: ByteSource, D: ByteBuffer>(input: borrow S, output: borrow mut D, cursor: borrow mut U64,
    literalAt: U64, literals: U64, distance: U64, matched: U64) -> Bool {
    let code = distance == 0 ? U64(0) : matched - 4
    var need = 1 + extBytes(literals) + literals
    if distance != 0 { need += 2 + extBytes(code) }
    if need > output.byteCount() - cursor { return false }
    let hi = literals < 15 ? literals : U64(15)
    let lo = code < 15 ? code : U64(15)
    output.putByte(cursor, U8(hi * 16 + lo))
    cursor += 1
    if literals >= 15 { emitLength(output, cursor, literals) }
    var i: U64 = 0
    while i < literals {
        output.putByte(cursor, input.byteAt(literalAt + i))
        cursor += 1
        i += 1
    }
    if distance != 0 {
        output.putByte(cursor, U8(distance & 255))
        output.putByte(cursor + 1, U8(distance >> 8))
        cursor += 2
        if code >= 15 { emitLength(output, cursor, code) }
    }
    return true
}

public function compressPage<S: ByteSource, D: ByteBuffer, H: MatchTable>(input: borrow S, output: borrow mut D, table: borrow mut H) -> BlockSize {
    let size = input.byteCount()
    if size == 0 || size > 32768 { return noBlock() }
    table.clear()
    var anchor: U64 = 0
    var p: U64 = 0
    var written: U64 = 0
    while size - p >= 12 {
        let word = wordAt(input, p)
        let bucket = U16(((word * 2654435761) >> 20) & 4095)
        let saved = U64(table.previous(bucket))
        table.record(bucket, U16(p + 1))
        if saved == 0 || saved > p || wordAt(input, saved - 1) != word {
            p += 1
        } else {
            let source = saved - 1
            var matched: U64 = 4
            while matched < size - p - 5 && input.byteAt(source + matched) == input.byteAt(p + matched) { matched += 1 }
            if !sequence(input, output, written, anchor, p - anchor, p - source, matched) { return noBlock() }
            p += matched
            anchor = p
        }
    }
    if !sequence(input, output, written, anchor, size - anchor, 0, 0) { return noBlock() }
    return BlockSize { ok: true, count: written }
}

function parseLength<S: ByteSource>(input: borrow S, end: U64, pos: borrow mut U64, nibble: U64) -> BlockSize {
    var n = nibble
    if n == 15 {
        while true {
            if pos == end { return noBlock() }
            let extra = U64(input.byteAt(pos))
            pos += 1
            n += extra
            if n > 32768 { return noBlock() }
            if extra != 255 { break }
        }
    }
    return BlockSize { ok: true, count: n }
}

public function decompressPage<S: ByteSource, D: ByteBuffer>(input: borrow S, stored: U64, output: borrow mut D, logical: U64) -> Bool {
    if logical == 0 || logical > 32768 || logical > output.byteCount() || stored == 0 || stored > input.byteCount() || stored > logical + logical / 255 + 16 { return false }
    var pos: U64 = 0
    var written: U64 = 0
    while pos < stored {
        let token = input.byteAt(pos)
        pos += 1
        let literal = parseLength(input, stored, pos, U64(token >> 4))
        if !literal.ok || literal.count > stored - pos || literal.count > logical - written { return false }
        var i: U64 = 0
        while i < literal.count {
            output.putByte(written, input.byteAt(pos))
            pos += 1
            written += 1
            i += 1
        }
        if pos == stored { return written == logical }
        if stored - pos < 2 { return false }
        let distance = U64(input.byteAt(pos)) | (U64(input.byteAt(pos + 1)) << 8)
        pos += 2
        if distance == 0 || distance > written { return false }
        let length = parseLength(input, stored, pos, U64(token & 15))
        if !length.ok || length.count + 4 > logical - written { return false }
        i = 0
        while i < length.count + 4 {
            let byte = output.byteAt(written - distance)
            output.putByte(written, byte)
            written += 1
            i += 1
        }
    }
    return false
}
