// Resource accounting saturates rather than wrapping below the limit.
// The caller takes a consistent snapshot under the job accounting lock.
function addCharge(a: U64, b: U64) -> U64 {
    if b > U64(0xffffffffffffffff) - a { return 0xffffffffffffffff }
    return a + b
}

public function footprint(residentPrivate: U64, compressedStored: U64, gpu: U64, kernel: U64) -> U64 {
    return addCharge(addCharge(residentPrivate, compressedStored), addCharge(gpu, kernel))
}

// Band 0 = system-critical; 1 foreground, 2 visible, 3 audio/media,
// 4 background, 5 suspended, 6 cached. koid zero denotes no candidate.
public struct PressureCandidate {
    var koid: U64
    var band: U8
    var bytes: U64
}

public function noCandidate() -> PressureCandidate { return PressureCandidate { koid: 0, band: 0, bytes: 0 } }

// Run only after reclamation fails. A caller finding no eligible process
// diagnoses the configuration instead of killing a system-critical service.
public function selectVictim(best: PressureCandidate, next: PressureCandidate) -> PressureCandidate {
    if next.koid == 0 || next.band == 0 || next.band > 6 { return best }
    if best.koid == 0 || next.band > best.band { return next }
    if next.band == best.band && (next.bytes > best.bytes || (next.bytes == best.bytes && next.koid < best.koid)) { return next }
    return best
}

public function exceedsFootprint(band: U8, bytes: U64, limit: U64) -> Bool {
    return band > 0 && band <= 6 && bytes > limit
}

// Object-locked purge epoch. noteDiscard is called only after actually
// unmapping and releasing an unpinned volatile page. Multiple losses in
// an epoch cause one "contents lost" at the next nonvolatile transition.
public struct PurgeState {
    var isVolatile: Bool
    var lost: Bool
}

public function makeVolatile(state: borrow mut PurgeState) { state.isVolatile = true }
public function mayDiscard(state: borrow PurgeState, pinCount: U64) -> Bool { return state.isVolatile && pinCount == 0 }
public function noteDiscard(state: borrow mut PurgeState) { if state.isVolatile { state.lost = true } }
public function makeNonvolatile(state: borrow mut PurgeState) -> Bool {
    let survived = !state.lost
    state.isVolatile = false
    state.lost = false
    return survived
}
