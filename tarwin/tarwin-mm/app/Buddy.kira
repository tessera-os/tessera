import KCore

// One aligned 64-page leaf of the physical allocator. Each order-n block
// is the union of two aligned order-(n-1) buddies. Occupancy is stored
// only at the leaves: clearing a block immediately coalesces free buddies.
// A caller serializes access and supplies backing pages from validated RAM.
public struct PageArena {
    var base: U64
    var pageSize: U64
    var usable: U64
    var occupied: U64
    var starts: U64
    var ends: U64
}

public function makeArena(base: U64, pageSize: U64, usable: U64) -> PageArena {
    var eligible = usable
    if (pageSize != 4096 && pageSize != 16384) || !alignedTo(base, pageSize * 64) || !validExtent(base, pageSize * 64) {
        eligible = 0
    }
    return PageArena { base: base, pageSize: pageSize, usable: eligible, occupied: 0, starts: 0, ends: 0 }
}

function pageMask(pages: U64) -> U64 {
    if pages == 64 { return 0xffffffffffffffff }
    return (U64(1) << pages) - 1
}

public struct Allocation {
    var ok: Bool
    var address: U64
}

public function takePages(arena: borrow mut PageArena, order: U8) -> Allocation {
    if order <= 6 {
        let pages = U64(1) << U64(order)
        var index: U64 = 0
        while index < 64 {
            let mask = pageMask(pages) << index
            if (arena.usable & mask) == mask && (arena.occupied & mask) == 0 {
                arena.occupied = arena.occupied | mask
                arena.starts = arena.starts | (U64(1) << index)
                arena.ends = arena.ends | (U64(1) << (index + pages - 1))
                return Allocation { ok: true, address: arena.base + index * arena.pageSize }
            }
            index += pages
        }
    }
    return Allocation { ok: false, address: 0 }
}

public function givePages(arena: borrow mut PageArena, address: U64, order: U8) -> Bool {
    if order > 6 || address < arena.base || arena.usable == 0 || !alignedTo(address, arena.pageSize) { return false }
    let index = (address - arena.base) / arena.pageSize
    let pages = U64(1) << U64(order)
    if index >= 64 || !alignedTo(index, pages) { return false }
    let mask = pageMask(pages) << index
    if (arena.occupied & mask) != mask || (arena.starts & mask) != U64(1) << index || (arena.ends & mask) != U64(1) << (index + pages - 1) { return false }
    arena.occupied = arena.occupied ^ mask
    arena.starts = arena.starts ^ (U64(1) << index)
    arena.ends = arena.ends ^ (U64(1) << (index + pages - 1))
    return true
}
