import TarwinMM

function pressureTests() -> Bool {
    if footprint(7, 8, 9, 10) != 34 || footprint(0xffffffffffffffff, 0, 0, 1) != 0xffffffffffffffff { return false }
    var best = noCandidate()
    best = selectVictim(move best, PressureCandidate { koid: 3, band: 0, bytes: 1000 })
    if best.koid != 0 { return false }
    best = selectVictim(move best, PressureCandidate { koid: 3, band: 2, bytes: 999 })
    best = selectVictim(move best, PressureCandidate { koid: 4, band: 6, bytes: 2 })
    best = selectVictim(move best, PressureCandidate { koid: 7, band: 6, bytes: 3 })
    best = selectVictim(move best, PressureCandidate { koid: 5, band: 6, bytes: 3 })
    if best.koid != 5 || exceedsFootprint(0, 2, 1) || !exceedsFootprint(6, 2, 1) { return false }
    var purge = PurgeState { isVolatile: false, lost: false }
    if mayDiscard(purge, 0) { return false }
    makeVolatile(purge)
    if mayDiscard(purge, 1) || !mayDiscard(purge, 0) { return false }
    noteDiscard(purge)
    makeVolatile(purge)
    if makeNonvolatile(purge) || mayDiscard(purge, 0) { return false }
    makeVolatile(purge)
    return makeNonvolatile(purge)
}
