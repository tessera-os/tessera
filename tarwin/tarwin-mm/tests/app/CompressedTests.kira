import KCore
import TarwinMM

// Host fixture only. No heap access or scratch allocation in the codec.
struct TestBytes: ByteSource, ByteBuffer {
    var data: RawPtr
    var size: U64
    function byteCount(borrow self) -> U64 { return self.size }
    function byteAt(borrow self, offset: U64) -> U8 {
        if offset >= self.size { runtimeTrap() }
        return heapLoad<U8>(self.data, Int(offset))
    }
    function putByte(borrow mut self, offset: U64, value: U8) {
        if offset >= self.size { runtimeTrap() }
        heapStore<U8>(self.data, Int(offset), value)
    }
}

function buffer(size: U64) -> TestBytes {
    let data = heapAllocateRaw(Int(size), 16)
    heapFillBytes(data, U8(0), Int(size))
    return TestBytes { data: data, size: size }
}

struct TestTable: MatchTable {
    var data: RawPtr
    function clear(borrow mut self) { heapFillBytes(self.data, U8(0), 8192) }
    function previous(borrow self, bucket: U16) -> U16 {
        if bucket >= 4096 { runtimeTrap() }
        return heapLoad<U16>(self.data, Int(bucket) * 2)
    }
    function record(borrow mut self, bucket: U16, value: U16) {
        if bucket >= 4096 { runtimeTrap() }
        heapStore<U16>(self.data, Int(bucket) * 2, value)
    }
}

function pageRoundTrip() -> Bool {
    var original = buffer(16384 + 512)
    var packed = buffer(17000)
    var restored = buffer(original.size)
    var table = TestTable { data: heapAllocateRaw(8192, 16) }
    var i: U64 = 0
    while i < original.size {
        let byte = i < 16384 ? U8(i % 37) : U8(i & 255)
        original.putByte(i, byte)
        i += 1
    }
    let result = compressPage(original, packed, table)
    var ok = result.ok && result.count < original.size && decompressPage(packed, result.count, restored, original.size)
    i = 0
    while i < original.size {
        if original.byteAt(i) != restored.byteAt(i) { ok = false }
        i += 1
    }
    if decompressPage(packed, result.count - 1, restored, original.size) { ok = false }
    packed.size = 1
    if compressPage(original, packed, table).ok { ok = false }
    packed.size = 17000
    packed.putByte(0, 0)
    packed.putByte(1, 0)
    packed.putByte(2, 0)
    if decompressPage(packed, 3, restored, 4) { ok = false }
    // liblz4 LZ4_compress_default on 4096 zero bytes (raw block).
    original.size = 4096
    heapFillBytes(original.data, U8(0), 4096)
    let zero = compressPage(original, packed, table)
    if !zero.ok || zero.count != 26 { ok = false }
    i = 0
    while i < 26 {
        var expected: U8 = 0
        if i == 0 { expected = 31 }
        if i == 2 { expected = 1 }
        if i >= 4 && i < 19 { expected = 255 }
        if i == 19 { expected = 246 }
        if i == 20 { expected = 80 }
        if packed.byteAt(i) != expected { ok = false }
        i += 1
    }
    heapFreeRaw(original.data)
    heapFreeRaw(packed.data)
    heapFreeRaw(restored.data)
    heapFreeRaw(table.data)
    return ok
}
