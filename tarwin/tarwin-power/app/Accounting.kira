public struct ProcessEnergy {
    var microjoules: U64 = 0
    var fraction: U64 = 0

    function addDevice(borrow mut self, amount: U64) {
        if amount > 0xffffffffffffffff - microjoules { microjoules = 0xffffffffffffffff }
        else { microjoules += amount }
    }

    function addCpu(borrow mut self, nanos: U64, microwatts: U32) {
        let power = U64(microwatts)
        let seconds = nanos / 1000000000
        if power == 0 { return }
        if seconds > 0xffffffffffffffff / power { microjoules = 0xffffffffffffffff
            return }
        addDevice(seconds * power)
        let sub = (nanos % 1000000000) * power + fraction
        addDevice(sub / 1000000000)
        fraction = sub % 1000000000
    }
}

public enum ThermalBand { Nominal Fair Serious Critical }
public struct ThermalZone {
    let millidegrees: Int
    let fair: Int
    let serious: Int
    let critical: Int
}
public function thermalBand(zones: borrow [ThermalZone]) -> ThermalBand {
    var level: Int = 0
    for z in zones {
        if z.fair >= z.serious || z.serious >= z.critical || z.millidegrees >= z.critical { return .Critical }
        if z.millidegrees >= z.serious { level = 2 }
        else if z.millidegrees >= z.fair && level < 1 { level = 1 }
    }
    if level == 2 { return .Serious }
    if level == 1 { return .Fair }
    return .Nominal
}
