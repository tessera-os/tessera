//! Versioned registry serialization. Reject damaged, ambiguous or unknown
//! records as a whole; never treat partial bytes as accepted installations.
import Foundation

public namespace RegistryText {
    let version: String = "Tessera application registry 4"
    let linksVersion: String = "Tessera application registry 3"
    let rollbackVersion: String = "Tessera application registry 2"
    let legacyVersion: String = "Tessera application registry 1"
    let maxBytes: Number = 8388608
    let maxEntries: Number = 4096
}

/// A strictly delimited, UTF-8-preserving format. Display names escape tabs,
/// newlines and percent; publisher keys and app IDs are validated on read.
public function registryText(registry: borrow ApplicationRegistry) -> String {
    return registryTextForVersion(registry, RegistryText.version, true, true)
}

function registryTextForVersion(
    registry: borrow ApplicationRegistry,
    version: borrow String,
    writeSchemes: Bool,
    writeDocuments: Bool
) -> String {
    var lines: [String] = [copy version]
    for entry in registry.installed {
        lines.append(acceptedRow("A", entry, writeSchemes, writeDocuments))
    }
    for entry in registry.previousVersions {
        lines.append(acceptedRow("B", entry, writeSchemes, writeDocuments))
    }
    for entry in registry.pending {
        lines.append(candidateRow("P", entry.candidate, entry.carried, writeSchemes, writeDocuments))
    }
    for id in registry.retainedData {
        lines.append("D\t" + id.identifier + "\t" + id.publisher)
    }
    return joined(lines, "\n") + "\n"
}

function acceptedRow(
    prefix: borrow String,
    entry: borrow AcceptedApp,
    writeSchemes: Bool,
    writeDocuments: Bool
) -> String {
    return candidateRow(prefix, entry.candidate, entry.grants, writeSchemes, writeDocuments)
}

function candidateRow(
    prefix: borrow String,
    candidate: borrow AppCandidate,
    grants: borrow [String],
    writeSchemes: Bool,
    writeDocuments: Bool
) -> String {
    let base = prefix + "\t" + candidate.identity.identifier + "\t" + candidate.identity.publisher
        + "\t\(candidate.version)\t" + candidate.imageDigest + "\t"
        + managementWord(candidate.management) + "\t" + writtenRegistryField(candidate.name)
        + "\t" + joined(candidate.requests, ",") + "\t" + joined(grants, ",")
    let linked = writeSchemes ? base + "\t" + joined(candidate.linkSchemes, ",") : base
    return writeDocuments ? linked + "\t" + joined(candidate.documentTypes, ",") : linked
}

/// Parses all records atomically. Unknown versions, repeated identities,
/// malformed fields and invented grants refuse the entire registry.
public function parsedRegistry(text: borrow String) -> ApplicationRegistry? {
    if text.count > RegistryText.maxBytes { return .None }
    let lines = text.split("\n")
    if lines.count > RegistryText.maxEntries * 3 + 2 { return .None }
    if lines.count < 2 || lines[lines.count - 1] != "" { return .None }
    let legacy = lines[0] == RegistryText.legacyVersion
    let rollbackLegacy = lines[0] == RegistryText.rollbackVersion
    let linksLegacy = lines[0] == RegistryText.linksVersion
    if !legacy && !rollbackLegacy && !linksLegacy
        && lines[0] != RegistryText.version { return .None }
    var registry = ApplicationRegistry {}
    for index in 1..lines.count - 1 {
        let row = lines[index].split("\t")
        if row.count == 0 { return .None }
        if row[0] == "D" {
            if row.count != 3 { return .None }
            let id = AppIdentity { identifier: copy row[1], publisher: copy row[2] }
            if !validAppIdentity(id) || registry.retainedData.count >= RegistryText.maxEntries
                || registry.retainedData.contains(id) { return .None }
            registry.retainedData.append(id)
            continue
        }
        if row[0] != "A" && row[0] != "P" && (row[0] != "B" || legacy) {
            return .None
        }
        let columns = legacy || rollbackLegacy ? 9 : (linksLegacy ? 10 : 11)
        if row.count != columns { return .None }
        let version = try row[3].toNumber() otherwise return .None
        let management = match row[5] {
            "direct" -> AppManagement.Direct
            "catalog" -> AppManagement.Catalog
            else -> return .None
        }
        let name = try readRegistryField(row[6]) otherwise return .None
        let requests: [String] = row[7].count == 0 ? [] : row[7].split(",")
        let grants: [String] = row[8].count == 0 ? [] : row[8].split(",")
        let linkSchemes: [String] = legacy || rollbackLegacy || row[9].count == 0
            ? [] : row[9].split(",")
        let documentTypes: [String] = legacy || rollbackLegacy || linksLegacy || row[10].count == 0
            ? [] : row[10].split(",")
        let app = AppCandidate {
            identity: AppIdentity { identifier: copy row[1], publisher: copy row[2] },
            name: name,
            version: version,
            imageDigest: copy row[4],
            management: management,
            requests: requests,
            linkSchemes: linkSchemes,
            documentTypes: documentTypes
        }
        if validAppCandidate(app).isSome() { return .None }
        var seen: [String] = []
        for grant in grants {
            if !app.requests.contains(grant) || seen.contains(grant) { return .None }
            seen.append(copy grant)
        }
        if row[0] == "A" {
            if registry.installed.count >= RegistryText.maxEntries
                || registry.accepted(app.identity).isSome() { return .None }
            registry.installed.append(AcceptedApp { candidate: app, grants: grants })
        } else if row[0] == "B" {
            if registry.previousVersions.count >= RegistryText.maxEntries
                || registry.previous(app.identity).isSome() { return .None }
            registry.previousVersions.append(AcceptedApp { candidate: app, grants: grants })
        } else {
            if registry.pending.count >= RegistryText.maxEntries
                || registry.staged(app.identity).isSome() { return .None }
            registry.pending.append(PendingApp { candidate: app, carried: grants })
        }
    }
    // An old install cannot be paired with an equal or older pending version.
    for item in registry.pending {
        match registry.accepted(item.candidate.identity) {
            Some(active) -> if item.candidate.version <= active.candidate.version { return .None }
            None -> {}
        }
    }
    for item in registry.previousVersions {
        let current = try registry.accepted(item.candidate.identity) otherwise return .None
        if item.candidate.version >= current.candidate.version { return .None }
    }
    // A strict canonical spelling protects against forged or repeated records.
    // v1/v2 have nine columns, v3 has ten, and v4 adds document types. Reading
    // an older registry never fabricates verified document or URL handlers.
    if legacy || rollbackLegacy {
        if registryTextForVersion(registry, lines[0], false, false) != text { return .None }
    } else if linksLegacy {
        if registryTextForVersion(registry, lines[0], true, false) != text { return .None }
    } else if registryText(registry) != text { return .None }
    return .Some(move registry)
}

function managementWord(way: AppManagement) -> String {
    return match way {
        Direct -> "direct"
        Catalog -> "catalog"
    }
}

// Escaping byte-wise leaves other valid UTF-8 bytes intact.
function writtenRegistryField(text: borrow String) -> String {
    var output = ""
    var start: Number = 0
    for index in 0..text.count {
        let encoded = match Number(text.charAt(index)) {
            37 -> "%25"
            9 -> "%09"
            10 -> "%0A"
            13 -> "%0D"
            else -> ""
        }
        if encoded.count == 0 { continue }
        output += text.substring(start, index) + encoded
        start = index + 1
    }
    return output + text.substring(start, text.count)
}

function readRegistryField(text: borrow String) -> String? {
    var output = ""
    var start: Number = 0
    var index: Number = 0
    while index < text.count {
        if Number(text.charAt(index)) != 37 {
            index += 1
            continue
        }
        if index + 2 >= text.count { return .None }
        let decoded = match text.substring(index + 1, index + 3) {
            "25" -> "%"
            "09" -> "\t"
            "0A" -> "\n"
            "0D" -> "\r"
            else -> return .None
        }
        output += text.substring(start, index) + decoded
        index += 3
        start = index
    }
    return .Some(output + text.substring(start, text.count))
}
