//! User-selected default applications for document extensions. This is a
//! routing preference, not an executable launcher or filesystem access grant.
//! The caller must use the trusted launcher and an OS-granted document handle.
import Foundation

public struct DocumentAssociation {
    let extension: String
    let application: AppIdentity
}

public struct DocumentAssociations {
    var defaults: [DocumentAssociation] = []
}

public enum AssociationFailure {
    InvalidExtension
    ApplicationNotInstalled
    TypeNotDeclared
}

public enum DocumentRoute {
    ChooseApplication
    OpenAccepted(AppIdentity)
    DefaultUnavailable(AppIdentity)
}

/// A document-opening selection tied to an accepted app image. This ticket
/// carries only the extension, not a filesystem path, document bytes or a
/// capability: the trusted document broker must grant an explicit handle.
public struct DocumentActivation {
    let application: AppIdentity
    let imageDigest: String
    let version: Number
    let extension: String
}

public enum DocumentActivationDecision {
    ChooseApplication
    Unavailable(AppIdentity)
    Ready(DocumentActivation)
}

public namespace AssociationLimits {
    let maxDefaults: Number = 256
    let maxExtensionBytes: Number = 16
}

public function validDocumentExtension(extension: borrow String) -> Bool {
    if extension.count == 0 || extension.count > AssociationLimits.maxExtensionBytes {
        return false
    }
    for index in 0..extension.count {
        let code = Number(extension.charAt(index))
        let alpha = code >= 97 && code <= 122
        let number = code >= 48 && code <= 57
        if !alpha && !number { return false }
    }
    return true
}

/// Extracts only a conventional final filename extension, rather than
/// trusting any filename to designate executable or document privileges.
public function documentExtension(filename: borrow String) -> String? {
    let parts = filename.split("/")
    if parts.count == 0 { return .None }
    let name = parts[parts.count - 1]
    var dot: Number = -1
    for index in 0..name.count {
        if Number(name.charAt(index)) == 46 { dot = index }
    }
    if dot < 1 || dot >= name.count - 1 { return .None }
    let extension = name.substring(dot + 1, name.count).lowercased()
    return validDocumentExtension(extension) ? .Some(extension) : .None
}

extend DocumentAssociations {
    /// A default is added only for a currently accepted publisher identity.
    /// A later uninstall does not silently transfer it to another publisher.
    function chooseDefault(
        borrow mut self,
        extension: borrow String,
        identity: borrow AppIdentity,
        registry: borrow ApplicationRegistry
    ) -> Result<Void, AssociationFailure> {
        let normalized = extension.lowercased()
        if !validDocumentExtension(normalized) { return .Error(.InvalidExtension) }
        let app = try registry.accepted(identity) otherwise return .Error(.ApplicationNotInstalled)
        if !app.candidate.documentTypes.contains(normalized) {
            return .Error(.TypeNotDeclared)
        }
        var kept: [DocumentAssociation] = []
        for entry in defaults {
            if entry.extension != normalized { kept.append(copy entry) }
        }
        if kept.count >= AssociationLimits.maxDefaults { return .Error(.InvalidExtension) }
        kept.append(DocumentAssociation { extension: normalized, application: copy identity })
        defaults = move kept
        return .Ok
    }

    function forgetDefault(borrow mut self, extension: borrow String) {
        let normalized = extension.lowercased()
        var kept: [DocumentAssociation] = []
        for entry in defaults {
            if entry.extension != normalized { kept.append(copy entry) }
        }
        defaults = move kept
    }

    /// The trusted document opener must independently verify application
    /// registration and the document's granted handle at launch time.
    function route(
        borrow self,
        filename: borrow String,
        registry: borrow ApplicationRegistry
    ) -> DocumentRoute {
        let extension = match documentExtension(filename) {
            Some(found) -> found
            None -> return .ChooseApplication
        }
        for entry in defaults {
            if entry.extension != extension { continue }
            let accepted = match registry.accepted(entry.application) {
                Some(value) -> value
                None -> return .DefaultUnavailable(copy entry.application)
            }
            return accepted.candidate.documentTypes.contains(extension)
                ? .OpenAccepted(copy entry.application)
                : .DefaultUnavailable(copy entry.application)
        }
        return .ChooseApplication
    }

    /// Resolve a default without granting document access. Even a ready
    /// ticket needs a separately approved, scoped document handle.
    function activation(
        borrow self,
        filename: borrow String,
        registry: borrow ApplicationRegistry
    ) -> DocumentActivationDecision {
        let extension = match documentExtension(filename) {
            Some(value) -> value
            None -> return .ChooseApplication
        }
        return match self.route(filename, registry) {
            ChooseApplication -> .ChooseApplication
            DefaultUnavailable(identity) -> .Unavailable(identity)
            OpenAccepted(identity) -> {
                let installed = match registry.accepted(identity) {
                    Some(value) -> value
                    None -> return DocumentActivationDecision.Unavailable(identity)
                }
                DocumentActivationDecision.Ready(DocumentActivation {
                    application: copy identity,
                    imageDigest: copy installed.candidate.imageDigest,
                    version: installed.candidate.version,
                    extension: extension
                })
            }
        }
    }

    /// Recheck the accepted app and default before the trusted broker mints
    /// a document-scoped handle; a stale version cannot inherit the request.
    function activationIsCurrent(
        borrow self,
        ticket: borrow DocumentActivation,
        registry: borrow ApplicationRegistry
    ) -> Bool {
        if !validDocumentExtension(ticket.extension) { return false }
        let chosen = match self.route("document." + ticket.extension, registry) {
            OpenAccepted(identity) -> identity
            ChooseApplication, DefaultUnavailable -> return false
        }
        if !sameApp(chosen, ticket.application) { return false }
        let installed = try registry.accepted(ticket.application) otherwise return false
        return installed.candidate.version == ticket.version
            && installed.candidate.imageDigest == ticket.imageDigest
    }
}
