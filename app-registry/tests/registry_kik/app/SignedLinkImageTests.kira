function linkedAppSignature() -> [UN8] {
    return [
        6, 133, 90, 127, 212, 1, 125, 130, 160, 94, 189, 171, 213, 119, 140, 76, 243, 177,
        79, 17, 236, 248, 188, 124, 83, 228, 212, 128, 130, 106, 127, 221, 218, 187, 183, 40,
