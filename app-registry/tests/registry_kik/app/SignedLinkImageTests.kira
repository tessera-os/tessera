}

function linkedTestManifest() -> ApplicationManifest {
    return ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+notes"]
    }
}

function linkedTestSigner() -> AppImageSigner {
    return AppImageSigner {
        certificate: linkedAppCertificate(),
        trustedCertificateSha256: linkedAppPin()
    }
}

@Test
function signedCustomSchemeIsVerifiedAndCanBeActivated() {
    let path = ".tessera-signed-link-image-test"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let app = match verifyAppImageCandidate(
        linkedTestManifest(), path, linkedTestSigner(), linkedAppSignature(), .Direct
    ) {
        Ok(value) -> value
        Error(failure) -> {
            absorb failure
            expect!(false)
            return
        }
    }
    expect!(app.linkSchemes == ["demo+notes"])
    var registry = ApplicationRegistry {}
    expect!(registrationSucceeded(registry.prepare(app)))
    expect!(registrationSucceeded(registry.activate(app.identity, app.imageDigest)))
    var defaults = LinkAssociations {}
    let selected = match defaults.chooseDefault("demo+notes", app.identity, registry) {
        Ok -> true
        Error(failure) -> {
            absorb failure
            false
        }
    }
    expect!(selected)
    let ready = match defaults.activation("demo+notes:123", registry) {
        Ready(ticket) -> defaults.activationIsCurrent(ticket, registry)
        ChooseApplication, Unavailable -> false
    }
    expect!(ready)
    match removePath(path) { Ok -> {} Error(reason) -> absorb reason }
}

@Test
function signedLinkDeclarationsCannotBeAddedRemovedOrSubstituted() {
    let path = ".tessera-signed-link-image-tamper"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let different = ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+task"]
    }
    let removed = ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"]
    }
    for changed in [different, removed] {
        let rejected = match verifyAppImageCandidate(
            changed, path, linkedTestSigner(), linkedAppSignature(), .Direct
        ) {
            Ok(value) -> {
                absorb value
                false
            }
            Error(failure) -> {
                absorb failure
                true
            }
        }
        expect!(rejected)
    }
    match removePath(path) { Ok -> {} Error(reason) -> absorb reason }
}
