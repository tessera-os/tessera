function linkedAppPin() -> [UN8] {
    return [
        51, 61, 34, 87, 185, 229, 91, 198, 82, 111, 97, 146, 179, 21, 11, 198, 2, 101,
        95, 236, 168, 119, 234, 2, 245, 254, 2, 145, 139, 248, 96, 231,
