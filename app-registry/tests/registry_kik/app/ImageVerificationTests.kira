    return [
        188, 249, 114, 98, 132, 46, 85, 136, 62, 146, 11, 103, 75, 113, 148, 43,
        44, 239, 171, 44, 193, 102, 226, 4, 158, 43, 233, 31, 64, 20, 162, 225,
