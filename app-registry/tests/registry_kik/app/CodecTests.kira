import Foundation
import AppRegistry

// Strip v4's trailing declaration columns for migration fixtures. v1/v2 have
// neither handler field; v3 already has the custom-scheme column.
function oldRegistryBytes(registry: borrow ApplicationRegistry, version: borrow String) -> String {
    let modern = registryText(registry)
    let rows = modern.split("\n")
    var previous: [String] = [copy version]
    let dropped = version == RegistryText.linksVersion ? 1 : 2
    for index in 1..rows.count - 1 {
        let row = rows[index]
        if row.startsWith("D\t") {
            previous.append(copy row)
        } else {
            previous.append(row.substring(0, row.count - dropped))
        }
    }
    return joined(previous, "\n") + "\n"
}

@Test
function registryRoundTripsAcceptedPendingGrantsAndIdentity() {
    var registry = ApplicationRegistry {}
    let first = candidate(pubA, 1, digestA)
    let second = candidate(pubB, 1, digestB)
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    expect!(registrationSucceeded(registry.setGrant(first.identity, "data", true)))
    expect!(registrationSucceeded(registry.prepare(second)))
    registry.retainedData.append(AppIdentity { identifier: "example.tasks", publisher: pubA })
    let saved = registryText(registry)
    let decoded = try parsedRegistry(saved) otherwise return
    expect!(registryText(decoded) == saved)
    expect!(decoded.installed.count == 1)
    expect!(decoded.pending.count == 1)
    expect!(decoded.retainedData.count == 1)
    let accepted = try decoded.accepted(first.identity) otherwise return
    expect!(accepted.grants == ["data"])
    expect!(decoded.accepted(second.identity).isNone())
    expect!(decoded.staged(second.identity).isSome())
}

@Test
function registryRejectsTruncationForgedGrantsAndUnknownVersions() {
    var registry = ApplicationRegistry {}
    let app = candidate(pubA, 1, digestA)
    expect!(registrationSucceeded(registry.prepare(app)))
    expect!(registrationSucceeded(registry.activate(app.identity, digestA)))
    let saved = registryText(registry)
    expect!(parsedRegistry(saved).isSome())
    expect!(parsedRegistry(saved.substring(0, saved.count - 1)).isNone())
    expect!(parsedRegistry("Tessera application registry 5\n").isNone())
    expect!(parsedRegistry(saved + "D\tbad/id\t" + pubA + "\n").isNone())
    let forged = saved.before("\t\t\n") + "\t\tnetwork\n"
    expect!(parsedRegistry(forged).isNone())
}

@Test
function registryEscapesDelimiterAndPercentWithoutLosingUnicode() {
    var registry = ApplicationRegistry {}
    let name = AppCandidate {
        identity: AppIdentity { identifier: "example.notes", publisher: pubA },
        name: "Café 100% ☀️",
        version: 1,
        imageDigest: digestA,
        management: .Direct,
        requests: ["data"]
    }
    expect!(registrationSucceeded(registry.prepare(name)))
    let saved = registryText(registry)
    expect!(saved.contains("Café 100%25 ☀️"))
    let restored = try parsedRegistry(saved) otherwise return
    expect!(restored.pending[0].candidate.name == name.name)
    expect!(registryText(restored) == saved)
    let malformed = "Tessera application registry 1\nP\t" + name.identity.identifier + "\t" + pubA
        + "\t1\t" + digestA + "\tdirect\tname%XX\tdata\t\n"
    expect!(parsedRegistry(malformed).isNone())
}

@Test
function duplicateAcceptedOrPendingRecordsAreRejected() {
    var registry = ApplicationRegistry {}
    let entry = candidate(pubA, 1, digestA)
    expect!(registrationSucceeded(registry.prepare(entry)))
    expect!(registrationSucceeded(registry.activate(entry.identity, digestA)))
    let saved = registryText(registry)
    let row = saved.split("\n")[1]
    expect!(parsedRegistry(saved + row + "\n").isNone())
    expect!(parsedRegistry("Tessera application registry 1\n" + row + "\n" + row + "\n").isNone())
}

@Test
function registryLimitsAreAvailableAndInvalidRowsFailClosed() {
    let broken = RegistryText.version + "\n" + "X\tbad\n"
    expect!(parsedRegistry(broken).isNone())
    expect!(RegistryText.maxBytes == 8388608)
    expect!(RegistryText.maxEntries == 4096)
}

@Test
function rollbackVersionTwoSerializationKeepsThePreviouslyAcceptedImage() {
    var registry = ApplicationRegistry {}
    let old = candidate(pubA, 1, digestA)
    let updated = candidate(pubA, 2, digestB)
    expect!(registrationSucceeded(registry.prepare(old)))
    expect!(registrationSucceeded(registry.activate(old.identity, digestA)))
    expect!(registrationSucceeded(registry.setGrant(old.identity, "data", true)))
    expect!(registrationSucceeded(registry.prepare(updated)))
    expect!(registrationSucceeded(registry.activate(updated.identity, digestB)))
    let text = registryText(registry)
    expect!(text.startsWith(RegistryText.version + "\n"))
    expect!(text.contains("B\texample.notes\t" + pubA))
    let loaded = try parsedRegistry(text) otherwise return
    expect!(registryText(loaded) == text)
    expect!((try loaded.previous(old.identity) otherwise return).candidate.version == 1)
    expect!((try loaded.previous(old.identity) otherwise return).grants == ["data"])
    expect!(loaded.installed.count == 1)
}

@Test
function versionOneAcceptedRegistriesRemainReadableAndUpgradeOnNextWrite() {
    var registry = ApplicationRegistry {}
    let item = candidate(pubA, 1, digestA)
    expect!(registrationSucceeded(registry.prepare(item)))
    expect!(registrationSucceeded(registry.activate(item.identity, digestA)))
    let versionTwo = registryText(registry)
    let versionOne = oldRegistryBytes(registry, RegistryText.legacyVersion)
    let decoded = try parsedRegistry(versionOne) otherwise return
    expect!(decoded.installed.count == 1)
    expect!(decoded.previousVersions.count == 0)
    expect!(registryText(decoded) == versionTwo)
    expect!(parsedRegistry("Tessera application registry 5\n").isNone())
}

@Test
function orphanAndDuplicateRollbackRecordsAreRejected() {
    var registry = ApplicationRegistry {}
    let previous = candidate(pubA, 1, digestA)
    let current = candidate(pubA, 2, digestB)
    expect!(registrationSucceeded(registry.prepare(previous)))
    expect!(registrationSucceeded(registry.activate(previous.identity, digestA)))
    expect!(registrationSucceeded(registry.prepare(current)))
    expect!(registrationSucceeded(registry.activate(current.identity, digestB)))
    let text = registryText(registry)
    let rows = text.split("\n")
    let rollbackRow = rows[2]
    expect!(rollbackRow.startsWith("B\t"))
    expect!(parsedRegistry(text + rollbackRow + "\n").isNone())
    expect!(parsedRegistry(RegistryText.version + "\n" + rollbackRow + "\n").isNone())
    var fields = rollbackRow.split("\t")
    fields[3] = "3"
    let invalid = RegistryText.version + "\n" + rows[1] + "\n"
        + joined(fields, "\t") + "\n"
    expect!(parsedRegistry(invalid).isNone())
    let legacyWithRollback = RegistryText.legacyVersion + "\n" + rows[1] + "\n" + rollbackRow + "\n"
    expect!(parsedRegistry(legacyWithRollback).isNone())
}

@Test
function versionOneRegistryMigratesWithoutChangingAcceptedPermissions() {
    var registry = ApplicationRegistry {}
    let first = candidate(pubA, 1, digestA)
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    expect!(registrationSucceeded(registry.setGrant(first.identity, "data", true)))
    let modern = registryText(registry)
    let old = oldRegistryBytes(registry, RegistryText.legacyVersion)
    let upgraded = try parsedRegistry(old) otherwise return
    expect!(upgraded.installed.count == 1)
    expect!(upgraded.previousVersions.count == 0)
    let accepted = try upgraded.accepted(first.identity) otherwise return
    expect!(accepted.candidate.imageDigest == digestA)
    expect!(accepted.grants == ["data"])
    expect!(registryText(upgraded) == modern)
}

@Test
function versionTwoRegistryMigratesWithRollbackAndNoInventedLinkClaims() {
    var registry = ApplicationRegistry {}
    let first = candidate(pubA, 1, digestA)
    let second = candidate(pubA, 2, digestB)
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    expect!(registrationSucceeded(registry.prepare(second)))
    expect!(registrationSucceeded(registry.activate(second.identity, digestB)))
    let previous = oldRegistryBytes(registry, RegistryText.rollbackVersion)
    let decoded = try parsedRegistry(previous) otherwise return
    expect!(decoded.installed.count == 1)
    expect!(decoded.previousVersions.count == 1)
    expect!((try decoded.accepted(first.identity) otherwise return).candidate.linkSchemes.count == 0)
    expect!((try decoded.previous(first.identity) otherwise return).candidate.linkSchemes.count == 0)
    expect!((try decoded.accepted(first.identity) otherwise return).candidate.documentTypes.count == 0)
    expect!(registryText(decoded) == registryText(registry))
    // An old record with a forged extra field is not a trusted declaration.
    expect!(parsedRegistry(previous.substring(0, previous.count - 1) + "\tdemo+notes\n").isNone())
}

@Test
function versionThreeRegistryMigratesLinkHandlersWithoutInventingDocumentTypes() {
    var registry = ApplicationRegistry {}
    var first = candidate(pubA, 1, digestA)
    first.linkSchemes = ["demo+notes"]
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    let v3 = oldRegistryBytes(registry, RegistryText.linksVersion)
    let recovered = try parsedRegistry(v3) otherwise return
    let active = try recovered.accepted(first.identity) otherwise return
    expect!(active.candidate.linkSchemes == ["demo+notes"])
    expect!(active.candidate.documentTypes.count == 0)
    expect!(registryText(recovered) == registryText(registry))
    expect!(parsedRegistry(v3.substring(0, v3.count - 1) + "\ttxt\n").isNone())
}

@Test
function registryV4PersistsDocumentTypesAcrossStagingUpdatesAndRollback() {
    var registry = ApplicationRegistry {}
    var first = candidate(pubA, 1, digestA)
    first.documentTypes = ["txt", "md"]
    first.linkSchemes = ["demo+notes"]
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    var next = candidate(pubA, 2, digestB)
    next.documentTypes = ["txt"]
    expect!(registrationSucceeded(registry.prepare(next)))
    let staged = try parsedRegistry(registryText(registry)) otherwise return
    expect!((try staged.staged(first.identity) otherwise return).candidate.documentTypes == ["txt"])
    expect!(registrationSucceeded(registry.activate(first.identity, digestB)))
    let encoded = registryText(registry)
    let restored = try parsedRegistry(encoded) otherwise return
    expect!((try restored.accepted(first.identity) otherwise return).candidate.documentTypes == ["txt"])
    expect!((try restored.previous(first.identity) otherwise return).candidate.documentTypes
        == ["txt", "md"])
    expect!(registryText(restored) == encoded)
    let forbidden = encoded.substring(0, encoded.count - 1) + ",TXT\n"
    expect!(parsedRegistry(forbidden).isNone())
}

@Test
function registryRoundTripsAcceptedStagedAndRollbackCustomLinkDeclarations() {
    var registry = ApplicationRegistry {}
    var first = candidate(pubA, 1, digestA)
    first.linkSchemes = ["demo+notes", "demo+task"]
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    var update = candidate(pubA, 2, digestB)
    update.linkSchemes = ["demo+task"]
    expect!(registrationSucceeded(registry.prepare(update)))
    let staged = try parsedRegistry(registryText(registry)) otherwise return
    expect!((try staged.staged(first.identity) otherwise return).candidate.linkSchemes == ["demo+task"])
    expect!(registrationSucceeded(registry.activate(first.identity, digestB)))
    let encoded = registryText(registry)
    let restored = try parsedRegistry(encoded) otherwise return
    expect!((try restored.accepted(first.identity) otherwise return).candidate.linkSchemes
        == ["demo+task"])
    expect!((try restored.previous(first.identity) otherwise return).candidate.linkSchemes
        == ["demo+notes", "demo+task"])
    expect!(registryText(restored) == encoded)
    expect!(parsedRegistry(encoded.substring(0, encoded.count - 1) + ",https\n").isNone())
}

@Test
function versionTwoRegistryPreservesPreviousAcceptedImageAcrossReopening() {
    var registry = ApplicationRegistry {}
    let first = candidate(pubA, 1, digestA)
    let second = candidate(pubA, 2, digestB)
    expect!(registrationSucceeded(registry.prepare(first)))
    expect!(registrationSucceeded(registry.activate(first.identity, digestA)))
    expect!(registrationSucceeded(registry.setGrant(first.identity, "data", true)))
    expect!(registrationSucceeded(registry.prepare(second)))
    expect!(registrationSucceeded(registry.activate(second.identity, digestB)))
    let saved = registryText(registry)
    let reopened = try parsedRegistry(saved) otherwise return
    expect!(reopened.previousVersions.count == 1)
    expect!((try reopened.previous(first.identity) otherwise return).candidate.version == 1)
    expect!(registryText(reopened) == saved)
    var restored = move reopened
    expect!(registrationSucceeded(restored.rollBack(first.identity, digestA, true)))
    expect!((try restored.accepted(first.identity) otherwise return).candidate.version == 1)
    expect!((try restored.accepted(first.identity) otherwise return).grants == ["data"])
}
