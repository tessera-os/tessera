function signedDocumentPin() -> [UN8] {
    return [
        213, 81, 127, 50, 14, 124, 73, 4, 57, 145, 95, 32, 52, 151, 16, 217, 165, 154,
        251, 92, 2, 214, 38, 149, 31, 78, 236, 175, 27, 67, 202, 57,
    ]
}

function signedDocumentSignature() -> [UN8] {
    return [
        208, 216, 48, 91, 9, 29, 190, 12, 114, 122, 146, 205, 55, 194, 214, 190, 173, 227,
        250, 13, 186, 158, 184, 153, 84, 53, 110, 42, 238, 59, 173, 225, 62, 151, 97, 150,
        104, 178, 77, 9, 149, 215, 88, 133, 234, 46, 140, 234, 79, 42, 105, 130, 171, 117,
        68, 240, 42, 156, 48, 22, 159, 166, 145, 6,
    ]
}

function signedDocumentSigner() -> AppImageSigner {
    return AppImageSigner {
        certificate: signedDocumentCert(),
        trustedCertificateSha256: signedDocumentPin()
    }
}

function signedDocumentManifest() -> ApplicationManifest {
    return ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+notes"], documentTypes: ["txt", "md"]
    }
}

@Test
function signedDocumentTypesAreAuthenticatedAndCanBecomeOpenWithDefaults() {
    let path = ".tessera-signed-document-v3"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let candidate = match verifyAppImageCandidate(
        signedDocumentManifest(), path, signedDocumentSigner(), signedDocumentSignature(), .Direct
    ) {
        Ok(value) -> value
        Error(reason) -> {
            absorb reason
            expect!(false)
            return
        }
    }
    expect!(candidate.documentTypes == ["txt", "md"])
    expect!(candidate.linkSchemes == ["demo+notes"])
    var registry = ApplicationRegistry {}
    expect!(registrationSucceeded(registry.prepare(candidate)))
    expect!(registrationSucceeded(registry.activate(candidate.identity, candidate.imageDigest)))
    var defaults = DocumentAssociations {}
    let selected = match defaults.chooseDefault("TXT", candidate.identity, registry) {
        Ok -> true
        Error(reason) -> {
            absorb reason
            false
        }
    }
    expect!(selected)
    let ready = match defaults.activation("document.txt", registry) {
        Ready(ticket) -> defaults.activationIsCurrent(ticket, registry)
        Unavailable, ChooseApplication -> false
    }
    expect!(ready)
    match removePath(path) {
        Ok -> {}
        Error(reason) -> absorb reason
    }
}

@Test
function signedDocumentImageRejectsAddedRemovedAndReplacedTypeClaims() {
    let path = ".tessera-signed-document-v3-tampered"
    match writeFile(path, "abc") {
        Ok -> {}
        Error(reason) -> {
            absorb reason
            return
        }
    }
    let changedType = ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+notes"], documentTypes: ["txt", "png"]
    }
    let removedType = ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+notes"]
    }
    let changedLink = ApplicationManifest {
        identifier: "example.notes", name: "Notes", version: 1,
        executable: "bin", requests: ["display", "data"],
        linkSchemes: ["demo+tasks"], documentTypes: ["txt", "md"]
    }
    for forged in [changedType, removedType, changedLink] {
        let rejected = match verifyAppImageCandidate(
            forged, path, signedDocumentSigner(), signedDocumentSignature(), .Direct
        ) {
            Ok(value) -> {
                absorb value
                false
            }
            Error(reason) -> {
                absorb reason
                true
            }
        }
        expect!(rejected)
    }
    match writeFile(path, "abd") {
        Ok -> {}
        Error(reason) -> absorb reason
    }
    let modified = match verifyAppImageCandidate(
        signedDocumentManifest(), path, signedDocumentSigner(), signedDocumentSignature(), .Direct
    ) {
        Ok(value) -> {
            absorb value
            false
        }
        Error(reason) -> {
            absorb reason
            true
        }
    }
    expect!(modified)
    match removePath(path) {
        Ok -> {}
        Error(reason) -> absorb reason
    }
}
