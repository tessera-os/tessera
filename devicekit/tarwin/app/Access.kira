// Driver-side ownership of an already isolated DmaBuffer. Kernel handle
// lifetime and synchronous domain invalidation remain Tarwin's. Never
// substitute virtual/physical addresses for the returned IOVA.
public enum DmaDirection { ToDevice FromDevice Bidirectional }
public enum BufferOwner { Cpu Device Retired }
public struct NativeDmaBuffer {
    let handle: U64
    let iova: U64
    let length: U64
    let direction: DmaDirection
    var owner: BufferOwner = .Cpu

    function suitable(borrow self, alignment: U64, boundary: U64) -> Bool {
        if handle == 0 || length == 0 || length - 1 > 0xffffffffffffffff - iova ||
            alignment == 0 || (alignment & (alignment - 1)) != 0 || iova % alignment != 0 { return false }
        if boundary == 0 { return true }
        if (boundary & (boundary - 1)) != 0 { return false }
        return length <= boundary - iova % boundary
    }

    function prepareForDevice(borrow mut self, syncForDevice: borrow (U64,DmaDirection) -> Bool) -> Bool {
        if owner != .Cpu || !suitable(1,0) || !syncForDevice(handle,direction) { return false }
        owner = .Device
        return true
    }
    function completeFromDevice(borrow mut self, syncForCpu: borrow (U64,DmaDirection) -> Bool) -> Bool {
        if owner != .Device || !syncForCpu(handle,direction) { return false }
        owner = .Cpu
        return true
    }
    function retire(borrow mut self, closeAndDrain: borrow (U64) -> Bool) -> Bool {
        if owner == .Retired { return true }
        if owner != .Cpu || !closeAndDrain(handle) { return false }
        owner = .Retired
        return true
    }
}

public function compatibleDriver(trainYear: U32, trainMonth: U32, apiYear: U32, apiMonth: U32) -> Bool {
    if trainYear > 99 || apiYear > 99 || trainMonth == 0 || trainMonth > 12 ||
        apiMonth == 0 || apiMonth > 12 { return false }
    let train = trainYear * 12 + trainMonth
    let driver = apiYear * 12 + apiMonth
    return driver >= 26 * 12 + 11 && train >= driver && train - driver < 12
}
