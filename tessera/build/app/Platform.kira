import Foundation
import Build

// What a release carries that no component builds: the directories the machine
// mounts onto, the C library and its loader, and the graphics runtime.

namespace Release {
    let version: String = "0.1.0"
}

// The directory skeleton holding `directories`, and /etc/tessera-release:
// what the machine says it is, which PID 1 hands to every service it starts.
// A copy in CoreServices is what a confined application reads, with no /etc
// in its view.
function platformBase(
    graph: borrow mut Graph,
    context: borrow BuildContext,
    name: borrow String,
    directories: borrow [String]
) -> Artifact {
    let architecture = context.architecture.name()
    var parts = directoryParts(directories)
    let release = graph.write(
        "\(architecture)/\(name)/tessera-release",
        textLines(
            [
                "NAME=\"Tessera\"",
                "VERSION=\"\(Release.version)\"",
                "ARCH=\"\(architecture)\""
            ]
        ),
        FileMode.data
    )
    parts.append(.Place(TreePlace { path: "etc/tessera-release", artifact: release }))
    parts.append(
        .Place(TreePlace { path: "System/Library/CoreServices/SystemVersion", artifact: release })
    )
    return graph.tree("\(architecture)/\(name)", parts)
}

// A directory at each of `directories`, each runnable, as every directory is.
function directoryParts(directories: borrow [String]) -> [TreePart] {
    var parts: [TreePart] = []
    for directory in directories {
        parts.append(.Directory(TreeDirectory { path: copy directory, mode: FileMode.program }))
    }
    return parts
}

// The C library, its loader and the runtime a C ABI object reaches for, where
// the ELF headers point and no further: the loader where PT_INTERP names it,
// and the libraries in `runtimeDirectory`, the first directory Debian's loader
// searches. The kernel runs the loader PT_INTERP names and refuses one without
// an execute bit.
function platformRuntime(graph: borrow mut Graph, context: borrow BuildContext) -> Artifact {
    let architecture = context.architecture
    let libraries = "usr/lib/\(architecture.multiarch())"
    let loader = architecture.loader()
    var parts: [TreePart] = [
        .Place(
            TreePlace {
                path: "\(architecture.libraryDirectory())/\(loader)",
                artifact: sysrootFile(graph, context, "\(libraries)/\(loader)"),
                mode: FileMode.program
            }
        )
    ]
    let directory = runtimeDirectory(context)
    let names = [
        "libc.so.6", "libm.so.6", "libdl.so.2", "libpthread.so.0", "librt.so.1", "libgcc_s.so.1",
    ]
    for name in names {
        parts.append(
            .Place(
                TreePlace {
                    path: "\(directory)/\(name)",
                    artifact: sysrootFile(graph, context, "\(libraries)/\(name)"),
                    mode: FileMode.program
                }
            )
        )
    }
    // The sysroot's libstdc++.so.6 is a symlink; stage its pinned target
    // under the SONAME the Turnip ICD requests.
    parts.append(
        .Place(
            TreePlace {
                path: "\(directory)/libstdc++.so.6",
                artifact: sysrootFile(graph, context, "\(libraries)/libstdc++.so.6.0.33"),
                mode: FileMode.program
            }
        )
    )
    return graph.tree("\(architecture.name())/runtime", parts)
}

// The directory, from the root of a release, holding its C library: where the
// loader finds a library the release adds beside it.
function runtimeDirectory(context: borrow BuildContext) -> String {
    return "lib/\(context.architecture.multiarch())"
}

// Vulkan, the profile's GPU driver and libdrm, beside the C library where the
// loader finds them, with an ICD manifest naming Venus for QEMU or Turnip for
// the dm2q Adreno 740.
// The time zones' rules, the host's tz database, where LibTessera's
// `SystemDirectory.zoneInfo` reads them.
function platformZoneInfo(graph: borrow mut Graph, context: borrow BuildContext) -> Artifact {
    let architecture = context.architecture.name()
    return graph.tree(
        "\(architecture)/zoneinfo",
        [.Place(
            TreePlace {
                path: "System/Library/ZoneInfo",
                artifact: graph.sourceTree(hostZoneInfo(), ["posix", "right"])
            }
        )]
    )
}

function platformGraphics(
    graph: borrow mut Graph,
    context: borrow BuildContext,
    dm2qFirmware: Artifact?
) -> Artifact {
    let architecture = context.architecture.name()
    let directory = runtimeDirectory(context)
    let driver = context.kernelProfile == "dm2q" ? "freedreno" : "virtio"
    let libraries = librariesFrom(
        graph,
        "\(architecture)/graphics/libraries",
        context.sysroot.graphics,
        directory,
        ["libvulkan.so.1", "libvulkan_\(driver).so", "libdrm.so.2"]
    )
    let manifest = "usr/share/vulkan/icd.d/\(driver)_icd.\(architecture).json"
    let icd = graph.write(
        "\(architecture)/graphics/\(driver)_icd.json",
        textLines(
            [
                "{",
                "    \"ICD\": {",
                "        \"api_version\": \"1.3.305\",",
                "        \"library_path\": \"/\(directory)/libvulkan_\(driver).so\"",
                "    },",
                "    \"file_format_version\": \"1.0.0\"",
                "}"
            ]
        ),
        FileMode.data
    )
    let placed = graph.tree(
        "\(architecture)/graphics/manifest",
        [.Place(TreePlace { path: manifest, artifact: icd, mode: FileMode.data })]
    )
    var parts = [libraries, placed]
    if context.kernelProfile == "dm2q" {
        match dm2qFirmware {
            Some(firmware) -> parts.append(firmware)
            None -> {}
        }
    }
    return graph.union("\(architecture)/graphics", parts)
}

// The A740 firmware Linux's DRM/MSM driver requests: the SQE and GMU images
// from linux-firmware, and Samsung's signed zap image from the host, at the
// path the dm2q device tree names.
function dm2qGpuFirmware(graph: borrow mut Graph, context: borrow BuildContext) -> Artifact {
    let architecture = context.architecture.name()
    let sqe = graph.download(
        "firmware/qcom/a740_sqe.fw",
        "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/qcom/a740_sqe.fw?h=main",
        "96fee336424b139100fc60b5b45a907360e4b3936d7e1d00406b9bd80ca48473"
    )
    let gmu = graph.download(
        "firmware/qcom/gmu_gen70200.bin",
        "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/qcom/gmu_gen70200.bin?h=main",
        "1a2a419c39046d3141fc5fed5aa7f971de2db40cc7a1d89693c3e26fad64dd98"
    )
    let zap = graph.source(context.host.dm2qFirmware() + "/a740_zap.mbn")
    return graph.tree(
        "\(architecture)/graphics/dm2q-firmware",
        [
            .Place(TreePlace { path: "lib/firmware/qcom/a740_sqe.fw", artifact: sqe }),
            .Place(TreePlace { path: "lib/firmware/qcom/gmu_gen70200.bin", artifact: gmu }),
            .Place(
                TreePlace {
                    path: "lib/firmware/qcom/sm8550/samsung/dm2q/a740_zap.mbn",
                    artifact: zap
                }
            )
        ]
    )
}

// The dm2q firmware Linux's remoteproc loads for the ADSP, which runs the
// USB-C port's policy and the charger: Samsung's split images, placed whole
// at the path the dm2q device tree names. The kernel reads them once the
// system volume is the root.
function dm2qDeviceFirmware(graph: borrow mut Graph, context: borrow BuildContext) -> Artifact {
    let architecture = context.architecture.name()
    let adsp = graph.sourceTree(context.host.dm2qFirmware() + "/adsp", [])
    return graph.tree(
        "\(architecture)/dm2q-firmware",
        [.Place(TreePlace { path: "lib/firmware/qcom/sm8550/samsung/dm2q", artifact: adsp })]
    )
}
