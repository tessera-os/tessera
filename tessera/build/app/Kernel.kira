import Foundation
import Build

// The Tessera kernel (roadmap/02-kernel-and-syscalls.md): the pinned Linux release under the
// patches in patches/linux, configured as the architecture's defconfig with
// the Tessera fragments in kernel/config merged over it, and the uapi headers
// a userland is built against, installed from the same tree and the same make.
// The tarball is downloaded from kernel.org and checked against
// kernel/SHA256.
//
// The kernel is built incrementally: its unpacked tree and kbuild output live
// under the host's build root, never in the checkout's command workspace.
// Keeping the large source tree on the host filesystem avoids slow per-file
// operations on a Cairn-mounted checkout. kbuild's dependency tracking keeps
// the output correct between runs.

struct KernelBuild {
    // The image QEMU boots.
    let image: Artifact
    // The sanitised headers, as `headers_install` writes them.
    let headers: Artifact
    // The profile's device trees, at their paths under arch/<arch>/boot/dts.
    // Empty for QEMU, which builds its own.
    let devicetrees: Artifact
}

namespace KernelLayout {
    // The file naming the pinned release.
    let version: String = "kernel/VERSION"
    // The SHA-256 of the release's tarball.
    let digest: String = "kernel/SHA256"
    // www.kernel.org: the cdn host speaks only TLS 1.2, and the Build
    // library's Network only TLS 1.3.
    let mirror: String = "https://www.kernel.org/pub/linux/kernel"
    let configs: String = "kernel/config"
    let patches: String = "patches/linux"
    // Every build of one tree reads as the same build: what a kernel prints
    // as its build time, user and host. The time is in UTC and after the
    // epoch: the built-in initramfs's cpio refuses a negative one, which is
    // what a bare 1970-01-01 is east of Greenwich.
    let timestamp: String = "2000-01-01 00:00:00 UTC"
    let builder: String = "tessera"
}

// The kernel for `context`'s architecture, or what is missing for it.
function kernelBuild(
    graph: borrow mut Graph,
    context: borrow BuildContext,
    profile: borrow String
) -> Result<KernelBuild, String> {
    let root = graph.root
    let version = match readFile(joinedPath(root, KernelLayout.version)) {
        Ok(contents) -> contents.text.trim()
        Error(failure) -> {
            absorb failure
            return .Error("no \(KernelLayout.version)")
        }
    }
    let digest = match readFile(joinedPath(root, KernelLayout.digest)) {
        Ok(contents) -> contents.text.trim()
        Error(failure) -> {
            absorb failure
            return .Error("no \(KernelLayout.digest)")
        }
    }
    let series = version.split(".")[0]
    let devicetree = match profile {
        "dm2q" -> "qcom/sm8550-samsung-dm2q.dtb"
        "akari" -> "qcom/sdm845-sony-xperia-tama-akari.dtb"
        "akatsuki" -> "qcom/sdm845-sony-xperia-tama-akatsuki.dtb"
        else -> ""
    }
    let fragment = profile == "qemu"
    ? "\(KernelLayout.configs)/tessera-\(context.architecture.name()).config"
    : "\(KernelLayout.configs)/tessera-\(profile).config"
    let tarball = graph.download(
        "kernel/linux-\(version).tar.xz",
        "\(KernelLayout.mirror)/v\(series).x/linux-\(version).tar.xz",
        digest
    )
    let architecture = context.architecture
    let workspace = profile == "qemu"
    ? "kernel-\(architecture.name())"
    : "kernel-\(architecture.name())-\(profile)"
    let source = context.host.buildRoot + "/src/linux-\(version)"
    let output = context.host.buildRoot + "/out/\(architecture.name())/kernel/\(profile)"
    let label = profile == "qemu"
    ? "kernel \(version) (\(architecture.name()))"
    : "kernel \(version) (\(architecture.name()), \(profile))"
    let none: [String] = []
    let kernelHostHeaders = hostHeaders(graph, context)
    let persistentHostHeaders = context.host.buildRoot + "/host-include"
    let cross = architecture == context.host.architecture ? "" : architecture.multiarch() + "-"
    var environment = [
        EnvironmentEntry { name: "PATH", value: copy context.host.path },
        EnvironmentEntry { name: "HOME", value: copy context.host.home },
        EnvironmentEntry { name: "KBUILD_BUILD_TIMESTAMP", value: KernelLayout.timestamp },
        EnvironmentEntry { name: "KBUILD_BUILD_USER", value: KernelLayout.builder },
        EnvironmentEntry { name: "KBUILD_BUILD_HOST", value: KernelLayout.builder }
    ]
    var variables: [CommandVariable] = []
    if context.host.darwin {
        // `LLVM=<dir>/` takes clang, the assembler, ld.lld and the binutils
        // from the bundle that links the userland. Darwin's `ld` cannot link a
        // Linux kernel. Host tools such as sorttable include <elf.h> and
        // <byteswap.h>, which hostHeaders makes, and certs/extract-cert finds
        // Homebrew's keg-only OpenSSL through pkg-config.
        environment.append(EnvironmentEntry { name: "LLVM", value: context.host.llvm + "/bin/" })
        environment.append(EnvironmentEntry { name: "LLVM_IAS", value: "1" })
        variables.append(
            CommandVariable {
                name: "HOSTCFLAGS",
                value: .Joined([.Text("-I"), .Text(persistentHostHeaders)])
            }
        )
        environment.append(
            EnvironmentEntry {
                name: "PKG_CONFIG_PATH",
                value: "/opt/homebrew/opt/openssl@3/lib/pkgconfig"
            }
        )
    }
    let built = graph.command(
        CommandAction {
            label: label,
            tool: "sh",
            arguments: [
                .Text("-c"),
                .Text(kernelScript()),
                .Input(tarball),
                .Input(graph.sourceTree(KernelLayout.patches, none)),
                .Input(graph.source("\(KernelLayout.configs)/tessera-common.config")),
                .Input(graph.source(fragment)),
                .Output("image"),
                .Output("uapi"),
                .Text(architecture.kbuild()),
                .Text(cross),
                .Text(architecture.kernelImage()),
                .Workspace,
                .Text(source),
                .Text(output),
                .Input(kernelHostHeaders),
                .Text(persistentHostHeaders),
                .Output("devicetrees"),
                .Text(devicetree)
            ],
            environment: environment,
            variables: variables,
            outputs: [
                Output { name: "image" },
                Output { name: "uapi", kind: .Tree },
                Output { name: "devicetrees", kind: .Tree }
            ],
            workspace: workspace
        }
    )
    return .Ok(KernelBuild { image: built[0], headers: built[1], devicetrees: built[2] })
}

// The headers the kernel's host tools include and Darwin lacks. They are for
// programs that run on the build host: modpost and sorttable are written
// against glibc. <elf.h> is glibc's, from the sysroot, and <byteswap.h> three
// macros over compiler builtins, which Darwin has without the header.
function hostHeaders(graph: borrow mut Graph, context: borrow BuildContext) -> Artifact {
    let name = context.architecture.name()
    let byteswap = graph.write(
        "\(name)/host-include/byteswap.h",
        "#ifndef TESSERA_BYTESWAP_H\n#define TESSERA_BYTESWAP_H\n#define bswap_16(x) __builtin_bswap16(x)\n#define bswap_32(x) __builtin_bswap32(x)\n#define bswap_64(x) __builtin_bswap64(x)\n#endif\n",
        FileMode.data
    )
    return graph.tree(
        "\(name)/host-include",
        [
            .Place(
                TreePlace {
                    path: "elf.h",
                    artifact: sysrootFile(graph, context, "usr/include/elf.h"),
                    mode: FileMode.data
                }
            ),
            .Place(TreePlace { path: "byteswap.h", artifact: byteswap, mode: FileMode.data })
        ]
    )
}

// The kernel's build, as one command: `sh -c` hands it the tarball, the patch
// directory, the two fragments, the image and header outputs, `ARCH`,
// `CROSS_COMPILE`, the image's path in the output directory and the kept
// workspace, as $0 to $9, then the source and output directories, the host
// headers, the device-tree output and the profile's device tree, which may be
// empty. kbuild's output is the tree's `build` directory. The
// tree is unpacked and patched again only when the
// tarball's name or a patch changed, and configured again only when that or a
// fragment changed; make then rebuilds what changed. Only the selected kernel
// vmlinux and the selected image are requested, leaving kbuild to decide which
// objects it needs and ensuring link-only config changes reach vmlinux.
function kernelScript() -> String {
    let lines = [
        "set -e",
        "tarball=$0 patches=$1 common=$2 fragment=$3 image=$4 headers=$5 arch=$6 cross=$7 built=$8 workspace=$9",
        "source=\"${10}\" output=\"${11}\" host_headers_input=\"${12}\" persistent_host_headers=\"${13}\"",
        "devicetrees=\"${14}\" devicetree=\"${15}\"",
        "image_target=${built##*/}",
        "source_stamp=\"$source.stamp\"",
        "config_stamp=\"$output/.tessera-config.stamp\"",
        "link_config_stamp=\"$output/.tessera-link-config.stamp\"",
        "unpacked=$({ basename \"$tarball\"; cat \"$patches\"/*.patch 2> /dev/null || true; } | sha256sum | cut -d' ' -f1)",
        "if [ \"$(cat \"$source_stamp\" 2> /dev/null)\" != \"$unpacked\" ]; then",
        "    rm -rf \"$source\" \"$source_stamp\"",
        "    mkdir -p \"$source\"",
        "    tar -xf \"$tarball\" -C \"$source\" --strip-components=1",
        "    for patch in \"$patches\"/*.patch; do [ -e \"$patch\" ] && patch -s -p1 -d \"$source\" < \"$patch\"; done",
        "    echo \"$unpacked\" > \"$source_stamp\"",
        "fi",
        "if [ \"$(uname -s)\" = Darwin ]; then",
        "    sdk=$(xcrun --show-sdk-path)",
        // Host kbuild tools are macOS executables. The bundled ld64.lld
        // cannot read macOS 27 SDK TAPI files, so use Apple's ld for these
        // host tools without changing the linker used for the Linux kernel.
        "    export HOSTCFLAGS=\"-isysroot $sdk -I$source/scripts/include $HOSTCFLAGS\" HOSTLDFLAGS=\"-isysroot $sdk -fuse-ld=/usr/bin/ld\"",
        "fi",
        "mkdir -p \"$persistent_host_headers\"",
        "for header in elf.h byteswap.h; do",
        "    if ! cmp -s \"$host_headers_input/$header\" \"$persistent_host_headers/$header\"; then",
        "        cp \"$host_headers_input/$header\" \"$persistent_host_headers/$header\"",
        "    fi",
        "done",
        // arm64's Image rule has a phony vmlinux prerequisite, which if_changed
        // filters from timestamp checks. Add a real link-config prerequisite so
        // the raw Image follows the vmlinux just linked above.
        "if [ \"$arch\" = arm64 ] && ! grep -q TESSERA_LINK_CONFIG_STAMP \"$source/arch/arm64/boot/Makefile\"; then",
        "    printf '\\n# Tessera tracks link-only config changes for the raw Image.\\n$(obj)/Image: $(TESSERA_LINK_CONFIG_STAMP)\\n' >> \"$source/arch/arm64/boot/Makefile\"",
        "fi",
        "kernel() { TESSERA_LINK_CONFIG_STAMP=\"$output/.tessera-link-config.stamp\" make -s -C \"$source\" O=\"$output\" ARCH=\"$arch\" CROSS_COMPILE=\"$cross\" \"$@\"; }",
        "configured=$({ echo \"$unpacked $arch\"; cat \"$common\" \"$fragment\"; } | sha256sum | cut -d' ' -f1)",
        "if [ ! -f \"$output/.config\" ] || [ \"$(cat \"$config_stamp\" 2> /dev/null)\" != \"$configured\" ]; then",
        "    mkdir -p \"$output\"",
        "    rm -f \"$config_stamp\"",
        "    kernel defconfig",
        "    \"$source/scripts/kconfig/merge_config.sh\" -m -O \"$output\" \"$output/.config\" \"$common\" \"$fragment\" > /dev/null",
        "    kernel olddefconfig",
        "    echo \"$configured\" > \"$config_stamp\"",
        "fi",
        // link-vmlinux.sh reads link-only CONFIG_* settings from auto.conf;
        // Kbuild does not track that shell read as a prerequisite. Make the
        // script newer when the effective config changes so Kbuild relinks
        // vmlinux while retaining its normal per-object dependency checks.
        "link_config=$({ printf '%s\\n' \"$unpacked $arch\"; cat \"$output/.config\"; } | sha256sum | cut -d' ' -f1)",
        "if [ \"$(cat \"$link_config_stamp\" 2> /dev/null)\" != \"$link_config\" ]; then",
        "    touch \"$source/scripts/link-vmlinux.sh\"",
        "    echo \"$link_config\" > \"$link_config_stamp\"",
        "fi",
        "kernel -j\"$(nproc)\" vmlinux",
        "kernel -j\"$(nproc)\" \"$image_target\"",
        "cp \"$output/$built\" \"$image\"",
        "mkdir -p \"$devicetrees\"",
        "if [ -n \"$devicetree\" ]; then",
        "    kernel \"$devicetree\"",
        "    mkdir -p \"$devicetrees/$(dirname \"$devicetree\")\"",
        "    cp \"$output/arch/$arch/boot/dts/$devicetree\" \"$devicetrees/$devicetree\"",
        "fi",
        "kernel INSTALL_HDR_PATH=\"$headers\" headers_install",
        "test -f \"$headers/include/linux/socket.h\""
    ]
    return textLines(lines)
}
