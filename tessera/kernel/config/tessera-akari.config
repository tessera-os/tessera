# Experimental Sony Xperia XZ2 (akari / SDM845) profile.
# DT: qcom/sdm845-sony-xperia-tama-akari.dtb from upstream Linux.
# Internal UFS enablement follows Shujath Mohd's September 2026 Tama patch.
# Historically, probing Tama UFS risked BOOTLOADER ERASURE. That risk has not
# been independently disproved on the actual Tessera target. DO NOT FLASH.

# Android-compatible page size, not QEMU-on-Apple's 16 KB pages.
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_16K_PAGES is not set
# Tessera runs 64-bit Kira userland only. Host LLVM has no ARM32 codegen for
# Linux's compat vDSO, and this device does not need AArch32 compatibility.
# CONFIG_COMPAT is not set

CONFIG_ARCH_QCOM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Qualcomm DPU drives the TD4353 JDI LCD; Synaptics RMI4 F12 is touch.
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_PANEL_SONY_TD4353_JDI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_REGULATOR=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y
CONFIG_I2C_QCOM_GENI=y

# Native USB2 peripheral for early diagnostics; the USB console requires
# hardware validation. This does not implement a Tessera flashing transport.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# Built-in Qualcomm UFS storage is required before the early initramfs starts.
# The new DT supplies its reset GPIO 150 and VCC/PHY regulators.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# Do not expose UFS BSG diagnostic pass-through to untrusted userspace.
# CONFIG_SCSI_UFS_BSG is not set

# No module loader in Tessera's first-stage userspace.
# CONFIG_MODULES is not set