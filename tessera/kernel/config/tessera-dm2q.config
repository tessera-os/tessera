# 4 KB arm64 profile for the Samsung Galaxy S23+ (SM-S916B/DS, device
# codename dm2q, Qualcomm SM8550). The device tree is
# qcom/sm8550-samsung-dm2q.dtb from patches/linux; scripts/package-dm2q-update.py
# puts it in the vendor_boot image.

CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# The phone's userspace ABI uses 4 KB pages. Do not inherit the QEMU profile's
# 16 KB choice.
# CONFIG_ARM64_16K_PAGES is not set

# Qualcomm platform support and a serial console for early bring-up.
CONFIG_ARCH_QCOM=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# UFS holds SUPER and CACHE, which the installer and system boot use.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# The QMP umbrella is a module in defconfig, which caps the UFS PHY at =m:
# the initramfs loads no modules, so UFS would wait for its PHY forever.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# The S6E3FAC panel has no mainline driver. The bootloader leaves it lit and
# scanning out of the splash region, which simpledrm drives as /dev/dri/card0.
CONFIG_SYSFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_PANIC=y

# Adreno 740 for Vulkan through Mesa Turnip, as a render-only device
# (msm.separate_gpu_kms=1 on the command line). Its firmware is read from the
# root filesystem when the render node is first opened.
# DRM_MSM depends on LLCC and OCMEM being "y or n", and both are modules in
# defconfig, which would cap DRM_MSM at =m.
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_SM_GPUCC_8550=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_DRM_MSM=y

# The display PMIC (S2DOS05) on a bit-banged I2C bus powers the panel and the
# touch controller, which sits on a bit-banged SPI bus.
CONFIG_I2C_GPIO=y
CONFIG_MFD_SEC_I2C=y
CONFIG_REGULATOR_S2DOS05=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FTS2BA61Y=y

# Boot log channel and dev root transport. g_multi exposes the CDC ACM
# console and a removable mass-storage LUN together. The phone puts a FAT
# image in the LUN so a Mac can exchange devroot requests over USB. Built in:
# both must work before any module can load. The PHY path is the eUSB2 PHY
# behind the PTN3222 repeater on the GENI I2C bus. Ramoops keeps logs across
# a warm reset in reserved memory.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_G_MULTI=y
# Use the CDC ECM profile on macOS, with ACM serial and mass storage alongside
# it. The FAT exchange volume needs VFAT built in because modules do not load.
# CONFIG_USB_G_MULTI_RNDIS is not set
CONFIG_USB_G_MULTI_CDC=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FAT_DEFAULT_UTF8=y
# The rest of USB, built in as nothing loads modules yet. The controller is
# dual-role: a peripheral by default, a host when its role switch says so
# (from the ADSP's UCSI once its firmware runs, or written by hand in
# /sys/class/usb_role). Every gadget function, for what the system composes
# through configfs: serial, mass storage (the dev root's transfer volume),
# network, and FunctionFS for user-space functions.
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_FS=y
CONFIG_USB_F_HID=y
CONFIG_USB_ONBOARD_DEV=y
# The SuperSpeed side of the port (the QMP USB3/DP combo PHY) and what it
# depends on for orientation and DisplayPort hot plug.
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_DRM_AUX_BRIDGE=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
# Type-C: the connector's role and orientation, reported by the ADSP through
# pmic_glink's UCSI, which needs the ADSP running: its remoteproc, the QRTR
# bus it speaks on, and the protection-domain mapper.
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y
# The MAX77705 companion PMIC owns the USB-C port (patches 0009-0020): its
# Type-C/PD controller sets the controller's role and routes D+/D- to USB,
# its charger charges the battery and sources VBUS for a USB device, and its
# fuel gauge measures the battery.
CONFIG_MFD_MAX77705=y
CONFIG_CHARGER_MAX77705=y
CONFIG_TYPEC_MAX77705=y
CONFIG_BATTERY_MAX17042=y
CONFIG_REGULATOR=y
CONFIG_POWER_SUPPLY=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# The console also goes into Samsung's sec_log_buf ring, which survives the
# kernel's own warm reboot and reads back as /proc/last_kmsg from a Samsung
# recovery: the log of a boot that dies before USB is up.
CONFIG_SAMSUNG_SEC_LOG_CONSOLE=y

# Keep the raw arm64 Image within the phone's BOOT partition. Function symbols
# remain useful for early crash reports; data symbols are not needed at runtime.
# CONFIG_KALLSYMS_ALL is not set

# Only the Qualcomm platform. The stock bootloader is used to a ~47 MB
# Qualcomm-only kernel; defconfig with every SoC family built in is twice that.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# CONFIG_ACPI is not set

# A console font readable on the 1080x2340 panel (fbcon picks 16x32 on a
# high-resolution screen), and the boot logo.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# Trimmed toward the stock ~45 MB kernel, which is all the stock bootloader is
# known to load. Only what a phone never uses goes: desktop and server
# hardware, and other vendors' Wi-Fi chips. Wi-Fi (ath12k for the WCN7850),
# Bluetooth, sound, cameras, sensors, NFC and USB networking stay.
# CONFIG_ETHERNET is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MTD is not set
# CONFIG_INFINIBAND is not set
# CONFIG_CAN is not set
# CONFIG_KVM is not set
# CONFIG_STAGING is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_FTRACE is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set

# Drivers the phone loads after boot are modules, as on the stock GKI kernel:
# built in, defconfig would put every SoC family into one ~97 MB Image, far
# beyond the ~45 MB the stock bootloader is known to load. What boot needs
# (UFS, clocks, pinctrl, regulators, simpledrm, fbcon, btrfs, squashfs) stays
# built in above.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
