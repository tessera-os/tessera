import Foundation
import Heap
import LibTessera

// Relaying a service's standard output and error to the console.
//
// Each service writes to a channel of its own, which PID 1 reads and writes
// to its own standard output one line at a time, after the service's name:
// `notes: saved`. A line the service has not finished waits for the rest of
// it, and is written as it is when the service closes its output.

namespace OutputRelay {
    // The most one read takes. A larger write is read in one larger block.
    let readBytes: Number = 65536
    // The most one console write holds: under the 1024 bytes a record of the
    // kernel's log takes, after its own prefix.
    let consoleBytes: Number = 960
    // The longest piece a line is cut into, in characters: four bytes each
    // at most, so a piece fits one write.
    let lineCharacters: Number = 240
}

// Asks for a completion on `port` when the service in `slot` writes or
// closes its output.
function watchOutput(fleet: borrow Fleet, slot: Number, port: Handle) {
    if fleet.outputs[slot] == Handle.invalid { return }
    match objectWaitAsync(
        fleet.outputs[slot],
        Signals.readable | Signals.peerClosed,
        .Once,
        port,
        slotKey(fleet, slot, .Output)
    ) {
        Ok -> {}
        Error(failed) -> log warn(
            "cannot read a service's output",
            service: fleet.services[slot].name,
            error: errorName(failed)
        )
    }
}

// Writes what the service in `slot` has written since the last time, and
// answers whether its output is still open and worth waiting on again.
function relayOutput(fleet: borrow mut Fleet, slot: Number) -> Result<Bool, TesseraError> {
    var size = OutputRelay.readBytes
    while fleet.outputs[slot] != Handle.invalid {
        let block = zeroedBlock(count: size, alignment: 16)
        match channelRead(
            fleet.outputs[slot],
            Buffer { address: block.pointer(), length: size },
            0
        ) {
            Ok(received) -> {
                releaseAll(received.handles)
                size = OutputRelay.readBytes
                relayText(fleet, slot, textOf(block.pointer(), received.bytes))
            }
            Error(failed) -> {
                match failed.code {
                    ShouldWait -> return .Ok(true)
                    BufferTooSmall -> { size = failed.detail }
                    else -> {
                        closeOutput(fleet, slot)
                        if failed.code != .PeerClosed { return .Error(failed) }
                    }
                }
            }
        }
    }
    return .Ok(false)
}

// A port means keep relaying later; none means drain only what is available.
function handleOutput(fleet: borrow mut Fleet, slot: Number, port: borrow Handle?) {
    match relayOutput(fleet, slot) {
        Ok(open) -> {
            if open {
                match port {
                    Some(value) -> watchOutput(fleet, slot, value)
                    None -> {}
                }
            }
        }
        Error(failed) -> log warn(
            "could not read a service's output",
            service: fleet.services[slot].name,
            error: errorName(failed)
        )
    }
}

// Writes every line `text` ends, and keeps the line it begins. The console
// takes them in as few writes as fit `OutputRelay.consoleBytes`: each is a
// trip through the serial port, and the kernel's log, which the console is
// when `tessera.logpart` is set, refuses a longer one.
function relayText(fleet: borrow mut Fleet, slot: Number, text: String) {
    let pieces = (fleet.partial[slot] + text).split("\n")
    var console: [String] = []
    var bytes: Number = 0
    for index in 0..pieces.count - 1 {
        writeSystemLog(fleet.systemLog, fleet.services[slot].name, pieces[index])
        for part in consoleParts("\(fleet.services[slot].name): \(pieces[index])") {
            let size = part.utf8().count + 1
            if console.count > 0 && bytes + size > OutputRelay.consoleBytes {
                print(joined(console, "\n"))
                console = []
                bytes = 0
            }
            console.append(copy part)
            bytes += size
        }
    }
    if console.count > 0 { print(joined(console, "\n")) }
    fleet.partial[slot] = copy pieces[pieces.count - 1]
}

// `line` in pieces of at most `OutputRelay.lineCharacters` characters.
function consoleParts(line: String) -> [String] {
    var parts: [String] = []
    var start: Number = 0
    while line.count - start > OutputRelay.lineCharacters {
        parts.append(line.substring(start, start + OutputRelay.lineCharacters))
        start += OutputRelay.lineCharacters
    }
    parts.append(line.substring(start, line.count))
    return parts
}

// Writes the line the service left unfinished, and lets its output go.
function closeOutput(fleet: borrow mut Fleet, slot: Number) {
    if fleet.partial[slot].count > 0 {
        for part in consoleParts("\(fleet.services[slot].name): \(fleet.partial[slot])") {
            print(part)
        }
        writeSystemLog(fleet.systemLog, fleet.services[slot].name, fleet.partial[slot])
        fleet.partial[slot] = ""
    }
    release(fleet.outputs[slot])
    fleet.outputs[slot] = Handle.invalid
}
