import Foundation
import Heap

// What a program asks of PID 1 about applications, as NSWorkspace asks
// launchd: open, install or uninstall one; and what the running platform asks,
// to switch to another. PID 1 does it; a program never
// starts a process, and never holds a handle to anything it opens.
//
// A request is the service header (`ServiceMessage`) followed by the path,
// with the path's byte count in the header's detail word, sent on the
// channel PID 1 started the program with. It carries one end of a new
// channel, and PID 1 writes a sentence for the person on it when there is
// something to say: that an application was installed, or why one could not
// be opened. An application that opened says nothing; PID 1 closes the
// channel.

// What a program asks of PID 1, with the path it names.
public enum WorkspaceRequest {
    // The bundle to open.
    Open(String)
    // The bundle, at the top of a disk image in /Volumes, to install.
    Install(String)
    // The installed bundle, `/Applications/<Name>.app`, to uninstall.
    Uninstall(String)
    // The Dynamic Platform to switch to, a `platform.dynamic` value. Only the
    // running platform asks it.
    SwitchPlatform(String)
    // One explicitly selected File for the system Notes editor. `editable`
    // requests an additional write grant, never a filesystem path.
    OpenDocument(DocumentOpenRequest)
}

public struct DocumentOpenRequest {
    let file: Handle
    let editable: Bool
}

public namespace WorkspaceDocument {
    let notesExecutable: String = "/System/Applications/Notes.app/Contents/MacOS/Notes"
}

/// The document-open request reuses the otherwise fixed workspace serial
/// word. Its wire values are stable: one means read, two means edit.
@Derive(Copy)
public enum WorkspaceDocumentMode: U32 {
    Read = 1
    Edit = 2
}

/// Unknown modes never become read or edit grants through numeric fallback.
public function workspaceDocumentMode(raw: U32) -> WorkspaceDocumentMode? {
    return match raw {
        1 -> .Some(.Read)
        2 -> .Some(.Edit)
        else -> .None
    }
}

// Why a request is not asked at all.
public enum WorkspaceRefusal {
    // Only an application on a disk image is installed.
    NotOnDiskImage
    // Only an application installed from a disk image is uninstalled.
    NotInstalledImage
}

// Why a request did not reach PID 1.
public enum WorkspaceRequestFailure {
    EmptyPath
    // The path's byte count, past what PID 1 reads.
    PathTooLong(Number)
    // This process was started without a channel to PID 1.
    NoServiceChannel
    NoAnswerChannel(TesseraError)
    NotSent(TesseraError)
    // The request was not sent, and the answer's channel would not close.
    NotClosed(TesseraError)
}

// What reading PID 1's answer found.
public enum WorkspaceAnswer {
    // Nothing has arrived yet.
    NotYet
    // PID 1 had something to say.
    Said(String)
    // An explicit document-launch acknowledgement from PID 1.
    DocumentOpened
    // PID 1 closed the channel without a word: the request did what it asked.
    Silent
}

/// The document-open success acknowledgement has no path or file contents.
/// Its exact header must match; a generic channel closure is not proof.
public function validDocumentOpenedReply(
    opcode: U32,
    total: Number,
    serial: U32,
    detail: Number
) -> Bool {
    return opcode == ServiceOpcode.DocumentOpened.rawValue()
        && total == ServiceMessage.headerBytes
        && serial == WorkspaceHeader.serial
        && detail == 0
}

// Why an answer could not be read.
public enum WorkspaceAnswerFailure {
    Unreadable(TesseraError)
    // The bytes were not an `Answer` service message; their count.
    Malformed(Number)
}

// Where the header's words sit, and what they say.
namespace WorkspaceHeader {
    let opcodeAt: Number = 0
    let lengthAt: Number = 4
    let serialAt: Number = 8
    let detailAt: Number = 12
    // Each request is answered on a channel of its own, so serials are never
    // told apart.
    let serial: U32 = WorkspaceDocumentMode.Read.rawValue()
}

namespace WorkspaceLimit {
    // The longest bundle path a request carries; PID 1 reads no more.
    let pathBytes: Number = 240
    // The longest answer read.
    let answerBytes: Number = 512
}

extend Application {
    // The request that opens this application.
    function openRequest(borrow self) -> WorkspaceRequest {
        return .Open(opened())
    }

    // The request that installs this application in /Applications, from the
    // disk image it is on.
    function installRequest(borrow self) -> Result<WorkspaceRequest, WorkspaceRefusal> {
        return match place {
            DiskImage -> .Ok(.Install(path()))
            System, Applications, InstalledImage -> .Error(.NotOnDiskImage)
        }
    }

    // The request that uninstalls this application, an image installed from a
    // disk image. Its documents are kept.
    function uninstallRequest(borrow self) -> Result<WorkspaceRequest, WorkspaceRefusal> {
        return match place {
            InstalledImage -> .Ok(.Uninstall(path()))
            System, Applications, DiskImage -> .Error(.NotInstalledImage)
        }
    }
}

// The service opcode `request` is sent under.
function requestOpcode(request: borrow WorkspaceRequest) -> ServiceOpcode {
    return match request {
        Open -> .Launch
        Install -> .Install
        Uninstall -> .Uninstall
        SwitchPlatform -> .SwitchPlatform
        OpenDocument -> .OpenDocument
    }
}

function requestPath(request: borrow WorkspaceRequest) -> String {
    return match request {
        Open(path) -> copy path
        Install(path) -> copy path
        Uninstall(path) -> copy path
        SwitchPlatform(name) -> copy name
        OpenDocument -> WorkspaceDocument.notesExecutable
    }
}

// The request's bytes on the wire. Exposed for tests and trusted protocol
// inspectors; the selected File remains an out-of-band capability handle.
public function encodedRequest(
    request: borrow WorkspaceRequest
) -> Result<ByteBlock, WorkspaceRequestFailure> {
    let bytes = requestPath(request).utf8()
    if bytes.count == 0 { return .Error(.EmptyPath) }
    if bytes.count > WorkspaceLimit.pathBytes { return .Error(.PathTooLong(bytes.count)) }
    let header = ServiceMessage.headerBytes
    let total = header + bytes.count
    let body = zeroedBlock(count: total, alignment: 16)
    blockStore<U32>(body, WorkspaceHeader.opcodeAt, requestOpcode(request).rawValue())
    blockStore<U32>(body, WorkspaceHeader.lengthAt, total)
    // A reply has a private channel, so the serial doubles as the explicit
    // document mode for this one opcode: 1 = read, 2 = edit.
    let serial: U32 = match request {
        OpenDocument(selected) -> selected.editable
            ? WorkspaceDocumentMode.Edit.rawValue()
            : WorkspaceDocumentMode.Read.rawValue()
        Open, Install, Uninstall, SwitchPlatform -> WorkspaceHeader.serial
    }
    blockStore<U32>(body, WorkspaceHeader.serialAt, serial)
    blockStore<U32>(body, WorkspaceHeader.detailAt, bytes.count)
    for (index, byte) in bytes.enumerated() { blockStore<U8>(body, header + index, byte) }
    return .Ok(move body)
}

// Channel.write moves transferred handles after its transfer checks. When
// the channel or its rights are invalid, it returns before consuming them.
// Close only the still-owned reply end; the caller retains responsibility
// for a document File on an unsuccessful request.
function closeUntransferredReply(handle: Handle) {
    match handleInfo(handle) {
        Ok(info) -> {
            absorb info
            match handleClose(handle) {
                Ok -> {}
                Error(reason) -> absorb reason
            }
        }
        Error(reason) -> absorb reason
    }
}

// Asks PID 1 for `request`. The channel its answer comes on, which is the
// caller's to read with `readWorkspaceAnswer` and to close.
public function askWorkspace(
    request: borrow WorkspaceRequest
) -> Result<Handle, WorkspaceRequestFailure> {
    let body = try encodedRequest(request)
    let channel = try startupHandle(StartupTag.parentChannel) otherwise return .Error(
        .NoServiceChannel
    )
    let pair = match channelCreate() {
        Ok(value) -> value
        Error(failure) -> return .Error(.NoAnswerChannel(failure))
    }
    var carried: [Handle] = [pair.second]
    match request {
        OpenDocument(selected) -> carried.append(selected.file)
        Open, Install, Uninstall, SwitchPlatform -> {}
    }
    let buffer = Buffer { address: body.pointer(), length: body.count }
    return match channelWrite(channel, buffer, carried) {
        Ok -> .Ok(pair.first)
        Error(failure) -> {
            closeUntransferredReply(pair.second)
            return match handleClose(pair.first) {
                Ok -> .Error(.NotSent(failure))
                Error(closing) -> .Error(.NotClosed(closing))
            }
        }
    }
}

// What PID 1 answered on `channel`, the channel `askWorkspace` gave.
public function readWorkspaceAnswer(
    channel: Handle
) -> Result<WorkspaceAnswer, WorkspaceAnswerFailure> {
    let body = zeroedBlock(count: WorkspaceLimit.answerBytes, alignment: 16)
    let buffer = Buffer { address: body.pointer(), length: WorkspaceLimit.answerBytes }
    let message = match channelRead(channel, buffer, 0) {
        Ok(value) -> value
        Error(failure) -> {
            if failure.code == .ShouldWait { return .Ok(.NotYet) }
            if failure.code == .PeerClosed { return .Ok(.Silent) }
            return .Error(.Unreadable(failure))
        }
    }
    let count = message.bytes
    let header = ServiceMessage.headerBytes
    if count < header { return .Error(.Malformed(count)) }
    let opcode: U32 = blockLoad<U32>(body, WorkspaceHeader.opcodeAt)
    let length: Number = blockLoad<U32>(body, WorkspaceHeader.detailAt)
    let serial: U32 = blockLoad<U32>(body, WorkspaceHeader.serialAt)
    if validDocumentOpenedReply(opcode, count, serial, length) {
        return .Ok(.DocumentOpened)
    }
    if opcode != ServiceOpcode.Answer.rawValue() || header + length != count {
        return .Error(.Malformed(count))
    }
    return .Ok(.Said(stringFromCBytes(heapOffset(body.pointer(), header), length)))
}
