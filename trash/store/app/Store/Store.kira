//! The Trash on the data volume: moving items in and out, and the records of where each came from.
import Foundation
import LibTessera
import TrashRules

// The Trash on the data volume (roadmap/19, decisions in its Decisions
// section): `/data/Trash/items` holds each item, renamed in whole, and
// `/data/Trash/records` holds one record per item, which names where the item
// was.
//
// A record is text: a version line, then `path` and the item's absolute
// path. It is written before the item moves, so an item in the Trash has a
// record unless the record was lost; an item found with no record has no
// known origin.

// The path and record rules are in TrashRules, which can run on a host
// without LibTessera's Linux-only system calls.
function refusalOf(path: borrow String) -> Result<Void, ErrorCode> {
    return match trashPathStatus(path) {
        Allowed -> .Ok
        Invalid -> .Error(.InvalidPath)
        Protected -> .Error(.AccessDenied)
    }
}

// Refuse even existing ordinary-looking Trash directories when an ancestor
// (including /data itself) is a symbolic link. The Trash service runs with
// filesystem privileges; it must not follow an alias to an unrelated volume.
function safeTrashFolders() -> Bool {
    return !hasLinkParent(TrashLayout.root)
        && !hasLinkParent(TrashLayout.items)
        && !hasLinkParent(TrashLayout.records)
}

/// Whether no item or record already has `id`.
function isFreeId(id: borrow String) -> Bool {
    return !occupiedTrashEntry(TrashLayout.items + "/" + id)
        && !occupiedTrashEntry(TrashLayout.records + "/" + id)
}

/// The first id no item or record has, or the reason there is none.
function freshId() -> Result<String, ErrorCode> {
    for number in 1..1000000 {
        let id = String(number)
        if isFreeId(id) { return .Ok(id) }
    }
    return .Error(.NoSpace)
}

/// Makes `path` a directory if it is not one already.
function ensureDirectory(path: borrow String) -> Result<Void, ErrorCode> {
    match linkStatus(path) {
        Ok(status) -> return status.kind == .Directory ? .Ok : .Error(.AccessDenied)
        Error(failure) -> absorb failure
    }
    match makeDirectory(path) {
        Ok -> return .Ok
        Error(failed) -> {
            // The Trash wire protocol carries only ErrorCode; keep the
            // filesystem reason in the service log as well.
            log warn(
                "a Trash directory could not be created",
                path: path,
                failure: traceText(failed)
            )
            return .Error(.AccessDenied)
        }
    }
}

/// Makes the Trash's folders, if they are missing.
function ensureTrash() -> Result<Void, ErrorCode> {
    // Check each newly created path only after its parent has been verified.
    // hasLinkParent intentionally treats a *missing* ancestor as unsafe;
    // checking all three before creating root would break first boot.
    if hasLinkParent(TrashLayout.root) { return .Error(.AccessDenied) }
    match ensureDirectory(TrashLayout.root) {
        Ok -> {}
        Error(reason) -> return .Error(reason)
    }
    if hasLinkParent(TrashLayout.items) { return .Error(.AccessDenied) }
    match ensureDirectory(TrashLayout.items) {
        Ok -> {}
        Error(reason) -> return .Error(reason)
    }
    if hasLinkParent(TrashLayout.records) { return .Error(.AccessDenied) }
    return ensureDirectory(TrashLayout.records)
}

/// A bad record is not allowed to name a restore destination.
function originalOf(text: borrow String) -> Result<String, ErrorCode> {
    return match rawRecordPath(text) {
        Some(path) -> .Ok(path)
        None -> .Error(.BadState)
    }
}

/// Moves the item `id` back to the path its record names; a crash between the two steps leaves a record with no item, which the next start removes.
function putBack(id: borrow String) -> Result<Void, ErrorCode> {
    if !isItemId(id) { return .Error(.InvalidArgument) }
    if !safeTrashFolders() || !directDirectory(TrashLayout.root)
        || !directDirectory(TrashLayout.items) || !directDirectory(TrashLayout.records) {
        return .Error(.AccessDenied)
    }
    let recordPath = TrashLayout.records + "/" + id
    if !directTrashRecord(recordPath) { return .Error(.NotFound) }
    let text = match readFile(recordPath) {
        Ok(contents) -> contents.text
        Error(failed) -> {
            log warn(
                "a Trash record could not be read",
                path: recordPath,
                failure: traceText(failed)
            )
            return .Error(.NotFound)
        }
    }
    let original = match originalOf(text) {
        Ok(path) -> path
        Error(reason) -> return .Error(reason)
    }
    match refusalOf(original) {
        Ok -> {}
        Error(reason) -> return .Error(reason)
    }
    if !occupiedTrashEntry(TrashLayout.items + "/" + id) { return .Error(.NotFound) }
    if occupiedTrashEntry(original) { return .Error(.AlreadyExists) }
    if !isDirectory(parentOf(original)) { return .Error(.NotFound) }
    if hasLinkParent(original) { return .Error(.AccessDenied) }
    match renamePath(TrashLayout.items + "/" + id, original) {
        Ok -> {}
        Error(failed) -> {
            log warn(
                "a trashed item could not be put back",
                path: original,
                failure: traceText(failed)
            )
            return .Error(.Unsupported)
        }
    }
    match removePath(recordPath) {
        Ok -> {}
        Error(failed) -> {
            log warn(
                "a record could not be removed after its item was put back",
                path: recordPath,
                failure: traceText(failed)
            )
        }
    }
    log info("put an item back", id: id)
    return .Ok
}

/// Removes each record whose item is gone: a record is kept only while its item is in the Trash, and this runs at start, when a move may have been cut short.
function removeOrphanRecords() {
    // Never clean records through a linked directory, or assume items were
    // lost while their directory is unavailable.
    if !safeTrashFolders() || !directDirectory(TrashLayout.root)
        || !directDirectory(TrashLayout.items) || !directDirectory(TrashLayout.records) { return }
    let listing = match listDirectory(TrashLayout.records) {
        Ok(value) -> value
        Error(failed) -> {
            log warn("Trash records could not be listed", failure: traceText(failed))
            return
        }
    }
    for name in listing.entries {
        if !occupiedTrashEntry(TrashLayout.items + "/" + name) {
            match removePath(TrashLayout.records + "/" + name) {
                Ok -> {}
                Error(failed) -> log warn(
                    "an orphan Trash record could not be removed",
                    record: name,
                    failure: traceText(failed)
                )
            }
        }
    }
}

/// Moves the item at `path` into the Trash and answers its id; the record goes first, and if the item cannot move, the record is taken back.
function moveToTrash(path: borrow String) -> Result<String, ErrorCode> {
    match refusalOf(path) {
        Ok -> {}
        Error(reason) -> return .Error(reason)
    }
    if !occupiedTrashEntry(path) { return .Error(.NotFound) }
    if hasLinkParent(path) { return .Error(.AccessDenied) }
    match ensureTrash() {
        Ok -> {}
        Error(reason) -> return .Error(reason)
    }
    let id = match freshId() {
        Ok(value) -> value
        Error(reason) -> return .Error(reason)
    }
    let record = TrashLayout.records + "/" + id
    let text = TrashLayout.recordVersion + "\n" + TrashLayout.pathPrefix + path + "\n"
    match writeFile(record, text) {
        Ok -> {}
        Error(failed) -> {
            log warn(
                "a Trash record could not be written",
                path: record,
                failure: traceText(failed)
            )
            return .Error(.AccessDenied)
        }
    }
    match renamePath(path, TrashLayout.items + "/" + id) {
        Ok -> {
            log info("moved an item to the Trash", id: id)
            return .Ok(id)
        }
        Error(failed) -> {
            absorb failed
            // An item on another volume cannot be renamed into the Trash.
            // The record goes, so nothing names an item that did not move.
            match removePath(record) {
                Ok -> {}
                Error(gone) -> log warn(
                    "a failed Trash move's record could not be removed",
                    path: record,
                    failure: traceText(gone)
                )
            }
            return .Error(.Unsupported)
        }
    }
}

/// One item in the Trash: its id, and the path it was moved from, none when its record was lost.
struct TrashEntry {
    let id: String
    let original: String?
}

/// Every item in the Trash, by id, with where each came from.
function trashEntries() -> Result<[TrashEntry], ErrorCode> {
    if !safeTrashFolders() { return .Error(.AccessDenied) }
    if !occupiedTrashEntry(TrashLayout.root) || !occupiedTrashEntry(TrashLayout.items) {
        return .Ok([])
    }
    if !directDirectory(TrashLayout.root) || !directDirectory(TrashLayout.items) {
        return .Error(.AccessDenied)
    }
    if occupiedTrashEntry(TrashLayout.records) && !directDirectory(TrashLayout.records) {
        return .Error(.AccessDenied)
    }
    let listing = match listDirectory(TrashLayout.items) {
        Ok(value) -> value
        Error(failed) -> {
            log warn("the Trash could not be listed", failure: traceText(failed))
            return .Error(.AccessDenied)
        }
    }
    var entries: [TrashEntry] = []
    for id in listing.entries {
        if !isItemId(id) { continue }
        entries.append(TrashEntry { id: copy id, original: recordedOriginal(id) })
    }
    return .Ok(entries)
}

/// The path item `id`'s record names, none when it has no readable record.
function recordedOriginal(id: borrow String) -> String? {
    let record = TrashLayout.records + "/" + id
    if !directTrashRecord(record) { return .None }
    let text = match readFile(record) {
        Ok(contents) -> contents.text
        Error(failed) -> {
            // An item without a record has no known origin, as the
            // decisions say; it is still listed.
            absorb failed
            return .None
        }
    }
    return match originalOf(text) {
        Ok(path) -> .Some(path)
        Error(reason) -> {
            log warn("a Trash record is not in its form", id: id, reason: traceText(reason))
            .None
        }
    }
}

/// Removes every item and record in the Trash, so the Trash is empty afterwards.
function emptyTrash() -> Result<Void, ErrorCode> {
    let entries = match trashEntries() {
        Ok(value) -> value
        Error(reason) -> return .Error(reason)
    }
    for entry in entries {
        match removeAll(TrashLayout.items + "/" + entry.id) {
            Ok -> {}
            Error(reason) -> return .Error(reason)
        }
        match removePath(TrashLayout.records + "/" + entry.id) {
            Ok -> {}
            Error(failed) -> log warn(
                "an emptied item's record could not be removed",
                id: entry.id,
                failure: traceText(failed)
            )
        }
    }
    log info("emptied the Trash", count: entries.count)
    return .Ok
}

/// Removes a trashed tree without following links out of it.
function removeAll(path: borrow String) -> Result<Void, ErrorCode> {
    match removeTrashTree(path) {
        Ok -> return .Ok
        Error(failed) -> {
            log warn("a trashed item could not be deleted", path: path, failure: traceText(failed))
            return .Error(.AccessDenied)
        }
    }
}
