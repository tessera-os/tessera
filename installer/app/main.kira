//! The installer's entry point: serves install requests from init, or installs the version asked for.
// Tessera's installer (roadmap/05-storage-and-state.md). It is the only
// component allowed to create state, and runs two ways:
//
// - PID 1 of the installer image, which scripts/install-system.sh boots with
//   the machine's disk as `vda` and a system image as `vdb`. It puts the
//   btrfs volume on the disk when there is none, lays it out, writes the
//   image's system as `system/<version>`, a read-only snapshot, and records
//   that system as current in `boot/`, last, so an interrupted run leaves a
//   machine that refuses to boot rather than one that boots into something
//   half-written. A disk that already holds the volume keeps its data: an
//   install onto it is an update. The version is the one word after `--` on
//   the kernel command line, `tessera.version=<version>`, which the build
//   computes from the image.
// - /bin/installer --serve on the recovery media, the Install service
//   Recovery asks to partition, erase and install (`Service.kira`).

import Foundation
import LibTessera

/// The command-line flags the installer takes.
namespace InstallerFlag {
    let version: String = "tessera.version="
    let serve: String = "--serve"
    // Install the system as an update to try before it is trusted.
    let update: String = "tessera.update"
    // Physical install targets can be named by GPT partition label. The
    // QEMU installer keeps its vda/vdb defaults when these are absent.
    let target: String = "tessera.target="
    let image: String = "tessera.image="
}

/// Runs the installer: serves requests when init starts it with `--serve`, else installs the version asked for.
@Main
function main() -> UN8 {
    if served() { return serve() }
    match machinePrepare() {
        Ok -> {}
        Error(failed) -> log info("the machine is partly prepared", error: errorName(failed))
    }
    let version = try requestedVersion() otherwise return stop(
        "no tessera.version= on the kernel command line"
    )
    let target = try requestedDevice(InstallerFlag.target, "vda") otherwise return stop(
        "the requested install target could not be resolved"
    )
    let image = try requestedDevice(InstallerFlag.image, "vdb") otherwise return stop(
        "the requested system image could not be resolved"
    )
    // Replacing Android's ext4 userdata requires a separate and explicit
    // kernel argument, not merely pointing the installer at that partition.
    let reformat = requestedReformatUserdata()
    if reformat {
        // requestedDevice resolves PARTLABEL:userdata to a Linux block-device
        // name (e.g. sda53). Never compare the resulting name to the literal
        // GPT label: that would silently reject every real phone install.
        let userdata = try partitionDevice("userdata") otherwise return stop(
            "the userdata GPT partition could not be verified"
        )
        if target != userdata {
            return stop("tessera.reformat-userdata does not target the userdata GPT partition")
        }
    }
    // The machine's install target, with the volume's top mounted at
    // /volume, and the system image at /image.
    let installation = Installation {
        disk: target,
        volume: "/volume",
        image: .Disk(image),
        imageAt: "/image"
    }
    var progress = CopyProgress { channel: .None, done: 0, total: 0 }
    match install(installation, version, progress, requestedUpdate(), reformat) {
        Ok -> {}
        Error(problem) -> return stop(problem)
    }
    // The line scripts/install-system.sh waits for.
    print("tessera: installed system \(version)")
    match machineStop(.PowerOff) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
    return 0
}

/// Says why the install stopped, and stops the machine.
function stop(problem: borrow String) -> UN8 {
    log fault("the install stopped", problem)
    print("tessera: the install failed: \(problem)")
    match machineStop(.PowerOff) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
    return 1
}

/// Whether this is the Install service, which init starts with `--serve`.
function served() -> Bool {
    match processArguments() {
        Ok(given) -> return given.contains(InstallerFlag.serve)
        Error(failed) -> {
            absorb failed
            return false
        }
    }
}

/// The version the kernel command line names.
function requestedVersion() -> String? {
    let arguments = match processArguments() {
        Ok(given) -> given
        Error(failed) -> {
            log warn("the kernel's arguments could not be read", error: errorName(failed))
            return .None
        }
    }
    for argument in arguments {
        if argument.startsWith(InstallerFlag.version) {
            let version = argument.substring(InstallerFlag.version.count, argument.count)
            if version.count > 0 && !version.contains("/") && version != "dev" {
                return .Some(version)
            }
        }
    }
    return .None
}

/// The destructive format option must name the exact Android userdata
/// partition. In its absence, mkfs.btrfs refuses existing ext4 signatures.
function requestedReformatUserdata() -> Bool {
    match processArguments() {
        Ok(given) -> return given.contains("tessera.reformat-userdata") &&
            given.contains("tessera.target=PARTLABEL:userdata")
        Error(failed) -> {
            absorb failed
            return false
        }
    }
}

/// The requested block device, or the QEMU default. `PARTLABEL:name` resolves
/// a GPT partition through its sysfs uevent instead of assuming a device name.
function requestedDevice(prefix: borrow String, fallback: borrow String) -> Result<String, String> {
    let arguments = match processArguments() {
        Ok(given) -> given
        Error(failed) -> return .Error(
            "the kernel's arguments could not be read: \(errorName(failed))"
        )
    }
    for argument in arguments {
        if !argument.startsWith(prefix) { continue }
        let value = argument.substring(prefix.count, argument.count)
        if value.count == 0 || value.contains("/") {
            return .Error("\(prefix) must name a block device or PARTLABEL")
        }
        if value.startsWith("PARTLABEL:") {
            let label = value.substring("PARTLABEL:".count, value.count)
            if label.count == 0 { return .Error("the partition label is empty") }
            match partitionDevice(label) {
                Some(device) -> return .Ok(device)
                None -> return .Error("no partition has GPT label \(label)")
            }
        }
        return .Ok(copy value)
    }
    return .Ok(copy fallback)
}

/// Finds the Linux block-device name for a GPT partition label, allowing the
/// controller time to discover its disks after PID 1 starts.
function partitionDevice(label: borrow String) -> String? {
    for _ in 0..60 {
        match volumePartitionLabelled(label) {
            Ok(found) -> if found.isSome() { return found }
            Error(failed) -> {
                log warn(
                    "the machine's partitions could not be searched",
                    label,
                    error: errorName(failed)
                )
            }
        }
        match timeRead(.Monotonic) {
            Ok(now) -> match threadSleep(now + 500000000) {
                Ok -> {}
                Error(failed) -> {
                    log warn("could not wait for storage", error: errorName(failed))
                    return .None
                }
            }
            Error(failed) -> {
                log warn("could not read the storage wait clock", error: errorName(failed))
                return .None
            }
        }
    }
    return .None
}

/// Installs the version asked for onto the volume, reporting its progress, and returns the exit status.
function install(
    installation: borrow Installation,
    version: borrow String,
    progress: borrow mut CopyProgress,
    update: Bool,
    reformat: Bool
) -> Result<Void, String> {
    // On physical installations the SquashFS source may be a separately
    // staged partition. It MUST be readable before even considering a format
    // of the target volume: otherwise a missing source could erase data and
    // then fail to install anything. This is also safe for the QEMU installer.
    match verifyInstallationSource(installation) {
        Ok -> {}
        Error(problem) -> return .Error(problem)
    }
    match mountVolume(installation, update, reformat) {
        Ok -> {}
        Error(problem) -> return .Error(problem)
    }
    match layOut(installation) {
        Ok -> {}
        Error(problem) -> return .Error(problem)
    }
    match writeSystem(installation, version, progress) {
        Ok -> {}
        Error(problem) -> return .Error(problem)
    }
    match recordInstalled(installation, version, update) {
        Ok -> {}
        Error(problem) -> return .Error(problem)
    }
    match machineFlush() {
        Ok -> return .Ok
        Error(failed) -> return .Error("the volume could not be flushed: \(errorName(failed))")
    }
}
