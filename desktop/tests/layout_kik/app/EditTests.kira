import Foundation
import HomeLayout

@Test
function movingOntoAFullPagePassesItsLastItemOn() {
    var home = arranged(["A", "B", "C", "D", "E"])
    home.moveItem(HomeSlot { page: 1, index: 0 }, HomeSlot { page: 0, index: 0 }, smallSpace)
    let first = namesOn(home, 0) == ["E", "A", "B", "C"]
    expect!(first)
    let second = namesOn(home, 1) == ["D"]
    expect!(second)
}

@Test
function droppingAnAppOnAnotherMakesAFolder() {
    var home = arranged(["A", "B", "C"])
    home.dropItem(HomeSlot { page: 0, index: 0 }, HomeSlot { page: 0, index: 1 }, smallSpace)
    let page = namesOn(home, 0) == [HomeFolderName.made, "C"]
    expect!(page)
    let made = folderAt(home, 0, 0) == ["B", "A"]
    expect!(made)
    home.dropItem(HomeSlot { page: 0, index: 1 }, HomeSlot { page: 0, index: 0 }, smallSpace)
    let grown = folderAt(home, 0, 0) == ["B", "A", "C"]
    expect!(grown)
}

@Test
function aFolderIsRenamedReorderedAndEmptied() {
    var home = arranged(["A", "B"])
    home.dropItem(HomeSlot { page: 0, index: 0 }, HomeSlot { page: 0, index: 1 }, smallSpace)
    let slot = HomeSlot { page: 0, index: 0 }
    home.renameFolder(slot, "Work")
    expect!(namesOn(home, 0)[0] == "Work")
    home.renameFolder(slot, "")
    expect!(namesOn(home, 0)[0] == HomeFolderName.made)
    home.reorderFolder(slot, "A", 0)
    let order = folderAt(home, 0, 0) == ["A", "B"]
    expect!(order)
    home.moveOut("A", 0, smallSpace)
    let out = namesOn(home, 0) == [HomeFolderName.made, "A"]
    expect!(out)
    home.leave("B")
    let gone = namesOn(home, 0) == ["A"]
    expect!(gone)
}

@Test
function takingOffHomeAndBackMakesNoDuplicate() {
    var home = arranged(["A", "B"])
    home.removeFromHome("A")
    expect!(home.slotOf("A").isNone())
    expect!(home.removed.contains("A"))
    home.addToHome("A", 0, smallSpace)
    home.addToHome("A", 0, smallSpace)
    let page = namesOn(home, 0) == ["B", "A"]
    expect!(page)
    expect!(!home.removed.contains("A"))
}

@Test
function pagesMoveAndHideButOneStaysShown() {
    var home = arranged(["A", "B", "C", "D", "E"])
    home.movePage(1, 0)
    let first = namesOn(home, 0) == ["E"]
    expect!(first)
    home.toggleHidden(0)
    let shown = home.shownPages() == [1]
    expect!(shown)
    home.toggleHidden(1)
    expect!(home.shownPages().count == 1)
}

@Test
function anEditSettlesWithoutEmptyPagesAndKeepsItsReset() {
    var home = arranged(["A"])
    home.reset = "42"
    home.pages.append(HomePage {})
    let settled = home.settled()
    expect!(settled.pages.count == 1)
    expect!(settled.reset == "42")
}

@Test
function widgetsTakeRowsAndFit() {
    var home = arranged(["A", "B", "C", "D"])
    home.addWidget(0, HomeWidget { kind: "Clock" }, smallSpace)
    expect!(home.pages[0].widgets.count == 1)
    // Two rows of two go to the band, so every icon moves on.
    expect!(home.room(0, smallSpace) == 0)
    expect!(namesOn(home, 0).count == 0)
    expect!(namesOn(home, 1).count == 4)
    home.addWidget(0, HomeWidget { kind: "Battery" }, smallSpace)
    expect!(home.pages[0].widgets.count == 1)
    home.resizeWidget(0, 0, smallSpace)
    let small = match home.pages[0].widgets[0].size {
        Small -> true
        Medium -> false
    }
    expect!(small)
}

@Test
function dropOnSelfKeepsTheAppWithoutMakingAFolder() {
    var home = arranged(["A", "B", "C"])
    let slot = HomeSlot { page: 0, index: 1 }
    home.dropItem(slot, slot, smallSpace)
    expect!(namesOn(home, 0) == ["A", "B", "C"])
    expect!(home.slotOf("B").isSome())
}

@Test
function moveOutOnlyTakesAnExistingFolderMember() {
    var home = arranged(["A", "B", "C"])
    home.moveOut("A", 0, smallSpace)
    home.moveOut("Missing", 0, smallSpace)
    expect!(namesOn(home, 0) == ["A", "B", "C"])
    home.dropItem(HomeSlot { page: 0, index: 0 }, HomeSlot { page: 0, index: 1 }, smallSpace)
    home.moveOut("A", 0, smallSpace)
    expect!(namesOn(home, 0) == [HomeFolderName.made, "C", "A"])
    expect!(folderAt(home, 0, 0) == ["B"])
}

@Test
function reorderingUnknownMemberDoesNotInsertGhostApp() {
    var home = arranged(["A", "B", "C"])
    home.dropItem(HomeSlot { page: 0, index: 0 }, HomeSlot { page: 0, index: 1 }, smallSpace)
    let slot = HomeSlot { page: 0, index: 0 }
    home.reorderFolder(slot, "Missing", 0)
    expect!(folderAt(home, 0, 0) == ["B", "A"])
    expect!(home.slotOf("Missing").isNone())
}

@Test
function invalidWidgetIndicesCannotChangeTheArrangement() {
    var home = arranged(["A", "B"])
    home.addWidget(0, HomeWidget { kind: "Clock" }, smallSpace)
    home.resizeWidget(0, -1, smallSpace)
    home.shiftWidget(0, -1, 1, smallSpace)
    expect!(home.pages[0].widgets.count == 1)
    let kind = home.pages[0].widgets[0].kind
    expect!(kind == "Clock")
}

@Test
function anExplicitEmptyPageSurvivesSettlingAndHiding() {
    var home = arranged(["A"])
    home.addPage()
    expect!(home.pages.count == 2)
    expect!(home.pages[1].items.count == 0)
    home.toggleHidden(1)
    let settled = home.settled()
    expect!(settled.pages.count == 2)
    expect!(settled.pages[1].hidden)
    expect!(settled.pages[1].retained)
    home.toggleHidden(1)
    home.movePage(1, 0)
    expect!(home.pages[0].retained)
}

@Test
function removingEmptyPagesNeverHidesEveryScreen() {
    var home = arranged(["A"])
    home.addPage()
    home.addPage()
    home.toggleHidden(0)
    home.removeEmptyPage(1)
    expect!(home.pages.count == 2)
    expect!(home.shownPages() == [1])
    home.removeEmptyPage(1)
    expect!(home.pages.count == 1)
    expect!(home.shownPages() == [0])
    home.removeEmptyPage(0)
    expect!(home.pages.count == 1)
    expect!(namesOn(home, 0) == ["A"])
}

@Test
function removingNonEmptyPagesNeverDiscardsAppsOrWidgets() {
    var home = arranged(["A", "B", "C", "D", "E"])
    home.removeEmptyPage(0)
    expect!(home.pages.count == 2)
    expect!(namesOn(home, 0) == ["A", "B", "C", "D"])
    home.addPage()
    home.addWidget(2, HomeWidget { kind: "Clock" }, smallSpace)
    home.removeEmptyPage(2)
    expect!(home.pages.count == 3)
    expect!(home.pages[2].widgets.count == 1)
}

@Test
function settlingPreservesHiddenPagesAndAddsAVisibleOne() {
    var home = HomeArrangement {
        pages: [HomePage { items: [.App("A")], hidden: true }, HomePage {}]
    }
    let settled = home.settled()
    expect!(settled.pages.count == 2)
    expect!(settled.pages[0].hidden)
    expect!(settled.shownPages() == [1])
}

@Test
function negativeTargetPageDoesNotDeleteAnAppOrCreateAnInvalidPage() {
    var home = arranged(["A", "B", "C"])
    home.moveItem(HomeSlot { page: 0, index: 1 }, HomeSlot { page: -1, index: 0 }, smallSpace)
    expect!(namesOn(home, 0) == ["A", "B", "C"])
    expect!(home.pages.count == 1)
    home.insert(.App("Z"), HomeSlot { page: -1, index: 0 }, smallSpace)
    expect!(namesOn(home, 0) == ["A", "B", "C"])
    expect!(home.slotOf("Z").isNone())
}

@Test
function overflowingVisiblePageDoesNotPutIconsOnHiddenPage() {
    var home = HomeArrangement {
        pages: [
            HomePage { items: [.App("A"), .App("B"), .App("C"), .App("D")] },
            HomePage { items: [.App("Private")], hidden: true, retained: true },
            HomePage { items: [.App("E")] }
        ]
    }
    home.addToHome("Z", 0, smallSpace)
    expect!(home.pages.count == 4)
    expect!(namesOn(home, 0) == ["A", "B", "C", "Z"])
    expect!(namesOn(home, 1) == ["D"])
    expect!(home.pages[2].hidden)
    expect!(namesOn(home, 2) == ["Private"])
    expect!(home.pages[2].retained)
    expect!(namesOn(home, 3) == ["E"])
    expect!(home.shownPages() == [0, 1, 3])
}
