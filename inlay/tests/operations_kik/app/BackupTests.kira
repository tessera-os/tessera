}

@Test
function interruptedBackupCleanupDoesNotTrustLinkedMarkers() {
    let folder = freshFolder("pending-link-cleanup")
    let root = childPath(folder, "Backups")
    let source = childPath(folder, "Documents")
    expect!(made(makeDirectory(root)))
    expect!(made(makeDirectory(source)))
    let name = "20261031-225959"
    let personal = childPath(root, name)
    expect!(made(makeDirectory(personal)))
    writeText(childPath(personal, "my-file"), "keep")
    let markerTarget = childPath(folder, "marker-value")
    writeText(markerTarget, name)
    expect!(
        made(makeSymbolicLink("../marker-value", childPath(root, ".tessera-incomplete-" + name)))
    )
    writeText(childPath(source, "note"), "saved")
    let saved = try backUp(source, root, 1000) otherwise return
    expect!(pathExists(personal))
    expect!(textAt(childPath(personal, "my-file")) == "keep")
    expect!(snapshotsIn(root).count == 1)
    expect!(!verificationFailed(verifySnapshot(saved.snapshot)))
    expect!(removed(removeTree(folder)))
}

@Test
function snapshotVerifierRefusesLinkedRootsAndLinkedManifest() {
    let folder = freshFolder("linked-verification")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note"), "saved")
    let saved = try backUp(source, root, 1000) otherwise return
    let alias = childPath(folder, "linked-root")
    expect!(made(makeSymbolicLink("Backups", alias)))
    let snapshotAlias = Snapshot {
        name: copy saved.snapshot.name,
        path: childPath(alias, saved.snapshot.name)
    }
    expect!(verificationFailed(verifySnapshot(snapshotAlias)))
    let manifest = childPath(root, ".tessera-manifest-" + saved.snapshot.name)
    let content = textAt(manifest)
    let alternate = childPath(folder, "outside-manifest")
    writeText(alternate, content)
    expect!(made(removePath(manifest)))
    expect!(made(makeSymbolicLink("../outside-manifest", manifest)))
    expect!(verificationFailed(verifySnapshot(saved.snapshot)))
    expect!(removed(removeTree(folder)))
}

@Test
function restoreSkipsDanglingSymlinkInsteadOfOverwritingIt() {
    let folder = freshFolder("restore-symlink-collision")
    let source = childPath(folder, "Documents")
    let backups = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note.txt"), "saved")
    let snapshot = try backUp(source, backups, 1000) otherwise return
    writeText(childPath(source, "note.txt"), "current")
    let dangling = childPath(source, "note 2.txt")
    expect!(made(makeSymbolicLink("missing.txt", dangling)))
    let restored = try restoreItem(
        snapshot.snapshot,
        childPath(snapshot.snapshot.path, "note.txt"),
        source
    )
    otherwise return
    expect!(lastPathPart(restored) == "note 3.txt")
    expect!(textAt(restored) == "saved")
    expect!(textAt(childPath(source, "note.txt")) == "current")
    let linkStatusNow = try linkStatus(dangling) otherwise return
    let isLink = linkStatusNow.kind == .Link
    expect!(isLink)
    expect!(!pathExists(childPath(source, "missing.txt")))
    expect!(removed(removeTree(folder)))
}

@Test
function corruptedNewestGenerationNeverAuthorizesDeletionOfOlderBackup() {
    let folder = freshFolder("retention-needs-verified-newest")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note.txt"), "original")
    let older = try backUp(source, root, 1000) otherwise return
    writeText(childPath(source, "note.txt"), "new version")
    let newest = try backUp(source, root, 2000) otherwise return
    writeText(childPath(newest.snapshot.path, "note.txt"), "corrupted")
    let blocked = match pruneSnapshots(root, 1) {
        Ok -> false
        Error(failure) -> {
            absorb failure
            true
        }
    }
    expect!(blocked)
    expect!(snapshotsIn(root).count == 2)
    expect!(textAt(childPath(older.snapshot.path, "note.txt")) == "original")
    expect!(!verificationFailed(verifySnapshot(older.snapshot)))
    expect!(removed(removeTree(folder)))
}

@Test
function unverifiedLegacyGenerationCannotDiscardAnotherRetainedBackup() {
    let folder = freshFolder("retention-legacy-guard")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note"), "original")
    let earlier = try backUp(source, root, 1000) otherwise return
    let legacy = childPath(root, "20261031-225000")
    expect!(made(makeDirectory(legacy)))
    writeText(childPath(legacy, ".complete"), "20261031-225000")
    writeText(childPath(legacy, "document.txt"), "legacy")
    expect!(snapshotsIn(root).count == 2)
    let refused = match pruneSnapshots(root, 1) {
        Ok -> false
        Error(failure) -> {
            absorb failure
            true
        }
    }
    expect!(refused)
    expect!(pathExists(earlier.snapshot.path))
    expect!(pathExists(legacy))
    expect!(removed(removeTree(folder)))
}

@Test
function backupRejectsCaseOnlyAliasInsideItsSourceBeforeCreatingAnything() {
    let folder = freshFolder("casefold-backup-source")
    let source = childPath(folder, "Documents")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note"), "safe")
    let disguised = childPath(folder, "documents/Backups")
    let refused = match backUp(source, disguised, 1000) {
        Ok -> false
        Error(failure) -> match failure {
            Refused -> true
            InvalidName, AlreadyExists, Missing, IntoItself -> false
        }
    }
    expect!(refused)
    expect!(!pathExists(childPath(source, "Backups")))
    expect!(textAt(childPath(source, "note")) == "safe")
    expect!(removed(removeTree(folder)))
}

@Test
function backupRefusesFractionalNegativeAndUnrepresentableTimestamps() {
    let folder = freshFolder("backup-invalid-time")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note"), "safe")
    for at in [-1000, 1.5, 253402300800000] {
        let refused = match backUp(source, root, at) {
            Ok -> false
            Error(failure) -> {
                absorb failure
                true
            }
        }
        expect!(refused)
    }
    expect!(!pathExists(root))
    expect!(removed(removeTree(folder)))
}

@Test
function fractionalRetentionCannotRemoveAnyGeneration() {
    let folder = freshFolder("fractional-retention")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    writeText(childPath(source, "note"), "original")
    let first = try backUp(source, root, 1000) otherwise return
    writeText(childPath(source, "note"), "changed")
    let latest = try backUp(source, root, 2000) otherwise return
    let refused = match pruneSnapshots(root, 1.5) {
        Ok -> false
        Error(failure) -> {
            absorb failure
            true
        }
    }
    expect!(refused)
    expect!(pathExists(first.snapshot.path))
    expect!(pathExists(latest.snapshot.path))
    expect!(removed(removeTree(folder)))
}

@Test
function verificationIdentifiesTheMissingOrChangedStoredFilename() {
    let folder = freshFolder("verify-filename")
    let source = childPath(folder, "Documents")
    let root = childPath(folder, "Backups")
    expect!(made(makeDirectory(source)))
    let name = "Résumé\nnotes.txt"
    writeText(childPath(source, name), "original")
    let saved = try backUp(source, root, 1000) otherwise return
    let file = childPath(saved.snapshot.path, name)
    writeText(file, "tampered")
    let changed = match verifySnapshot(saved.snapshot) {
        Ok -> false
        Error(failure) -> match failure {
            Refused(path) -> path == file
            Missing, InvalidName, AlreadyExists, IntoItself -> false
        }
    }
    expect!(changed)
    writeText(file, "original")
    expect!(made(removePath(file)))
    let missing = match verifySnapshot(saved.snapshot) {
        Ok -> false
        Error(failure) -> match failure {
            Missing(path) -> path == file
            Refused, InvalidName, AlreadyExists, IntoItself -> false
        }
    }
    expect!(missing)
    expect!(removed(removeTree(folder)))
}

@Test
function verificationIdentifiesAnUnexpectedSavedItemAndRemovedFolder() {
    let folder = freshFolder("verify-extra")
    let source = childPath(folder, "Documents")
    let backups = childPath(folder, "Backups")
    let nested = childPath(source, "Nested")
    expect!(made(makeDirectory(source)))
    expect!(made(makeDirectory(nested)))
    writeText(childPath(nested, "original.txt"), "original")
    let saved = try backUp(source, backups, 1000) otherwise return
    let extra = childPath(saved.snapshot.path, "bonus.txt")
    writeText(extra, "unexpected")
    let unexpected = match verifySnapshot(saved.snapshot) {
        Ok -> false
        Error(failure) -> match failure {
            Refused(path) -> path == extra
            Missing, InvalidName, AlreadyExists, IntoItself -> false
        }
    }
    expect!(unexpected)
    expect!(made(removePath(extra)))
    let missingFolder = childPath(saved.snapshot.path, "Nested")
    expect!(removed(removeTree(missingFolder)))
    let gone = match verifySnapshot(saved.snapshot) {
        Ok -> false
        Error(failure) -> match failure {
            Missing(path) -> path == missingFolder
            Refused, InvalidName, AlreadyExists, IntoItself -> false
        }
    }
    expect!(gone)
    expect!(removed(removeTree(folder)))
}
