import Foundation
import KiraUI
import FileOperations

// A bounded, non-executing preview of the chosen regular document. Names and
// extensions are not trusted as proof of image content or UTF-8. The view
// never calls readFile on the complete document.

namespace PreviewLimit {
    let bytes: Number = 4096
    let imageBytes: Number = 8388608
    let pictureHeight: Number = 240
}

// The preview of the file at `path`, nothing when no file is chosen.
function previewSection(path: borrow String) -> Any Widget {
    if path.count == 0 || isDirectory(path) || !fileExists(path) { return EmptyView() }
    let name = lastPathPart(path)
    let shown = boundedDocumentPreview(path)
    return Section(children: [shown], header: Text("Preview of \(name)"))
}

function boundedDocumentPreview(path: borrow String) -> Any Widget {
    let preview = match previewDocument(path, PreviewLimit.bytes) {
        Ok(value) -> value
        Error(failure) -> {
            absorb failure
            return Text("Preview unavailable. The file may have moved or changed.")
                .foregroundColor(.Secondary)
        }
    }
    return match preview.content {
        Text(content) -> textPreviewContent(content, preview.truncated)
        ImageFormat(format) -> imagePreviewContent(path, format, preview.totalBytes)
        Unsupported -> Text("This document cannot be safely previewed.")
            .foregroundColor(.Secondary)
    }
}

function textPreviewContent(content: borrow String, truncated: Bool) -> Any Widget {
    let text = truncated ? content + "…" : copy content
    return Text(text)
}

// Only files with a recognized image signature are offered to ImageFile, and
// only at a bounded size. A signature is a hint, not image validation; the
// image decoder is still responsible for rejecting malformed input.
function imagePreviewContent(path: borrow String, format: borrow String, size: Number) -> Any Widget {
    if size > PreviewLimit.imageBytes {
        return Text("\(format) image (\(size) bytes). Too large for a preview.")
            .foregroundColor(.Secondary)
    }
    return ImageFile(path = copy path, aspectFill = false)
        .height(resolvedLength(PreviewLimit.pictureHeight))
}
